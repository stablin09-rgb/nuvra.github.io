+  /**
+   * Mock app generation: uses the AppPlanner to build a realistic result
+   * without any API call.
+   */
+  async _generateApp(prompt, options = {}) {
+    const { analyseAppPrompt: analyse, planApp: plan, getAppBlueprint } =
+      await import('./appPlanner.js');
+    const intent    = analyse(prompt);
+    const appPlan   = plan(intent);
+    const blueprint = getAppBlueprint(intent.appType);
+
+    // Build the AppGenerationResult from the blueprint
+    const appName = intent.appName;
+    const accent  = options.accentColor || intent.accentColor || '#7c6af7';
+
+    // Deep-clone collections from blueprint and personalise
+    const collections = blueprint.collections.map((col) => ({
+      ...col,
+      id:   col.id,
+      name: col.name,
+    }));
+
+    // Build pages from the plan
+    const pages = appPlan.pages.map((pagePlan) => {
+      const components = pagePlan.components.map((compType, idx) => {
+        const primaryCol = collections[0]?.id || 'items';
+        const configs = {
+          'app-header':  { title: appName, subtitle: `Manage your ${appName.toLowerCase()} data` },
+          'stat-row':    { stats: [
+            { label: 'Total',    value: '—', trend: '',   direction: 'up' },
+            { label: 'Active',   value: '—', trend: '+5', direction: 'up' },
+            { label: 'Pending',  value: '—', trend: '',   direction: 'down' },
+            { label: 'Done',     value: '—', trend: '+2', direction: 'up' },
+          ]},
+          'data-table':  { collectionId: primaryCol, heading: collections[0]?.name || 'Records', showSearch: true, showAdd: true },
+          'data-form':   { collectionId: primaryCol, mode: 'create', title: `Add ${collections[0]?.name?.replace(/s$/, '') || 'Record'}`, submitLabel: 'Save' },
+          'data-list':   { collectionId: primaryCol, heading: collections[0]?.name || 'Records', displayField: 'title' },
+        };
+        return {
+          id:     `${compType}-${idx}`,
+          type:   compType,
+          config: configs[compType] || {},
+          actions: compType === 'data-table' ? [{ id: 'fetch', config: { collection: primaryCol } }]
+                 : compType === 'data-form'  ? [{ id: 'submit', config: { collection: primaryCol, mode: 'create' } }]
+                 : [],
+        };
+      });
+
+      return {
+        pageId:     pagePlan.pageId,
+        pageName:   pagePlan.pageName,
+        intent:     'app',
+        appType:    pagePlan.appType,
+        title:      pagePlan.pageName,
+        layout:     pagePlan.layout || 'full-width',
+        components,
+        settings:   { accentColor: accent, primaryCollection: collections[0]?.id },
+      };
+    });
+
+    return {
+      appName,
+      description: `A ${blueprint.label} built with Nuvra.`,
+      collections,
+      pages,
+      settings: { accentColor: accent, theme: 'light' },
+      _meta: { provider: 'mock', model: 'mock-v2', tokens: 0 },
+    };
+  }
+
