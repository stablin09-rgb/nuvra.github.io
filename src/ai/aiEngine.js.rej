+/**
+ * Generate a full data-driven application from a natural-language prompt.
+ *
+ * Pipeline:
+ *   prompt → analyseAppPrompt → planApp → provider._generateApp → registerAiCollections → renderAppPageSchema
+ *
+ * @typedef {object} AppPageGenerationResult
+ * @property {string} pageId    - URL slug for the page
+ * @property {string} pageName  - Display name
+ * @property {string} html      - Rendered HTML for GrapesJS
+ * @property {string} css       - Rendered CSS for GrapesJS
+ * @property {object} appSchema - The raw AppPageSchema
+ * @property {'app'}  intent    - Always 'app'
+ * @property {object} meta      - { provider, model, tokens }
+ *
+ * @typedef {object} AppGenerationOutput
+ * @property {string}                   appName
+ * @property {string[]}                 collectionIds  - IDs of registered collections
+ * @property {AppPageGenerationResult[]} pages
+ * @property {object}                   meta
+ *
+ * @param {string} prompt
+ * @param {object} [options]
+ * @param {string} [options.accentColor]
+ * @returns {Promise<AppGenerationOutput>}
+ */
+export async function generateApp(prompt, options = {}) {
+  if (!_activeProvider) {
+    console.warn('[Nuvra AI] No provider configured — defaulting to mock.');
+    _activeProvider = new MockProvider({});
+  }
+
+  // ── Step 1: Analyse prompt and build a plan ──────────────────────────────
+  const intent  = analyseAppPrompt(prompt);
+  const appPlan = planApp(intent);
+
+  const accentColor = options.accentColor || intent.accentColor || '#7c6af7';
+
+  // ── Step 2: Call provider to get AppGenerationResult ────────────────────
+  let appResult;
+
+  if (_activeProvider.id === 'mock') {
+    // Mock provider has a dedicated _generateApp method
+    appResult = await _activeProvider._generateApp(prompt, { ...options, accentColor });
+  } else {
+    // Real providers: use the app system prompt and parse the response
+    const systemPrompt = buildAppSystemPrompt({
+      appContext:   appPlan.systemPromptContext,
+      accentColor,
+    });
+    const userMessage  = buildAppUserMessage(prompt, appPlan.systemPromptContext);
+
+    // Use the provider's raw _callAPI to get the structured response
+    const raw = await _activeProvider._callAPI(systemPrompt, userMessage, {
+      maxOutputTokens: 4096,
+    });
+
+    try {
+      appResult = JSON.parse(raw.content);
+    } catch (e) {
+      console.error('[Nuvra AI] App generation: JSON parse failed. Falling back to mock.', e);
+      appResult = createDefaultAppResult(intent.appName);
+    }
+
+    // Validate and repair if needed
+    const validation = validateAppGenerationResult(appResult);
+    if (!validation.valid) {
+      console.warn('[Nuvra AI] App result validation errors:', validation.errors);
+      if (!appResult.collections || !appResult.pages) {
+        appResult = createDefaultAppResult(intent.appName);
+      }
+    }
+  }
+
+  // ── Step 3: Register collections into the DataStore ─────────────────────
+  const collectionIds = registerAiCollections(appResult.collections || []);
+
+  // ── Step 4: Render each app page to HTML/CSS ─────────────────────────────
+  const meta = appResult._meta || { provider: _activeProvider.id, model: _activeProvider.model || 'unknown', tokens: 0 };
+
+  const pages = (appResult.pages || []).map((pageSchema) => {
+    const { html, css } = renderAppPageSchema(pageSchema);
+    return {
+      pageId:    pageSchema.pageId,
+      pageName:  pageSchema.pageName,
+      html,
+      css,
+      appSchema: pageSchema,
+      intent:    'app',
+      meta,
+    };
+  });
+
+  console.info(
+    `[Nuvra AI] App generated: "${appResult.appName}" — ` +
+    `${collectionIds.length} collection(s), ${pages.length} page(s) via ${meta.provider}/${meta.model}`
+  );
+
+  return {
+    appName:       appResult.appName,
+    collectionIds,
+    pages,
+    meta,
+  };
+}
