+      stateScope:  { type: 'string',  default: 'page',      options: ['app', 'page', 'component'], description: 'State scope' },
+      spinnerText: { type: 'string',  default: 'Loading…',  description: 'Text shown while loading' },
+    },
+    stateReads:  ['isLoading'],
+    stateWrites: [],
+    actions:     [],
+    render(config) {
+      const stateKey   = config.stateKey   || 'isLoading';
+      const stateScope = config.stateScope || 'page';
+      const spinnerText = config.spinnerText || 'Loading…';
+
+      const html = `
+<div class="nv-loading-gate" data-nv-component="loading-gate" data-nv-state-key="${stateKey}" data-nv-scope="${stateScope}">
+  <div class="nv-loading-spinner" data-nv-show-when="true">
+    <div class="nv-spinner"></div>
+    <span>${spinnerText}</span>
+  </div>
+  <div class="nv-loading-content" data-nv-show-when="false">
+    <!-- Content shown when not loading -->
+    <div class="nv-logic-placeholder"><small>Drop content here — shown when not loading.</small></div>
+  </div>
+</div>`;
+
+      return { html, css: _LOGIC_CSS + _SPINNER_CSS };
+    },
+  },
+
+  // ── APP LAYOUT ─────────────────────────────────────────────────────────────
+
+  {
+    id:          'app-layout',
+    name:        'App Layout',
+    category:    'Layout',
