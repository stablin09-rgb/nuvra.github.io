+    this._schemas[schema.id] = {
+      ...schema,
+      meta: {
+        createdAt: new Date().toISOString(),
+        updatedAt: new Date().toISOString(),
+      },
+    };
+    this._records[schema.id] = [];
+    this._persist();
+
+    console.info(`[DataStore] Collection "${schema.id}" created.`);
+    return this._schemas[schema.id];
+  }
+
+  /**
+   * Update an existing collection's schema.
+   * Existing records are preserved; new fields get their default values.
+   *
+   * @param {string} collectionId
+   * @param {Partial<CollectionSchema>} updates
+   * @returns {CollectionSchema}
+   */
+  updateCollection(collectionId, updates) {
+    const schema = this._getSchema(collectionId);
+
+    const merged = { ...schema, ...updates, id: collectionId };
+    const { valid, errors } = validateCollectionSchema(merged);
+    if (!valid) {
+      throw new Error(`[DataStore] Invalid schema update: ${errors.join('; ')}`);
+    }
