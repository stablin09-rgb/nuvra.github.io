+    suggestedComponents: ['data-form', 'show-if', 'loading-gate'],
+    aiHint: 'Generate a form page with a data-form component. Use loading-gate to show a spinner during submission and show-if to show a success message.',
+  },
+
+  settings: {
+    id:          'settings',
+    name:        'Settings Page',
+    kind:        'app',
+    description: 'An app settings page with grouped form sections.',
+    icon:        '⚙️',
+    defaultState: {
+      activeSection: { default: 'general', type: 'string', description: 'Active settings section' },
+    },
+    layoutHints: {
