+    suggestedComponents: ['stat-display', 'data-table', 'app-header', 'app-layout'],
+    aiHint: 'Generate a dashboard with KPI stat cards at the top, a data table below, and an app header. Use the app-layout component for the shell.',
+  },
+
+  'crud-list': {
+    id:          'crud-list',
