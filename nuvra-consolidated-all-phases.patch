+
+/**
+ * Register all blocks with the GrapesJS BlockManager.
+ *
+ * @param {object} editor - GrapesJS editor instance
+ */
+export function registerBlocks(editor) {
+  BLOCKS.forEach(({ id, label, category, media, content }) => {
