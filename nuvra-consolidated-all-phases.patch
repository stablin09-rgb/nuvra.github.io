index 0000000..bbea180
--- /dev/null
+++ b/src/ai/promptBuilder.js
@@ -0,0 +1,161 @@
+/**
+ * Nuvra Builder — Prompt Builder  (Phase 5A)
+ *
+ * Centralises all system prompt construction for real LLM providers.
+ * Extracted from aiEngine.js to keep it testable and maintainable.
+ *
+ * The system prompt is the most critical part of the AI integration:
+ *  - It defines the exact JSON schema the LLM must return.
+ *  - It lists every available section type (from the SchemaRenderer registry).
+ *  - It provides detailed props references for each section type.
+ *  - It enforces strict rules: JSON only, no markdown, no explanation.
+ *
+ * Design decisions:
+ *  - The prompt is built dynamically so it always reflects the current
+ *    set of registered section types. Adding a new section type to the
+ *    SchemaRenderer automatically makes it available to the AI.
+ *  - The prompt is kept as concise as possible to minimise input tokens.
+ *    Verbose explanations are replaced with compact TypeScript-style type hints.
+ */
+
+'use strict';
+
+import { getRegisteredSectionTypes } from './schemaRenderer.js';
+
+// ─── System Prompt Builder ────────────────────────────────────────────────────
+
+/**
+ * Build the system prompt for a single-page generation request.
+ *
+ * @param {object} options
+ * @param {string} [options.accentColor] - Suggest a specific accent color
+ * @param {string} [options.theme]       - 'light' or 'dark'
+ * @param {string} [options.pageType]    - Hint for the page type
+ * @returns {string}
+ */
+export function buildSystemPrompt(options = {}) {
+  const sectionTypes = getRegisteredSectionTypes();
+  const sectionList  = sectionTypes.join(', ');
+  const colorHint    = options.accentColor ? `\n- Use "${options.accentColor}" as the accentColor.` : '';
+  const themeHint    = options.theme       ? `\n- Use "${options.theme}" as the theme.` : '';
+
+  return `You are an expert web designer working inside Nuvra, an AI-powered website builder.
+
+Your task is to generate a structured page description as a JSON object.
+
+REQUIRED OUTPUT FORMAT (TypeScript interface):
+interface PageSchema {
+  name: string;                  // Short page name, 3-5 words
+  settings: {
+    theme: "light" | "dark";
+    accentColor: string;         // Hex color, e.g. "#7c6af7"
+    fontFamily: string;          // e.g. "system-ui, sans-serif"
+  };
+  sections: Array<{
+    type: string;                // MUST be one of the registered types listed below
+    props: Record<string, any>;  // Properties specific to the section type
+  }>;
+}
+
+REGISTERED SECTION TYPES (use ONLY these):
+${sectionList}
+
+SECTION PROPS REFERENCE:
+navbar:          { brand: string, links: string[], cta: string }
+hero:            { badge?: string, title: string, subtitle: string, primaryCta: string, secondaryCta?: string, theme?: "dark"|"light" }
+features:        { heading: string, items: [{ icon: string, title: string, body: string }] }
+testimonial:     { quote: string, author: string, role: string }
+cta:             { heading: string, subtext: string, cta: string }
+footer:          { brand: string, links: string[] }
+dashboard-header:{ title: string, subtitle: string, cta: string }
+stat-row:        { stats: [{ label: string, value: string, trend: string, direction: "up"|"down" }] }
+data-table:      { heading: string, columns: string[], rows: string[][] }
+blog-header:     { heading: string, subtext: string }
+blog-grid:       { posts: [{ category: string, title: string, excerpt: string, author: string, date: string }] }
+newsletter:      { heading: string, subtext: string }
+pricing-header:  { heading: string, subtext: string }
+pricing-grid:    { plans: [{ name: string, price: string, period: string, desc: string, featured: boolean, cta: string, features: string[] }] }
+faq:             { heading: string, items: [{ q: string, a: string }] }
+
+STRICT RULES:
+1. Respond ONLY with the JSON object. No markdown, no code fences, no explanation.
+2. Use realistic, contextually appropriate content (never Lorem Ipsum).
+3. Choose an accentColor that fits the brand/product described.
+4. A typical page has 4-7 sections. Always start with navbar and end with footer.
+5. Do NOT invent new section types — use only the registered types listed above.${colorHint}${themeHint}`;
+}
+
+/**
+ * Build the system prompt for multi-page site generation.
+ * Instructs the LLM to return an array of PageSchema objects.
+ *
+ * @param {object} options
+ * @param {string[]} [options.pageNames] - Specific page names to generate
+ * @returns {string}
+ */
+export function buildSiteSystemPrompt(options = {}) {
+  const sectionTypes = getRegisteredSectionTypes();
+  const sectionList  = sectionTypes.join(', ');
+  const pageHint     = options.pageNames?.length
+    ? `\nGenerate exactly these pages: ${options.pageNames.join(', ')}.`
+    : '\nGenerate 3-5 pages appropriate for the described site (e.g., Home, About, Pricing, Contact).';
+
+  return `You are an expert web designer working inside Nuvra, an AI-powered website builder.
+
+Your task is to generate a complete multi-page website as a JSON array.
+
+REQUIRED OUTPUT FORMAT:
+Array of objects, each matching this interface:
+interface SitePageSchema {
+  pageId: string;     // URL slug, e.g. "home", "about", "pricing"
+  pageName: string;   // Display name, e.g. "Home", "About Us", "Pricing"
+  schema: PageSchema; // Full page schema (see below)
+}
+
+interface PageSchema {
+  name: string;
+  settings: { theme: "light"|"dark"; accentColor: string; fontFamily: string; };
+  sections: Array<{ type: string; props: Record<string, any>; }>;
+}
+
+REGISTERED SECTION TYPES (use ONLY these):
+${sectionList}
+
+SECTION PROPS REFERENCE:
+navbar:          { brand: string, links: string[], cta: string }
+hero:            { badge?: string, title: string, subtitle: string, primaryCta: string, secondaryCta?: string }
+features:        { heading: string, items: [{ icon: string, title: string, body: string }] }
+testimonial:     { quote: string, author: string, role: string }
+cta:             { heading: string, subtext: string, cta: string }
+footer:          { brand: string, links: string[] }
+pricing-header:  { heading: string, subtext: string }
+pricing-grid:    { plans: [{ name: string, price: string, period: string, desc: string, featured: boolean, cta: string, features: string[] }] }
+faq:             { heading: string, items: [{ q: string, a: string }] }
+blog-header:     { heading: string, subtext: string }
+blog-grid:       { posts: [{ category: string, title: string, excerpt: string, author: string, date: string }] }
+newsletter:      { heading: string, subtext: string }
+
+STRICT RULES:
+1. Respond ONLY with a JSON array. No markdown, no code fences, no explanation.
+2. Use consistent branding (same brand name, colors, tone) across all pages.
+3. Each page should have 4-7 sections. Always start with navbar and end with footer.
+4. Do NOT invent new section types.${pageHint}`;
+}
+
+/**
+ * Build the user message for a single-page generation request.
+ * @param {string} prompt
+ * @returns {string}
+ */
+export function buildUserMessage(prompt) {
+  return `Generate a complete page for: "${prompt}"`;
+}
+
+/**
+ * Build the user message for a multi-page site generation request.
+ * @param {string} prompt
+ * @returns {string}
+ */
+export function buildSiteUserMessage(prompt) {
+  return `Generate a complete website for: "${prompt}"`;
+}
diff --git a/src/ai/providerBase.js b/src/ai/providerBase.js
new file mode 100644
index 0000000..2671ba1
--- /dev/null
+++ b/src/ai/providerBase.js
@@ -0,0 +1,489 @@
+/**
+ * Nuvra Builder — Provider Base Contract & Prompt Budget System  (Phase 5A)
+ *
+ * This module defines two things:
+ *
+ *  1. `ProviderBase` — The abstract base class that all AI providers must extend.
+ *     It enforces the schema-only output contract, handles retries, and integrates
+ *     with the PromptBudget system.
+ *
+ *  2. `PromptBudget` — A lightweight token estimation and cost guard system.
+ *     It estimates token counts before sending requests, enforces configurable
+ *     limits, and tracks cumulative usage per session.
+ *
+ * ┌─────────────────────────────────────────────────────────────────────────────┐
+ * │  Provider Contract                                                          │
+ * │                                                                             │
+ * │  Every provider MUST:                                                       │
+ * │    1. Extend ProviderBase                                                   │
+ * │    2. Implement `_callAPI(systemPrompt, userMessage, options)` → raw string │
+ * │    3. Return a raw JSON string that can be parsed into a PageSchema         │
+ * │                                                                             │
+ * │  ProviderBase handles:                                                      │
+ * │    - Token budget enforcement (before the API call)                        │
+ * │    - JSON parsing and schema repair (after the API call)                   │
+ * │    - Retry logic with exponential backoff (on transient failures)          │
+ * │    - Usage tracking (tokens used, estimated cost)                          │
+ * └─────────────────────────────────────────────────────────────────────────────┘
+ */
+
+'use strict';
+
+import { isValidPageSchema } from './pageSchema.js';
+import { buildSystemPrompt } from './promptBuilder.js';
+
+// ─── Constants ────────────────────────────────────────────────────────────────
+
+/** Approximate characters-per-token ratio for English text. */
+const CHARS_PER_TOKEN = 4;
+
+/** Default token limits. Can be overridden per-provider in config. */
+const DEFAULT_LIMITS = {
+  maxInputTokens:    3000,   // Max tokens in the prompt sent to the LLM
+  maxOutputTokens:   2000,   // Max tokens requested in the response
+  maxSessionTokens:  20000,  // Total tokens allowed in one browser session
+  maxRequestsPerMin: 10,     // Rate limit guard (requests per minute)
+};
+
+/** Retry configuration for transient failures. */
+const RETRY_CONFIG = {
+  maxAttempts:    3,
+  baseDelayMs:    800,
+  backoffFactor:  2,
+};
+
+// ─── PromptBudget ─────────────────────────────────────────────────────────────
+
+/**
+ * Tracks token usage and enforces limits for a single browser session.
+ * Shared across all provider instances.
+ */
+export class PromptBudget {
+  constructor() {
+    this._sessionTokens    = 0;
+    this._requestTimestamps = [];
+    this._limits           = { ...DEFAULT_LIMITS };
+    this._usageLog         = [];
+  }
+
+  /**
+   * Configure limits. Called by the provider on instantiation.
+   * @param {Partial<typeof DEFAULT_LIMITS>} limits
+   */
+  configure(limits = {}) {
+    this._limits = { ...DEFAULT_LIMITS, ...limits };
+  }
+
+  /**
+   * Estimate the number of tokens in a string.
+   * Uses a simple character-count heuristic (4 chars ≈ 1 token).
+   * @param {string} text
+   * @returns {number}
+   */
+  estimateTokens(text) {
+    return Math.ceil((text || '').length / CHARS_PER_TOKEN);
+  }
+
+  /**
+   * Check whether a proposed request is within all budget limits.
+   * Throws a descriptive error if any limit would be exceeded.
+   *
+   * @param {string} systemPrompt
+   * @param {string} userMessage
+   * @throws {Error} If any limit is exceeded
+   */
+  checkBudget(systemPrompt, userMessage) {
+    const inputTokens = this.estimateTokens(systemPrompt) + this.estimateTokens(userMessage);
+
+    // 1. Input token limit
+    if (inputTokens > this._limits.maxInputTokens) {
+      throw new Error(
+        `Prompt too large: estimated ${inputTokens} tokens exceeds the ` +
+        `${this._limits.maxInputTokens}-token input limit. ` +
+        `Try a shorter or simpler description.`
+      );
+    }
+
+    // 2. Session token limit
+    const projectedSession = this._sessionTokens + inputTokens + this._limits.maxOutputTokens;
+    if (projectedSession > this._limits.maxSessionTokens) {
+      throw new Error(
+        `Session token limit reached (${this._limits.maxSessionTokens} tokens). ` +
+        `Refresh the page to start a new session.`
+      );
+    }
+
+    // 3. Rate limit (requests per minute)
+    const now = Date.now();
+    this._requestTimestamps = this._requestTimestamps.filter((t) => now - t < 60_000);
+    if (this._requestTimestamps.length >= this._limits.maxRequestsPerMin) {
+      throw new Error(
+        `Rate limit: maximum ${this._limits.maxRequestsPerMin} AI requests per minute. ` +
+        `Please wait a moment before trying again.`
+      );
+    }
+  }
+
+  /**
+   * Record a completed request's token usage.
+   * @param {string} provider
+   * @param {string} model
+   * @param {number} inputTokens
+   * @param {number} outputTokens
+   */
+  recordUsage(provider, model, inputTokens, outputTokens) {
+    const total = inputTokens + outputTokens;
+    this._sessionTokens += total;
+    this._requestTimestamps.push(Date.now());
+
+    const entry = {
+      ts:           new Date().toISOString(),
+      provider,
+      model,
+      inputTokens,
+      outputTokens,
+      totalTokens:  total,
+      estimatedCost: _estimateCost(provider, model, inputTokens, outputTokens),
+    };
+
+    this._usageLog.push(entry);
+
+    console.info(
+      `[Nuvra Budget] ${provider}/${model} — ` +
+      `${inputTokens} in + ${outputTokens} out = ${total} tokens ` +
+      `(session: ${this._sessionTokens}) ` +
+      `≈ $${entry.estimatedCost.toFixed(5)}`
+    );
+  }
+
+  /** Get the current session token count. */
+  get sessionTokens() { return this._sessionTokens; }
+
+  /** Get the full usage log for this session. */
+  get usageLog() { return [...this._usageLog]; }
+
+  /** Get the remaining session token budget. */
+  get remainingTokens() {
+    return Math.max(0, this._limits.maxSessionTokens - this._sessionTokens);
+  }
+
+  /** Reset session counters (e.g., after a page reload). */
+  reset() {
+    this._sessionTokens     = 0;
+    this._requestTimestamps = [];
+    this._usageLog          = [];
+  }
+}
+
+// Singleton budget instance shared across all providers
+export const sessionBudget = new PromptBudget();
+
+// ─── ProviderBase ─────────────────────────────────────────────────────────────
+
+/**
+ * Abstract base class for all Nuvra AI providers.
+ *
+ * Subclasses must implement:
+ *  - `get id()` — unique string identifier (e.g., 'openai')
+ *  - `get defaultModel()` — default model name
+ *  - `_callAPI(systemPrompt, userMessage, options)` — makes the actual API call,
+ *    returns a raw string (the LLM's response text)
+ *
+ * Subclasses may optionally override:
+ *  - `_generateSite(prompt, options)` — for multi-page generation
+ *  - `get supportedModels()` — list of model names for the UI
+ */
+export class ProviderBase {
+  /**
+   * @param {object} config
+   * @param {string} [config.apiKey]
+   * @param {string} [config.model]
+   * @param {string} [config.baseUrl]
+   * @param {number} [config.maxInputTokens]
+   * @param {number} [config.maxOutputTokens]
+   * @param {number} [config.maxSessionTokens]
+   */
+  constructor(config = {}) {
+    this.config = config;
+    this.model  = config.model || this.defaultModel;
+
+    // Configure budget limits from provider config
+    if (config.maxInputTokens || config.maxOutputTokens || config.maxSessionTokens) {
+      sessionBudget.configure({
+        maxInputTokens:   config.maxInputTokens   || DEFAULT_LIMITS.maxInputTokens,
+        maxOutputTokens:  config.maxOutputTokens  || DEFAULT_LIMITS.maxOutputTokens,
+        maxSessionTokens: config.maxSessionTokens || DEFAULT_LIMITS.maxSessionTokens,
+      });
+    }
+  }
+
+  /** Unique provider identifier. Must be overridden. */
+  get id()           { return 'base'; }
+
+  /** Human-readable provider name. */
+  get name()         { return this.constructor.name; }
+
+  /** Default model name. Must be overridden. */
+  get defaultModel() { return ''; }
+
+  /** List of supported model names for the settings UI. */
+  get supportedModels() { return [this.defaultModel]; }
+
+  /**
+   * Make the actual API call. Must be implemented by subclasses.
+   * Returns the raw text response from the LLM.
+   *
+   * @param {string} systemPrompt
+   * @param {string} userMessage
+   * @param {object} options
+   * @returns {Promise<{text: string, inputTokens: number, outputTokens: number}>}
+   */
+  // eslint-disable-next-line no-unused-vars
+  async _callAPI(systemPrompt, userMessage, options) {
+    throw new Error(`[Nuvra AI] Provider "${this.name}" must implement _callAPI().`);
+  }
+
+  /**
+   * Generate a single page. This is the main entry point called by aiEngine.js.
+   * Handles budget checks, retries, JSON parsing, and schema repair.
+   *
+   * @param {string} prompt
+   * @param {object} options
+   * @returns {Promise<{schema: PageSchema, meta: object}>}
+   */
+  async generate(prompt, options = {}) {
+    const systemPrompt = buildSystemPrompt(options);
+    const userMessage  = `Generate a complete page for: "${prompt}"`;
+
+    // Budget check before making the API call
+    sessionBudget.checkBudget(systemPrompt, userMessage);
+
+    let lastError;
+
+    for (let attempt = 1; attempt <= RETRY_CONFIG.maxAttempts; attempt++) {
+      try {
+        const { text, inputTokens, outputTokens } = await this._callAPI(
+          systemPrompt,
+          userMessage,
+          options
+        );
+
+        // Record usage
+        sessionBudget.recordUsage(this.id, this.model, inputTokens, outputTokens);
+
+        // Parse and validate the schema
+        const schema = _parseAndRepairSchema(text, this.name);
+
+        return {
+          schema,
+          meta: {
+            provider:     this.id,
+            model:        this.model,
+            tokens:       inputTokens + outputTokens,
+            inputTokens,
+            outputTokens,
+            attempt,
+          },
+        };
+
+      } catch (err) {
+        lastError = err;
+
+        // Don't retry budget errors — they are deterministic
+        if (err.message.includes('token') || err.message.includes('Rate limit')) {
+          throw err;
+        }
+
+        if (attempt < RETRY_CONFIG.maxAttempts) {
+          const delay = RETRY_CONFIG.baseDelayMs * Math.pow(RETRY_CONFIG.backoffFactor, attempt - 1);
+          console.warn(`[Nuvra AI] Attempt ${attempt} failed. Retrying in ${delay}ms…`, err.message);
+          await _sleep(delay);
+        }
+      }
+    }
+
+    throw new Error(
+      `[Nuvra AI] Generation failed after ${RETRY_CONFIG.maxAttempts} attempts. ` +
+      `Last error: ${lastError?.message || 'Unknown error'}`
+    );
+  }
+
+  /**
+   * Generate a full multi-page site. Default implementation calls `generate()`
+   * once for the primary page. Real providers can override this for true
+   * multi-page generation.
+   *
+   * @param {string} prompt
+   * @param {object} options
+   * @returns {Promise<Array<{pageId, pageName, schema, meta}>>}
+   */
+  async _generateSite(prompt, options = {}) {
+    const result = await this.generate(prompt, options);
+    return [{
+      pageId:   'home',
+      pageName: result.schema.name || 'Home',
+      schema:   result.schema,
+      meta:     result.meta,
+    }];
+  }
+}
+
+// ─── Schema Repair ────────────────────────────────────────────────────────────
+
+/**
+ * Parse a raw LLM response string into a valid PageSchema.
+ * Applies several repair strategies before giving up.
+ *
+ * @param {string} raw
+ * @param {string} providerName
+ * @returns {object} A valid PageSchema
+ * @throws {Error} If the schema cannot be repaired
+ */
+function _parseAndRepairSchema(raw, providerName) {
+  if (!raw || typeof raw !== 'string') {
+    throw new Error(`${providerName} returned an empty or non-string response.`);
+  }
+
+  let text = raw.trim();
+
+  // Strategy 1: Strip markdown code fences
+  if (text.startsWith('```')) {
+    text = text.replace(/^```(?:json)?\s*\n?/, '').replace(/\n?\s*```$/, '').trim();
+  }
+
+  // Strategy 2: Direct parse
+  let parsed = _tryParse(text);
+
+  // Strategy 3: Extract first JSON object from surrounding text
+  if (!parsed) {
+    const match = text.match(/\{[\s\S]*\}/);
+    if (match) parsed = _tryParse(match[0]);
+  }
+
+  if (!parsed) {
+    throw new Error(
+      `${providerName} response could not be parsed as JSON. ` +
+      `The model may have returned a non-JSON response. Please try again.`
+    );
+  }
+
+  // Strategy 4: Schema repair — fix common structural issues
+  parsed = _repairSchema(parsed);
+
+  // Final validation
+  if (!isValidPageSchema(parsed)) {
+    throw new Error(
+      `${providerName} returned a JSON object that does not match the PageSchema format. ` +
+      `Missing required fields: name, settings, or sections.`
+    );
+  }
+
+  return parsed;
+}
+
+/**
+ * Attempt to repair a parsed object that is close to but not quite a valid PageSchema.
+ * Handles common LLM mistakes like missing fields or wrong types.
+ *
+ * @param {object} obj
+ * @returns {object}
+ */
+function _repairSchema(obj) {
+  if (!obj || typeof obj !== 'object') return obj;
+
+  // Ensure `name` is a non-empty string
+  if (!obj.name || typeof obj.name !== 'string') {
+    obj.name = 'Generated Page';
+  }
+
+  // Ensure `settings` exists and has required fields
+  if (!obj.settings || typeof obj.settings !== 'object') {
+    obj.settings = {};
+  }
+  obj.settings.theme       = obj.settings.theme       || 'light';
+  obj.settings.accentColor = obj.settings.accentColor || '#7c6af7';
+  obj.settings.fontFamily  = obj.settings.fontFamily  || 'system-ui, sans-serif';
+
+  // Ensure `sections` is an array
+  if (!Array.isArray(obj.sections)) {
+    // Some models return `blocks` or `components` instead of `sections`
+    obj.sections = obj.blocks || obj.components || obj.content || [];
+  }
+
+  // Repair individual sections
+  obj.sections = obj.sections
+    .filter((s) => s && typeof s === 'object')
+    .map((s) => {
+      // Ensure `type` is a string
+      if (!s.type || typeof s.type !== 'string') {
+        s.type = 'hero'; // fallback to hero if type is missing
+      }
+      // Ensure `props` is an object
+      if (!s.props || typeof s.props !== 'object') {
+        s.props = s.content || s.data || s.attributes || {};
+      }
+      return s;
+    });
+
+  // Ensure at least one section exists
+  if (obj.sections.length === 0) {
+    obj.sections = [{
+      type:  'hero',
+      props: {
+        title:    obj.name,
+        subtitle: 'Generated by Nuvra AI',
+        cta:      'Get Started',
+      },
+    }];
+  }
+
+  return obj;
+}
+
+// ─── Cost Estimation ──────────────────────────────────────────────────────────
+
+/**
+ * Estimate the cost of a request in USD.
+ * Prices are approximate and based on public pricing as of early 2025.
+ * These are for informational purposes only.
+ *
+ * @param {string} provider
+ * @param {string} model
+ * @param {number} inputTokens
+ * @param {number} outputTokens
+ * @returns {number} Estimated cost in USD
+ */
+function _estimateCost(provider, model, inputTokens, outputTokens) {
+  // Prices per 1M tokens (input / output) in USD
+  const PRICING = {
+    // OpenAI
+    'gpt-4o':             { input: 5.00,  output: 15.00 },
+    'gpt-4o-mini':        { input: 0.15,  output: 0.60  },
+    'gpt-4-turbo':        { input: 10.00, output: 30.00 },
+    'gpt-3.5-turbo':      { input: 0.50,  output: 1.50  },
+    // Anthropic
+    'claude-3-opus':      { input: 15.00, output: 75.00 },
+    'claude-3-sonnet':    { input: 3.00,  output: 15.00 },
+    'claude-3-haiku':     { input: 0.25,  output: 1.25  },
+    'claude-3-5-sonnet':  { input: 3.00,  output: 15.00 },
+    'claude-3-5-haiku':   { input: 0.80,  output: 4.00  },
+    // Local / free
+    'local':              { input: 0,     output: 0     },
+  };
+
+  // Normalize model name for lookup
+  const key = Object.keys(PRICING).find((k) => model?.toLowerCase().includes(k)) || 'local';
+  const price = PRICING[key];
+
+  return (inputTokens * price.input + outputTokens * price.output) / 1_000_000;
+}
+
+// ─── Utilities ────────────────────────────────────────────────────────────────
+
+function _tryParse(text) {
+  try { return JSON.parse(text); } catch { return null; }
+}
+
+function _sleep(ms) {
+  return new Promise((r) => setTimeout(r, ms));
+}
diff --git a/src/ai/providers/anthropicProvider.js b/src/ai/providers/anthropicProvider.js
new file mode 100644
index 0000000..34127b0
--- /dev/null
+++ b/src/ai/providers/anthropicProvider.js
@@ -0,0 +1,211 @@
+/**
+ * Nuvra Builder — Anthropic (Claude) Provider  (Phase 5A)
+ *
+ * Implements the ProviderBase contract for Anthropic's Messages API.
+ *
+ * Key features:
+ *  - Uses the "assistant prefill" technique to enforce JSON-only output.
+ *    By starting the assistant's response with `{`, Claude is guided to
+ *    continue with a valid JSON object and skip any preamble text.
+ *  - Supports Claude 3 Haiku, Sonnet, and Opus, plus Claude 3.5 models.
+ *  - Implements `_generateSite()` for multi-page generation.
+ *  - Reports exact token counts from the API response.
+ *
+ * Design decisions:
+ *  - Anthropic does not have a native JSON mode (as of early 2025), so
+ *    the prefill technique is the most reliable way to get clean JSON output.
+ *    The prefill `{` is stripped from the final response before parsing.
+ *  - The `max_tokens` is set to 4096, which is sufficient for a full PageSchema.
+ *    For multi-page generation, this is increased to 8192.
+ *  - We use `anthropic-version: 2023-06-01` which is the stable API version.
+ */
+
+'use strict';
+
+import { ProviderBase }          from '../providerBase.js';
+import { buildSiteSystemPrompt,
+         buildSiteUserMessage }  from '../promptBuilder.js';
+
+export class AnthropicProvider extends ProviderBase {
+
+  constructor(config = {}) {
+    super(config);
+    this.temperature = config.temperature ?? 0.7;
+  }
+
+  get id()           { return 'anthropic'; }
+  get name()         { return 'Anthropic (Claude)'; }
+  get defaultModel() { return 'claude-3-haiku-20240307'; }
+
+  get supportedModels() {
+    return [
+      'claude-3-haiku-20240307',
+      'claude-3-5-haiku-20241022',
+      'claude-3-sonnet-20240229',
+      'claude-3-5-sonnet-20241022',
+      'claude-3-opus-20240229',
+    ];
+  }
+
+  /**
+   * Make a single Messages API request using the assistant prefill technique.
+   * @param {string} systemPrompt
+   * @param {string} userMessage
+   * @param {object} options
+   * @returns {Promise<{text: string, inputTokens: number, outputTokens: number}>}
+   */
+  async _callAPI(systemPrompt, userMessage, options = {}) {
+    if (!this.config.apiKey) {
+      throw new Error(
+        'Anthropic API key is not configured. ' +
+        'Open AI Settings and enter your key.'
+      );
+    }
+
+    const response = await fetch('https://api.anthropic.com/v1/messages', {
+      method:  'POST',
+      headers: {
+        'Content-Type':      'application/json',
+        'x-api-key':         this.config.apiKey,
+        'anthropic-version': '2023-06-01',
+      },
+      body: JSON.stringify({
+        model:      this.model,
+        max_tokens: 4096,
+        system:     systemPrompt,
+        messages: [
+          { role: 'user',      content: userMessage },
+          // Prefill: force Claude to start the response with `{`
+          // This is the most reliable way to get JSON-only output from Claude.
+          { role: 'assistant', content: '{' },
+        ],
+      }),
+    });
+
+    if (!response.ok) {
+      const err = await response.json().catch(() => ({}));
+      const msg = err?.error?.message || response.statusText;
+
+      if (response.status === 401) throw new Error('Invalid Anthropic API key. Please check your key in AI Settings.');
+      if (response.status === 429) throw new Error('Anthropic rate limit exceeded. Please wait a moment and try again.');
+      if (response.status === 529) throw new Error('Anthropic API is overloaded. Please try again in a few seconds.');
+      throw new Error(`Anthropic error (${response.status}): ${msg}`);
+    }
+
+    const data = await response.json();
+
+    // The response content starts after our prefill `{`, so we prepend it back
+    const rawText = '{' + (data.content?.[0]?.text || '');
+
+    return {
+      text:         rawText,
+      inputTokens:  data.usage?.input_tokens  ?? 0,
+      outputTokens: data.usage?.output_tokens ?? 0,
+    };
+  }
+
+  /**
+   * Multi-page site generation using a single API call.
+   *
+   * @param {string} prompt
+   * @param {object} options
+   * @returns {Promise<Array<{pageId, pageName, schema, meta}>>}
+   */
+  async _generateSite(prompt, options = {}) {
+    if (!this.config.apiKey) {
+      throw new Error('Anthropic API key is not configured. Open AI Settings and enter your key.');
+    }
+
+    const systemPrompt = buildSiteSystemPrompt(options);
+    const userMessage  = buildSiteUserMessage(prompt);
+
+    // For site generation, use a higher max_tokens limit
+    const response = await fetch('https://api.anthropic.com/v1/messages', {
+      method:  'POST',
+      headers: {
+        'Content-Type':      'application/json',
+        'x-api-key':         this.config.apiKey,
+        'anthropic-version': '2023-06-01',
+      },
+      body: JSON.stringify({
+        model:      this.model,
+        max_tokens: 8192,
+        system:     systemPrompt,
+        messages: [
+          { role: 'user',      content: userMessage },
+          // Prefill with `[` to guide Claude to return a JSON array
+          { role: 'assistant', content: '[' },
+        ],
+      }),
+    });
+
+    if (!response.ok) {
+      const err = await response.json().catch(() => ({}));
+      throw new Error(`Anthropic error (${response.status}): ${err?.error?.message || response.statusText}`);
+    }
+
+    const data    = await response.json();
+    const rawText = '[' + (data.content?.[0]?.text || '');
+
+    const inputTokens  = data.usage?.input_tokens  ?? 0;
+    const outputTokens = data.usage?.output_tokens ?? 0;
+
+    // Record usage
+    const { sessionBudget } = await import('../providerBase.js');
+    sessionBudget.recordUsage(this.id, this.model, inputTokens, outputTokens);
+
+    // Parse the array of page schemas
+    const pages = _parseSiteResponse(rawText);
+
+    return pages.map((page, index) => ({
+      pageId:   page.pageId   || `page-${index + 1}`,
+      pageName: page.pageName || `Page ${index + 1}`,
+      schema:   page.schema,
+      meta: {
+        provider:     this.id,
+        model:        this.model,
+        tokens:       Math.round((inputTokens + outputTokens) / pages.length),
+        inputTokens:  Math.round(inputTokens  / pages.length),
+        outputTokens: Math.round(outputTokens / pages.length),
+        pageIndex:    index,
+      },
+    }));
+  }
+}
+
+// ─── Site Response Parser ─────────────────────────────────────────────────────
+
+function _parseSiteResponse(raw) {
+  if (!raw) throw new Error('Anthropic returned an empty site response.');
+
+  let text = raw.trim();
+
+  // Strip markdown code fences
+  if (text.startsWith('```')) {
+    text = text.replace(/^```(?:json)?\s*\n?/, '').replace(/\n?\s*```$/, '').trim();
+  }
+
+  let parsed;
+  try {
+    parsed = JSON.parse(text);
+  } catch {
+    const match = text.match(/\[[\s\S]*\]/);
+    if (match) {
+      try { parsed = JSON.parse(match[0]); } catch { /* fall through */ }
+    }
+  }
+
+  if (!parsed) {
+    throw new Error('Could not parse Anthropic site response as JSON.');
+  }
+
+  if (!Array.isArray(parsed)) {
+    if (parsed.pages && Array.isArray(parsed.pages)) {
+      parsed = parsed.pages;
+    } else {
+      parsed = [{ pageId: 'home', pageName: 'Home', schema: parsed }];
+    }
+  }
+
+  return parsed;
+}
diff --git a/src/ai/providers/localProvider.js b/src/ai/providers/localProvider.js
