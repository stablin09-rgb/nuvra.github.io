@@ -0,0 +1,93 @@
+/**
+ * Nuvra Builder — AI Page Schema
+ *
+ * Defines the structured, intermediate representation for an AI-generated page.
+ * This is the core of the new generation pipeline.
+ *
+ * Instead of asking the AI to generate raw HTML/CSS, we ask it to generate
+ * a `PageSchema` object. This object describes the page's structure and content
+ * in a semantic, provider-agnostic way.
+ *
+ * The flow is:
+ *   1. User Prompt → [AI Provider] → `PageSchema` (JSON)
+ *   2. `PageSchema` → [SchemaRenderer] → GrapesJS components
+ *
+ * This approach has several key advantages:
+ *   - **Reliability:** JSON is much more reliable to parse than raw HTML from an LLM.
+ *   - **Consistency:** Generated pages adhere to a consistent design system, as the AI can only use predefined section types.
+ *   - **Extensibility:** New section types can be added without changing the AI prompt structure.
+ *   - **Originality:** The final HTML/CSS is generated by Nuvra's own block/component library, not the LLM, ensuring a unique and clean output.
+ */
+
+'use strict';
+
+/**
+ * Represents a full page generated by the AI.
+ * It contains global settings and an array of sections.
+ *
+ * @typedef {object} PageSchema
+ * @property {string} name - The name of the page (e.g., "Landing Page for a SaaS Startup").
+ * @property {object} settings - Global settings that apply to the entire page.
+ * @property {'dark'|'light'} [settings.theme='light'] - The overall color theme.
+ * @property {string} [settings.accentColor='#7c6af7'] - The primary accent color for buttons and highlights.
+ * @property {string} [settings.fontFamily='system-ui'] - The primary font for the page.
+ * @property {SectionSchema[]} sections - An ordered array of the sections that compose the page.
+ */
+
+/**
+ * Represents a single section within a page (e.g., a hero, a features grid).
+ * Each section has a specific type and a set of properties tailored to that type.
+ *
+ * @typedef {object} SectionSchema
+ * @property {string} type - The type of the section. This MUST correspond to a key in the `blockLibrary.js` or a registered component.
+ *    Examples: 'hero', 'features', 'cta', 'testimonial', 'navbar', 'footer'.
+ * @property {object.<string, any>} props - A key-value map of properties for this section.
+ *    The keys and value types are specific to the section `type`.
+ *    Example for a 'hero': { title: 'My Awesome Product', subtitle: 'It does amazing things.', cta: 'Get Started' }
+ */
+
+/**
+ * A helper function to create a default, empty page schema.
+ * @returns {PageSchema}
+ */
+export function createDefaultPageSchema() {
+  return {
+    name: 'New Page',
+    settings: {
+      theme: 'light',
+      accentColor: '#7c6af7',
+      fontFamily: 'system-ui, -apple-system, sans-serif',
+    },
+    sections: [
+      {
+        type: 'hero',
+        props: {
+          title: 'Welcome to Nuvra',
+          subtitle: 'This is a page generated from a Nuvra Page Schema. You can edit it just like any other page.',
+          cta: 'Learn More',
+        },
+      },
+    ],
+  };
+}
+
+/**
+ * Validates a given object to see if it conforms to the PageSchema structure.
+ * This is a basic validator and can be expanded for more rigorous checks.
+ *
+ * @param {any} data - The object to validate.
+ * @returns {boolean} - True if the object is a valid PageSchema.
+ */
+export function isValidPageSchema(data) {
+  if (!data || typeof data !== 'object') return false;
+  if (typeof data.name !== 'string' || !data.name) return false;
+  if (typeof data.settings !== 'object') return false;
+  if (!Array.isArray(data.sections)) return false;
+
+  for (const section of data.sections) {
+    if (typeof section.type !== 'string' || !section.type) return false;
+    if (typeof section.props !== 'object') return false;
+  }
+
+  return true;
+}
