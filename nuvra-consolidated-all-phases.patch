+/**
+ * Nuvra Builder — Application Entry Point
+ *
+ * Bootstraps the entire application in the correct order:
+ *  1. Load saved project from storage
+ *  2. Initialise GrapesJS editor
+ *  3. Register block library
+ *  4. Initialise page manager with restored state
+ *  5. Configure AI engine from saved settings
+ *  6. Initialise Phase 3 systems (data model, state, app components)
+ *  7. Bind all top-bar and sidebar button events
+ *
+ * This file should remain thin — it wires modules together
+ * and delegates all logic to the appropriate module.
+ */
+
+'use strict';
+
+// ─── Core Modules ─────────────────────────────────────────────────────────────
+
+import { loadProject }                       from './storage.js';
+import { init as initPages, addPage, renamePage, deletePage,
+         getSnapshot, addGeneratedPage, switchPage }            from './pageManager.js';
+import { exportCurrentPage, exportFullSite,
+         exportProjectJson, importProjectJson }                 from './exportImport.js';
+import { registerBlocks }                    from '../blocks/blockLibrary.js';
+import { generatePage, generateSite }        from '../ai/aiEngine.js';
+import { initAI, openAISettings }            from '../ai/aiSettings.js';
+import { slugify, showToast }                from '../utils/helpers.js';
+
+// ─── Phase 3 Modules ──────────────────────────────────────────────────────────
+
+import { dataStore }                         from '../data/dataModel.js';
+import { createCollection, createFromTemplate,
+         deleteCollection, getCollectionSummaries,
+         COLLECTION_TEMPLATES, onCollectionChange } from '../data/collectionManager.js';
+import { getAllAppComponents, getAppComponentsByCategory,
+         renderAppComponent }                from '../app-components/appComponents.js';
+import { getPageTypeConfig, getPageTypesByKind,
+         isAppPage, buildPageTypeContext,
+         createPageConfig, applyPageType }   from '../core/pageSemantics.js';
+import { mountRuntime, unmountRuntime }      from '../runtime/appRuntime.js';
+import { appState }                          from '../state/stateManager.js';
+
+// ─── Phase 4 Modules ──────────────────────────────────────────────────────────
+
+import { initPreview, enterPreview, exitPreview,
+         isPreviewMode }                     from '../preview/previewManager.js';
+
+// ─── Phase 4B Modules ─────────────────────────────────────────────────────────
+
+import { openPublishModal }               from '../publish/publishManager.js';
+
+// ─── 1. Restore saved project (or create default) ────────────────────────────
+
+const saved = loadProject();
+
+const initialPages = saved?.pages ?? {
+  home: {
+    name: 'Home',
+    html: `<section style="padding:100px 40px; text-align:center; background:linear-gradient(135deg,#0b0b0f,#1a1a2e); color:#fff;">
+  <h1 style="font-size:52px; font-weight:800; margin:0 0 20px;">Welcome to Nuvra</h1>
+  <p style="font-size:18px; color:#aaa; max-width:540px; margin:0 auto 36px;">Drag blocks from the left panel, or use AI to generate a full page instantly.</p>
+  <button style="padding:14px 32px; background:#7c6af7; color:#fff; border:none; border-radius:8px; font-size:16px; font-weight:600; cursor:pointer;">Get Started</button>
+</section>`,
+    css:        '',
+    schema:     null,
+    pageConfig: { type: 'landing', title: 'Home' },
+    meta: { createdAt: new Date().toISOString(), updatedAt: new Date().toISOString() },
+  },
+};
+
+const initialCurrentPage = saved?.currentPage ?? 'home';
+
+// ─── 2. Initialise GrapesJS ───────────────────────────────────────────────────
+
+const editor = grapesjs.init({
+  container:  '#gjs',
+  height:     '100%',
+  fromElement: false,
+
+  // Disable GrapesJS's built-in storage — Nuvra manages its own
+  storageManager: false,
+
+  // Disable default panels (Nuvra provides its own top bar)
+  panels: { defaults: [] },
+
+  blockManager: {
+    appendTo: '#blocks',
+    blocks:   [],
+  },
+
+  styleManager: {
+    appendTo: '#style-panel',
+    sectors: [
+      {
+        name: 'Typography',
+        open: false,
+        properties: ['font-family', 'font-size', 'font-weight', 'color', 'line-height', 'text-align'],
+      },
+      {
+        name: 'Spacing',
+        open: false,
+        properties: ['margin', 'padding'],
+      },
+      {
+        name: 'Dimensions',
+        open: false,
+        properties: ['width', 'height', 'max-width'],
+      },
+      {
+        name: 'Background',
+        open: false,
+        properties: ['background-color', 'background'],
+      },
+      {
+        name: 'Border',
+        open: false,
+        properties: ['border', 'border-radius'],
+      },
+    ],
+  },
+
+  canvas: {
+    styles: [
+      'https://unpkg.com/normalize.css@8.0.1/normalize.css',
+    ],
+  },
+});
+
+// ─── 3. Register blocks ───────────────────────────────────────────────────────
+
+registerBlocks(editor);
+
+// ─── 4. Initialise page manager ───────────────────────────────────────────────
+
+initPages(editor, initialPages, initialCurrentPage);
+
+// ─── 5. Configure AI engine ───────────────────────────────────────────────────
+
+initAI();
+
+// ─── 5b. Initialise Preview Manager ──────────────────────────────────────────
+
+initPreview(editor);
+
+// ─── 6. Phase 3: Initialise data model, app components, and runtime ──────────
+
+/**
+ * Mount the AppRuntime whenever the active page changes.
+ * The runtime is only activated for app-type pages.
+ */
+editor.on('load', () => {
+  const { pages, currentPage } = getSnapshot();
+  const page = pages[currentPage];
+  const pageType = page?.pageConfig?.type || 'landing';
+
+  if (isAppPage(pageType)) {
+    const canvasRoot = editor.Canvas.getFrameEl()?.contentDocument?.body;
+    if (canvasRoot) mountRuntime(canvasRoot, currentPage, pageType);
+  }
+});
+
+// Re-mount runtime on page switch (handled via page manager's switchPage)
+// We hook into the GrapesJS canvas render completion event
+editor.on('canvas:frame:load', () => {
+  const { pages, currentPage } = getSnapshot();
+  const page = pages[currentPage];
+  const pageType = page?.pageConfig?.type || 'landing';
+
+  unmountRuntime();
+
+  if (isAppPage(pageType)) {
+    const canvasRoot = editor.Canvas.getFrameEl()?.contentDocument?.body;
+    if (canvasRoot) mountRuntime(canvasRoot, currentPage, pageType);
+  }
+});
+
+// ─── 7. Bind top-bar events ───────────────────────────────────────────────────
+
+document.getElementById('btn-preview').addEventListener('click', () => {
+  if (isPreviewMode()) exitPreview();
+  else enterPreview();
+});
+
+document.getElementById('btn-publish').addEventListener('click', openPublishModal);
+
+document.getElementById('btn-add-page').addEventListener('click',    addPage);
+document.getElementById('btn-rename-page').addEventListener('click', renamePage);
+document.getElementById('btn-delete-page').addEventListener('click', deletePage);
+
+document.getElementById('btn-export-page').addEventListener('click',    () => exportCurrentPage(editor));
+document.getElementById('btn-export-site').addEventListener('click',    () => exportFullSite(editor));
+document.getElementById('btn-export-project').addEventListener('click', exportProjectJson);
+document.getElementById('btn-import-project').addEventListener('click', importProjectJson);
+
+document.getElementById('btn-ai-settings').addEventListener('click', openAISettings);
+
+// ─── 8. AI Generation ─────────────────────────────────────────────────────────
+
+document.getElementById('btn-generate-ai').addEventListener('click', async () => {
+  const promptInput = document.getElementById('aiPrompt');
+  const statusEl    = document.getElementById('aiStatus');
+  const prompt      = promptInput.value.trim();
+
+  if (!prompt) {
+    showToast('Please describe the page you want to generate.', 'error');
+    return;
+  }
+
+  const { pages } = getSnapshot();
+  const id = slugify(prompt);
+  if (pages[id]) {
+    showToast(`A page with this name already exists. Try a different description.`, 'error');
+    return;
+  }
+
+  const btn = document.getElementById('btn-generate-ai');
+  btn.disabled     = true;
+  btn.textContent  = 'Generating…';
+  statusEl.textContent = 'AI is building your page…';
+  statusEl.classList.add('visible');
+
+  try {
+    const result = await generatePage(prompt);
+    addGeneratedPage(id, result.name, result.html, result.css, result.schema ?? null);
+    promptInput.value = '';
+    showToast(`Page "${result.name}" generated successfully.`, 'success');
+
+    console.info(
+      `[Nuvra AI] Generated via ${result.meta.provider}/${result.meta.model}` +
+      (result.meta.tokens ? ` — ${result.meta.tokens} tokens` : '')
+    );
+  } catch (err) {
+    console.error('[Nuvra AI] Generation failed:', err);
+    showToast(`AI generation failed: ${err.message}`, 'error');
+  } finally {
+    btn.disabled    = false;
+    btn.textContent = 'Generate Page';
+    statusEl.classList.remove('visible');
+  }
+});
+
+document.getElementById('aiPrompt').addEventListener('keydown', (e) => {
+  if (e.key === 'Enter') document.getElementById('btn-generate-ai').click();
+});
+
+// ─── 9. AI Site Generation (multi-page) ──────────────────────────────────────
+
+document.getElementById('btn-generate-site').addEventListener('click', async () => {
+  const promptInput = document.getElementById('aiPrompt');
+  const statusEl    = document.getElementById('aiStatus');
+  const prompt      = promptInput.value.trim();
+
+  if (!prompt) {
+    showToast('Please describe the site you want to generate.', 'error');
+    return;
+  }
+
+  const btn = document.getElementById('btn-generate-site');
+  btn.disabled    = true;
+  btn.textContent = 'Planning…';
+  statusEl.textContent = 'AI is planning your site…';
+  statusEl.classList.add('visible');
+
+  try {
+    const pages = await generateSite(prompt);
+    statusEl.textContent = `Generating ${pages.length} page${pages.length > 1 ? 's' : ''}…`;
+
+    let firstPageId = null;
+    for (const page of pages) {
+      const { pages: existingPages } = getSnapshot();
+      let id = page.pageId;
+      if (existingPages[id]) id = `${id}-${Date.now().toString(36)}`;
+
+      addGeneratedPage(id, page.pageName, page.html, page.css, page.schema ?? null);
+      if (!firstPageId) firstPageId = id;
+    }
+
+    promptInput.value = '';
+    showToast(
+      `Site generated: ${pages.length} page${pages.length > 1 ? 's' : ''} created.`,
+      'success'
+    );
+
+    console.info(
+      `[Nuvra AI] Site generated — ${pages.length} pages via ` +
+      `${pages[0]?.meta?.provider ?? 'mock'}/${pages[0]?.meta?.model ?? 'unknown'}`
+    );
+  } catch (err) {
+    console.error('[Nuvra AI] Site generation failed:', err);
+    showToast(`Site generation failed: ${err.message}`, 'error');
+  } finally {
+    btn.disabled    = false;
+    btn.textContent = 'Generate Site';
+    statusEl.classList.remove('visible');
+  }
+});
+
+// ─── 10. Sidebar tab switching ────────────────────────────────────────────────
+
+document.querySelectorAll('.sidebar-tab').forEach((tab) => {
+  tab.addEventListener('click', () => {
+    document.querySelectorAll('.sidebar-tab').forEach((t) => t.classList.remove('active'));
+    tab.classList.add('active');
+
+    const target = tab.dataset.panel;
+    document.querySelectorAll('.sidebar-panel').forEach((panel) => {
+      panel.style.display = panel.id === target ? '' : 'none';
+    });
+  });
+});
+
+// ─── 11. Phase 3: Data Panel ──────────────────────────────────────────────────
+
+/**
+ * Render the collections list in the Data sidebar panel.
+ */
+function _renderCollectionsList() {
+  const container = document.getElementById('data-collections-list');
+  if (!container) return;
+
+  const summaries = getCollectionSummaries();
+
+  if (summaries.length === 0) {
+    container.innerHTML = `
+      <div class="nv-data-empty">
+        <p>No collections yet.</p>
+        <small>Create one to start building data-driven pages.</small>
+      </div>`;
+    return;
+  }
+
+  container.innerHTML = summaries.map(({ schema, recordCount }) => `
+    <div class="nv-collection-item" data-collection-id="${schema.id}">
+      <div class="nv-collection-info">
+        <div class="nv-collection-name">${schema.name}</div>
+        <div class="nv-collection-meta">
+          ${Object.keys(schema.fields).length} fields &middot; ${recordCount} record${recordCount !== 1 ? 's' : ''}
+        </div>
+      </div>
+      <button class="nv-btn sm danger" data-delete-collection="${schema.id}" title="Delete collection">&#x2715;</button>
+    </div>
+  `).join('');
+
+  // Wire delete buttons
+  container.querySelectorAll('[data-delete-collection]').forEach((btn) => {
+    btn.addEventListener('click', async (e) => {
+      e.stopPropagation();
+      const id = btn.dataset.deleteCollection;
+      const { confirmModal } = await import('../utils/helpers.js');
+      const ok = await confirmModal('Delete Collection', `Delete "${id}" and all its records? This cannot be undone.`);
+      if (ok) {
+        deleteCollection(id);
+        showToast(`Collection "${id}" deleted.`, 'success');
+      }
+    });
+  });
+}
+
+// Re-render whenever collections change
+onCollectionChange(() => _renderCollectionsList());
+
+// Initial render
+_renderCollectionsList();
+
+// Create collection from template
+document.getElementById('btn-create-collection')?.addEventListener('click', async () => {
+  const { promptModal } = await import('../utils/helpers.js');
+  const templateId = document.getElementById('collection-template-select')?.value;
+
+  if (templateId && templateId !== 'custom') {
+    try {
+      const schema = createFromTemplate(templateId);
+      showToast(`Collection "${schema.name}" created.`, 'success');
+    } catch (err) {
+      showToast(err.message, 'error');
+    }
+  } else {
+    const name = await promptModal('New Collection', 'Collection name…');
+    if (!name) return;
+    try {
+      const schema = createCollection({ name });
+      showToast(`Collection "${schema.name}" created.`, 'success');
+    } catch (err) {
+      showToast(err.message, 'error');
+    }
+  }
+});
+
+// ─── 12. Phase 3: App Components Panel ───────────────────────────────────────
+
+/**
+ * Render the app components panel in the sidebar.
+ * Components are grouped by category and can be dragged into the canvas.
+ */
+function _renderAppComponentsPanel() {
+  const container = document.getElementById('app-components-list');
+  if (!container) return;
+
+  const categories = ['Form', 'Data', 'Display', 'Layout', 'Logic'];
+
+  container.innerHTML = categories.map((cat) => {
+    const components = getAppComponentsByCategory(cat);
+    if (components.length === 0) return '';
+
+    const items = components.map((def) => `
+      <div class="nv-app-component-item"
+           draggable="true"
+           data-component-id="${def.id}"
+           title="${def.description}">
+        <div class="nv-app-component-name">${def.name}</div>
+        <div class="nv-app-component-desc">${def.description}</div>
+      </div>
+    `).join('');
+
+    return `
+      <div class="nv-component-category">
+        <div class="nv-component-category-label">${cat}</div>
+        ${items}
+      </div>
+    `;
+  }).join('');
+
+  // Wire drag-to-canvas for app components
+  container.querySelectorAll('[data-component-id]').forEach((item) => {
+    item.addEventListener('dragstart', (e) => {
+      const componentId = item.dataset.componentId;
+      e.dataTransfer.setData('text/plain', componentId);
+    });
+
+    // Click to insert at the end of the canvas
+    item.addEventListener('click', () => {
+      const componentId = item.dataset.componentId;
+      const collectionId = _getFirstCollectionId();
+
+      try {
+        const { html, css } = renderAppComponent(componentId, {
+          collectionId: collectionId || 'your-collection',
+          title:        _getComponentDefaultTitle(componentId),
+        });
+
+        editor.addComponents(html);
+        if (css) editor.addStyle(css);
+
+        showToast(`${item.querySelector('.nv-app-component-name').textContent} added to canvas.`, 'success');
+      } catch (err) {
+        showToast(`Failed to add component: ${err.message}`, 'error');
+      }
+    });
+  });
+}
+
+function _getFirstCollectionId() {
+  const summaries = getCollectionSummaries();
+  return summaries.length > 0 ? summaries[0].schema.id : null;
+}
+
+function _getComponentDefaultTitle(componentId) {
+  const titles = {
+    'data-table':  'Records',
+    'data-list':   'Items',
+    'data-form':   'Add Record',
+    'data-detail': 'Record Details',
+    'stat-display':'Total',
+    'app-header':  'Dashboard',
+    'app-layout':  '',
+    'show-if':     '',
+    'loading-gate':'',
+  };
+  return titles[componentId] || '';
+}
+
+// Initial render of app components panel
+_renderAppComponentsPanel();
+
+// ─── 13. Phase 3: Page Type Selector ─────────────────────────────────────────
+
+/**
+ * Update the current page's type when the user changes the page type selector.
+ */
+document.getElementById('page-type-select')?.addEventListener('change', (e) => {
+  const typeId = e.target.value;
+  const { pages, currentPage } = getSnapshot();
+  const page = pages[currentPage];
+
+  if (!page) return;
+
+  const updated = applyPageType(page, typeId);
+  // Write the updated pageConfig back into the page manager's state
+  // by re-adding the page (addGeneratedPage handles existing pages)
+  addGeneratedPage(currentPage, updated.name, updated.html, updated.css, updated.schema);
+
+  const typeConfig = getPageTypeConfig(typeId);
+  showToast(`Page type set to "${typeConfig.name}".`, 'success');
+
+  // Switch sidebar panel based on page type
+  if (isAppPage(typeId)) {
+    // Show app components tab
+    const appTab = document.querySelector('[data-panel="app-components-panel"]');
+    if (appTab) appTab.click();
+  } else {
+    // Show blocks tab
+    const blocksTab = document.querySelector('[data-panel="blocks-panel"]');
+    if (blocksTab) blocksTab.click();
+  }
+});
+
+// Populate the page type selector with all available types
+function _populatePageTypeSelector() {
+  const select = document.getElementById('page-type-select');
+  if (!select) return;
+
+  const marketing = getPageTypesByKind('marketing');
+  const app       = getPageTypesByKind('app');
+
+  const makeOptions = (types) =>
+    types.map((t) => `<option value="${t.id}">${t.icon} ${t.name}</option>`).join('');
+
+  select.innerHTML = `
+    <optgroup label="Marketing Pages">
+      ${makeOptions(marketing)}
+    </optgroup>
+    <optgroup label="App Pages">
+      ${makeOptions(app)}
+    </optgroup>
+  `;
+
+  // Set the current page's type
+  const { pages, currentPage } = getSnapshot();
+  const page = pages[currentPage];
+  if (page?.pageConfig?.type) {
+    select.value = page.pageConfig.type;
+  }
+}
+
+_populatePageTypeSelector();
diff --git a/src/core/exportImport.js b/src/core/exportImport.js
new file mode 100644
index 0000000..6353af6
--- /dev/null
+++ b/src/core/exportImport.js
@@ -0,0 +1,146 @@
+/**
+ * Nuvra Builder — Export & Import Module
+ *
+ * Handles all export (single page, full site, project JSON) and
+ * import (project JSON) operations.
+ *
+ * Export formats:
+ *  - Single page  → standalone .html file with inlined CSS
+ *  - Full site    → one .html file per page (downloaded sequentially)
+ *  - Project JSON → full state snapshot for backup / transfer
+ *
+ * Import:
+ *  - Project JSON → restores all pages and editor state
+ */
+
+'use strict';
+
+import { downloadFile, showToast } from '../utils/helpers.js';
+import { serializeProject, deserializeProject } from './storage.js';
+import { getSnapshot, loadPages } from './pageManager.js';
+
+// ─── Export ───────────────────────────────────────────────────────────────────
+
+/**
+ * Export the currently active page as a standalone HTML file.
+ *
+ * @param {object} editor - GrapesJS editor instance
+ */
+export function exportCurrentPage(editor) {
+  const { pages, currentPage } = getSnapshot();
+  const page = pages[currentPage];
+
+  const html = _buildStandaloneHtml(page.name, page.html, editor.getCss());
+  downloadFile(`${currentPage}.html`, html, 'text/html');
+  showToast(`Exported "${page.name}" as HTML.`, 'success');
+}
+
+/**
+ * Export every page as individual HTML files.
+ * Files are downloaded one by one with a short delay to avoid browser blocking.
+ *
+ * @param {object} editor - GrapesJS editor instance
+ */
+export function exportFullSite(editor) {
+  const { pages } = getSnapshot();
+  const ids = Object.keys(pages);
+
+  // Use the shared CSS from the current editor state for all pages
+  const sharedCss = editor.getCss();
+
+  ids.forEach((id, index) => {
+    const page = pages[id];
+    const html = _buildStandaloneHtml(page.name, page.html, page.css || sharedCss);
+
+    // Stagger downloads slightly so browsers don't block them
+    setTimeout(() => {
+      downloadFile(`${id}.html`, html, 'text/html');
+    }, index * 120);
+  });
+
+  showToast(`Exported ${ids.length} page(s) as HTML files.`, 'success');
+}
+
+/**
+ * Export the full project as a JSON file for backup or transfer.
+ */
+export function exportProjectJson() {
+  const { pages, currentPage } = getSnapshot();
+  const json = serializeProject(pages, currentPage);
+  downloadFile('nuvra-project.json', json, 'application/json');
+  showToast('Project exported as JSON.', 'success');
+}
+
+// ─── Import ───────────────────────────────────────────────────────────────────
+
+/**
+ * Open a file picker and import a Nuvra project JSON file.
+ * On success, replaces all current pages with the imported data.
+ */
+export function importProjectJson() {
+  const input    = document.createElement('input');
+  input.type     = 'file';
+  input.accept   = '.json,application/json';
+
+  input.addEventListener('change', (e) => {
+    const file = e.target.files[0];
+    if (!file) return;
+
+    const reader = new FileReader();
+
+    reader.addEventListener('load', () => {
+      try {
+        const project = deserializeProject(reader.result);
+        loadPages(project.pages, project.currentPage);
+        showToast('Project imported successfully.', 'success');
+      } catch (err) {
+        showToast(`Import failed: ${err.message}`, 'error');
+      }
+    });
+
+    reader.readAsText(file);
+  });
+
+  input.click();
+}
+
+// ─── Private Helpers ──────────────────────────────────────────────────────────
+
+/**
+ * Build a complete, self-contained HTML document string.
+ *
+ * @param {string} title - Page <title>
+ * @param {string} body  - Inner HTML for <body>
+ * @param {string} css   - CSS string to inline in <style>
+ * @returns {string}
+ */
+function _buildStandaloneHtml(title, body, css) {
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>${_escapeHtml(title)}</title>
+  <style>
+${css || ''}
+  </style>
+</head>
+<body>
+${body || ''}
+</body>
+</html>`;
+}
+
+/**
+ * Escape HTML special characters to prevent XSS in title attributes.
+ *
+ * @param {string} str
+ * @returns {string}
+ */
+function _escapeHtml(str) {
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
diff --git a/src/core/pageManager.js b/src/core/pageManager.js
