+      '--nv-page-padding': '24px',
+    },
+    suggestedComponents: ['data-form', 'app-header', 'app-layout'],
+    aiHint: 'Generate a settings page with a sidebar navigation and grouped form sections for general, notifications, and security settings.',
+  },
+
+  report: {
+    id:          'report',
+    name:        'Report Page',
+    kind:        'app',
+    description: 'A data report page with tables, stats, and export options.',
+    icon:        '📈',
+    defaultState: {
+      exportFormat: { default: 'csv', type: 'string', description: 'Selected export format' },
+    },
+    layoutHints: {
+      '--nv-page-bg':      '#f5f5f7',
+      '--nv-page-padding': '24px',
+    },
+    suggestedComponents: ['stat-display', 'data-table', 'app-header'],
+    aiHint: 'Generate a report page with summary stat cards, a detailed data table, and an export button.',
+  },
+};
+
+// ─── PageConfig ───────────────────────────────────────────────────────────────
+
+/**
+ * @typedef {Object} PageConfig
+ * @property {keyof PAGE_TYPES} type       - The page type ID
+ * @property {string}           [title]    - Page title (for app headers)
+ * @property {string}           [collectionId] - Primary data collection for app pages
+ * @property {object}           [stateOverrides] - Custom initial state values
+ * @property {object}           [layoutOverrides] - CSS variable overrides
+ */
+
+/**
+ * Get the `PageTypeConfig` for a given page type ID.
+ * Returns the 'landing' config as a safe fallback.
+ *
+ * @param {string} typeId
+ * @returns {PageTypeConfig}
+ */
+export function getPageTypeConfig(typeId) {
+  return PAGE_TYPES[typeId] || PAGE_TYPES.landing;
+}
+
+/**
+ * Determine whether a page is an app page (requires state + data binding)
+ * or a marketing page (static HTML).
+ *
+ * @param {string} typeId
+ * @returns {boolean}
+ */
+export function isAppPage(typeId) {
+  return PAGE_TYPES[typeId]?.kind === 'app';
+}
+
+/**
+ * Get all page types for a given kind.
+ *
+ * @param {'marketing'|'app'} kind
+ * @returns {PageTypeConfig[]}
+ */
+export function getPageTypesByKind(kind) {
+  return Object.values(PAGE_TYPES).filter((t) => t.kind === kind);
+}
+
+/**
+ * Build the CSS variable string for a page type's layout hints.
+ * Injected into the GrapesJS canvas when the page is loaded.
+ *
+ * @param {string} typeId
+ * @param {object} [overrides] - Additional CSS variable overrides
+ * @returns {string} CSS :root block
+ */
+export function buildLayoutCSS(typeId, overrides = {}) {
+  const config = getPageTypeConfig(typeId);
+  const vars   = { ...config.layoutHints, ...overrides };
+
+  if (Object.keys(vars).length === 0) return '';
+
+  const declarations = Object.entries(vars)
+    .map(([k, v]) => `  ${k}: ${v};`)
+    .join('\n');
+
+  return `:root {\n${declarations}\n}`;
+}
+
+/**
+ * Build a compact AI context string describing all page types.
+ * Injected into AI prompts so the LLM can choose the right page type.
+ *
+ * @returns {string}
+ */
+export function buildPageTypeContext() {
+  const marketing = getPageTypesByKind('marketing');
+  const app       = getPageTypesByKind('app');
+
+  const fmt = (types) => types
+    .map((t) => `  - ${t.id} (${t.icon} ${t.name}): ${t.description}`)
+    .join('\n');
+
+  return `MARKETING PAGES (static, scroll-based):\n${fmt(marketing)}\n\nAPP PAGES (data-driven, require state):\n${fmt(app)}`;
+}
+
+// ─── Page Config Helpers ──────────────────────────────────────────────────────
+
+/**
+ * Create a default PageConfig for a given type.
+ *
+ * @param {string} typeId
+ * @param {Partial<PageConfig>} [overrides]
+ * @returns {PageConfig}
+ */
+export function createPageConfig(typeId, overrides = {}) {
+  const typeConfig = getPageTypeConfig(typeId);
+  return {
+    type:  typeConfig.id,
+    title: overrides.title || typeConfig.name,
+    ...overrides,
+  };
+}
+
+/**
+ * Upgrade an existing page entry (from the pageManager) with a PageConfig.
+ * Used when the user changes a page's type in the editor.
+ *
+ * @param {object} page     - Existing page entry { name, html, css, meta, schema }
+ * @param {string} typeId   - New page type ID
+ * @returns {object}        - Updated page entry with `pageConfig` added
+ */
+export function applyPageType(page, typeId) {
+  return {
+    ...page,
+    pageConfig: createPageConfig(typeId, { title: page.name }),
+  };
+}
