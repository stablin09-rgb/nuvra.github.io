+}
+
+// ─── Helpers ──────────────────────────────────────────────────────────────────
+
+/**
+ * Build the HTML comment header that identifies the file as a Nuvra build.
+ * This is the only editor-related content in the output — it is a comment,
+ * not executable code, and does not affect rendering.
+ *
+ * @param {string}       pageId
+ * @param {string}       pageType
+ * @param {BuildContext} ctx
+ * @returns {string}
+ */
+function _buildComment(pageId, pageType, ctx) {
+  return `<!--
+  Generated by Nuvra Builder
+  Site:     ${_esc(ctx?.siteName || 'Nuvra Site')}
+  Page:     ${_esc(pageId)} (${pageType})
+  Build ID: ${ctx?.buildId || 'unknown'}
+  Built at: ${ctx?.builtAt || new Date().toISOString()}
+  https://github.com/stablin09-rgb/nuvra.github.io
+-->
+`;
+}
+
+/**
+ * Build a canonical URL for a page if a base URL is available in the context.
+ * Returns an empty string if no base URL is configured.
+ *
+ * @param {string}       pageId
+ * @param {BuildContext} ctx
+ * @returns {string}
+ */
+function _getCanonicalUrl(pageId, ctx) {
+  if (!ctx?.baseUrl) return '';
+  const base = ctx.baseUrl.replace(/\/$/, '');
+  const page = ctx.allPages?.find((p) => p.id === pageId);
+  if (!page) return '';
+  return page.isHome ? `${base}/` : `${base}/${page.filename}`;
+}
+
+function _esc(str) {
+  return String(str || '')
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
