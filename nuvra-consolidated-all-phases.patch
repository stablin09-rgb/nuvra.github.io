++        snapshot.collections[id] = {
++          id:     schema.id,
++          name:   schema.name,
++          fields: schema.fields,
++        };
++        snapshot.records[id] = records;
++      } catch {
++        // Skip collections that can't be serialized
++      }
++    }
++  } catch {
++    // dataStore not yet initialized — return empty snapshot
++  }
++
++  return snapshot;
++}
