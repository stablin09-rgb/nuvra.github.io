+    layoutHints: {
+      '--nv-page-max-width': '100%',
+      '--nv-page-padding':   '0',
+    },
+    suggestedComponents: [],
+    aiHint: 'Generate a conversion-focused landing page with a hero, feature highlights, social proof, and a strong CTA.',
+  },
+
+  pricing: {
+    id:          'pricing',
+    name:        'Pricing Page',
+    kind:        'marketing',
+    description: 'A pricing page with plan comparison and CTA.',
+    icon:        '💳',
+    defaultState: {},
+    layoutHints: { '--nv-page-max-width': '100%' },
+    suggestedComponents: [],
+    aiHint: 'Generate a pricing page with 2-3 plans, a feature comparison, and a FAQ section.',
+  },
+
+  blog: {
+    id:          'blog',
+    name:        'Blog / Article',
+    kind:        'marketing',
+    description: 'A blog listing or article page.',
+    icon:        '📝',
+    defaultState: {},
+    layoutHints: { '--nv-page-max-width': '860px', '--nv-page-padding': '0 24px' },
+    suggestedComponents: [],
+    aiHint: 'Generate a blog listing page with a header, post grid, and newsletter signup.',
+  },
+
+  about: {
+    id:          'about',
+    name:        'About Page',
+    kind:        'marketing',
+    description: 'A company or personal about page.',
+    icon:        '👥',
+    defaultState: {},
+    layoutHints: { '--nv-page-max-width': '100%' },
+    suggestedComponents: [],
+    aiHint: 'Generate an about page with a mission statement, team section, and company values.',
+  },
+
+  contact: {
+    id:          'contact',
+    name:        'Contact Page',
+    kind:        'marketing',
+    description: 'A contact page with a form and location details.',
+    icon:        '✉️',
+    defaultState: {},
+    layoutHints: { '--nv-page-max-width': '100%' },
+    suggestedComponents: [],
+    aiHint: 'Generate a contact page with a contact form, email, and office location.',
+  },
+
+  // ── App Pages ──────────────────────────────────────────────────────────────
+
+  dashboard: {
+    id:          'dashboard',
+    name:        'Dashboard',
+    kind:        'app',
+    description: 'An analytics dashboard with KPI stats, charts, and data tables.',
+    icon:        '📊',
+    defaultState: {
+      dateRange:    { default: '7d',   type: 'string',  description: 'Selected date range filter' },
+      refreshing:   { default: false,  type: 'boolean', description: 'Whether data is refreshing' },
+    },
+    layoutHints: {
+      '--nv-page-bg':      '#f5f5f7',
+      '--nv-page-padding': '24px',
