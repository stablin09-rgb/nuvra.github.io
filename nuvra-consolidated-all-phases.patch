+    [/\bcontent\b/,                     3],
+  ],
+  'ecommerce': [
+    [/\bshop\b/,                       10],
+    [/\bstore\b/,                       9],
+    [/\becommerce\b/,                  10],
+    [/\be-commerce\b/,                 10],
+    [/\bproduct[s]?\b/,                 5],
+    [/\bbuy\b/,                         7],
+    [/\bsell\b/,                        7],
+    [/\bcart\b/,                        8],
+    [/\bcheckout\b/,                    8],
+    [/\bmerch\b/,                       7],
+    [/\bclothing\b/,                    6],
+    [/\bfashion\b/,                     6],
+    [/\bfood\b/,                        4],
+    [/\bdelivery\b/,                    4],
+  ],
+  'dashboard': [
+    [/\bdashboard\b/,                  10],
+    [/\banalytics\b/,                   9],
+    [/\bmetrics\b/,                     8],
+    [/\bstats\b/,                       7],
+    [/\badmin\b/,                       8],
+    [/\binternal tool\b/,               9],
+    [/\breport\b/,                      6],
+    [/\bmonitoring\b/,                  7],
+    [/\bkpi\b/,                         8],
+    [/\bdata\b/,                        4],
+  ],
+  'agency': [
+    [/\bagency\b/,                     10],
