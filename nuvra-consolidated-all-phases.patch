++/**
++ * Get a summary of what the build will produce, without actually building.
++ * Used to populate the publish modal before the user confirms.
++ *
++ * @returns {{ pageCount: number, appPageCount: number, marketingPageCount: number, pages: object[] }}
++ */
++export function getBuildSummary() {
++  const { pages } = getSnapshot();
++  const pageIds   = Object.keys(pages);
++
++  let appPageCount       = 0;
++  let marketingPageCount = 0;
++  const pageList         = [];
++
++  for (const pageId of pageIds) {
++    const page     = pages[pageId];
++    const pageType = page?.pageConfig?.type || 'landing';
++    const isApp    = ['dashboard', 'crud-list', 'crud-detail', 'form-page', 'settings', 'profile', 'report'].includes(pageType);
++
++    if (isApp) appPageCount++;
++    else marketingPageCount++;
++
++    pageList.push({
++      id:       pageId,
++      name:     page.name,
++      type:     pageType,
++      isApp,
++      filename: (pageId === 'home' || pageIds.indexOf(pageId) === 0) ? 'index.html' : `${slugify(pageId) || pageId}.html`,
++    });
++  }
++
++  return {
++    pageCount:        pageIds.length,
++    appPageCount,
++    marketingPageCount,
++    pages:            pageList,
++  };
++}
