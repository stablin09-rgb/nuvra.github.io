+.nv-newsletter-input { flex: 1; padding: 12px 16px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; }
+.nv-newsletter-btn { padding: 12px 22px; background: ${accentColor}; color: ${ctaColor}; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; white-space: nowrap; }`,
+    };
+  },
+
+  // ── Pricing Header ────────────────────────────────────────────────────────
+  'pricing-header'({ heading = 'Pricing', subtext = '' }, {}) {
+    return {
+      html: `
+<section class="nv-pricing-header">
+  <div class="nv-pricing-header-inner">
+    <h1 class="nv-pricing-heading">${esc(heading)}</h1>
+    <p class="nv-pricing-sub">${esc(subtext)}</p>
+  </div>
+</section>`,
+      css: `
+.nv-pricing-header { padding: 72px 32px 48px; background: #fff; text-align: center; }
+.nv-pricing-header-inner { max-width: 600px; margin: auto; }
+.nv-pricing-heading { font-size: 48px; font-weight: 800; margin: 0 0 16px; color: #111; }
+.nv-pricing-sub { font-size: 17px; color: #666; margin: 0; }`,
+    };
+  },
+
+  // ── Pricing Grid ──────────────────────────────────────────────────────────
+  'pricing-grid'({ plans = [] }, { accentColor }) {
+    const ctaColor = _contrastColor(accentColor);
+    const cardsHtml = plans.map(({ name = '', price = '', period = '', desc = '', featured = false, cta = 'Get Started', features = [] }) => {
+      const featureList = features.map(f => `<li class="nv-plan-feature">✓ ${esc(f)}</li>`).join('');
+      const featuredClass = featured ? 'nv-plan-featured' : '';
+      const btnStyle = featured
+        ? `background:${accentColor}; color:${ctaColor}; border:none;`
+        : `background:#f5f5f5; color:#333; border:1px solid #ddd;`;
+      return `
+  <div class="nv-plan-card ${featuredClass}">
+    ${featured ? `<div class="nv-plan-badge">Most Popular</div>` : ''}
+    <h3 class="nv-plan-name">${esc(name)}</h3>
+    <div class="nv-plan-price">${esc(price)}${period ? `<span class="nv-plan-period">/${esc(period)}</span>` : ''}</div>
+    <p class="nv-plan-desc">${esc(desc)}</p>
+    <ul class="nv-plan-features">${featureList}</ul>
+    <button class="nv-plan-cta" style="${btnStyle}">${esc(cta)}</button>
+  </div>`;
+    }).join('');
+
+    return {
+      html: `
+<section class="nv-pricing-grid-section">
+  <div class="nv-pricing-grid-inner">
+    <div class="nv-pricing-grid">${cardsHtml}
+    </div>
+  </div>
+</section>`,
+      css: `
+.nv-pricing-grid-section { padding: 0 32px 80px; background: #fff; }
+.nv-pricing-grid-inner { max-width: 1000px; margin: auto; }
+.nv-pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
+.nv-plan-card { padding: 36px 28px; border: 1px solid #eee; border-radius: 14px; position: relative; }
+.nv-plan-featured { border: 2px solid ${accentColor}; background: #faf9ff; }
+.nv-plan-badge { position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: ${accentColor}; color: ${ctaColor}; padding: 4px 16px; border-radius: 20px; font-size: 12px; font-weight: 700; white-space: nowrap; }
+.nv-plan-name { font-size: 18px; font-weight: 700; margin: 0 0 12px; }
+.nv-plan-price { font-size: 44px; font-weight: 800; margin: 0 0 4px; }
+.nv-plan-period { font-size: 16px; font-weight: 400; color: #888; }
+.nv-plan-desc { font-size: 14px; color: #666; margin: 0 0 24px; }
+.nv-plan-features { list-style: none; padding: 0; margin: 0 0 28px; }
+.nv-plan-feature { font-size: 14px; color: #444; padding: 6px 0; border-bottom: 1px solid #f5f5f5; }
+.nv-plan-cta { width: 100%; padding: 13px; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; }`,
+    };
+  },
+
+  // ── FAQ ───────────────────────────────────────────────────────────────────
+  faq({ heading = 'FAQ', items = [] }, { accentColor }) {
+    const itemsHtml = items.map(({ q = '', a = '' }) => `
+  <div class="nv-faq-item">
+    <h3 class="nv-faq-q">${esc(q)}</h3>
+    <p class="nv-faq-a">${esc(a)}</p>
+  </div>`).join('');
+
+    return {
+      html: `
+<section class="nv-faq">
+  <div class="nv-faq-inner">
+    <h2 class="nv-faq-heading">${esc(heading)}</h2>
+    <div class="nv-faq-list">${itemsHtml}
+    </div>
+  </div>
+</section>`,
+      css: `
+.nv-faq { padding: 72px 32px; background: #f9f9f9; }
+.nv-faq-inner { max-width: 720px; margin: auto; }
+.nv-faq-heading { font-size: 36px; font-weight: 700; margin: 0 0 48px; text-align: center; color: #111; }
+.nv-faq-item { padding: 24px 0; border-bottom: 1px solid #eee; }
+.nv-faq-item:last-child { border-bottom: none; }
+.nv-faq-q { font-size: 17px; font-weight: 700; margin: 0 0 10px; color: #111; }
+.nv-faq-a { font-size: 15px; color: #555; line-height: 1.7; margin: 0; }`,
+    };
+  },
+
+};
+
+// ─── Base CSS ─────────────────────────────────────────────────────────────────
+
+/**
+ * Base CSS injected once per rendered page.
+ * Provides a minimal, consistent reset for all Nuvra-generated sections.
+ *
+ * @param {object} settings - Page settings
+ * @returns {string}
+ */
+function _buildBaseCSS({ fontFamily = 'system-ui, -apple-system, sans-serif' }) {
+  return `
+*, *::before, *::after { box-sizing: border-box; }
+body { margin: 0; font-family: ${fontFamily}; }
+h1, h2, h3, h4 { line-height: 1.2; }
+img { max-width: 100%; display: block; }
+button { font-family: inherit; }
+input, textarea { font-family: inherit; }
+`.trim();
+}
+
+// ─── Unknown Section Fallback ─────────────────────────────────────────────────
+
+function _unknownSectionRenderer(type, props) {
+  console.warn(`[Nuvra SchemaRenderer] Unknown section type: "${type}". Rendering placeholder.`);
+  return {
+    html: `
+<div class="nv-unknown-section">
+  <p><strong>Unknown section type:</strong> <code>${esc(type)}</code></p>
+  <p>Add a renderer for this type in <code>src/ai/schemaRenderer.js</code>.</p>
+</div>`,
+    css: `
+.nv-unknown-section { padding: 32px; background: #fff8dc; border: 2px dashed #f59e0b; border-radius: 8px; margin: 16px; font-size: 14px; color: #92400e; }`,
+  };
+}
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * Render a `PageSchema` into HTML and CSS strings for GrapesJS.
+ *
+ * @param {import('./pageSchema.js').PageSchema} schema
+ * @returns {{ html: string, css: string }}
+ * @throws {Error} if the schema is invalid
+ */
+export function renderPageSchema(schema) {
+  if (!isValidPageSchema(schema)) {
+    throw new Error('[SchemaRenderer] Received an invalid PageSchema.');
+  }
+
+  const { settings, sections } = schema;
+  const resolvedSettings = {
+    accentColor: settings.accentColor || '#7c6af7',
+    fontFamily:  settings.fontFamily  || 'system-ui, -apple-system, sans-serif',
+    theme:       settings.theme       || 'light',
+  };
+
+  const htmlParts = [];
+  const cssParts  = [_buildBaseCSS(resolvedSettings)];
+
+  for (const section of sections) {
+    const renderer = SECTION_RENDERERS[section.type];
+
+    const { html, css } = renderer
+      ? renderer(section.props || {}, resolvedSettings)
+      : _unknownSectionRenderer(section.type, section.props);
+
+    htmlParts.push(html.trim());
+    if (css) cssParts.push(css.trim());
+  }
+
+  return {
+    html: htmlParts.join('\n\n'),
+    css:  cssParts.join('\n\n'),
+  };
+}
+
+/**
+ * Return the list of all registered section type names.
+ * Useful for documentation and for constructing AI system prompts.
+ *
+ * @returns {string[]}
+ */
+export function getRegisteredSectionTypes() {
+  return Object.keys(SECTION_RENDERERS);
+}
