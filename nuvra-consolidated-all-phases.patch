+/**
+ * Nuvra Builder — Preview Runtime  (Phase 4)
+ *
+ * This module has two responsibilities:
+ *
+ *  1. `getPreviewRuntimeScript()` — called by `previewRenderer.js` in the
+ *     builder context. Returns the IIFE string to be inlined into the
+ *     preview document's <script> tag.
+ *
+ *  2. The IIFE itself — executes inside the preview iframe. It:
+ *       a. Reads the data snapshot from the embedded JSON script tag
+ *       b. Initialises an in-memory DataStore from that snapshot
+ *       c. Initialises a lightweight StateManager
+ *       d. Scans the DOM for data-nv-* attributes
+ *       e. Hydrates all components (tables, forms, lists, stats)
+ *       f. Wires all actions (submit, delete, fetch, etc.)
+ *       g. Wires all state bindings (data-nv-bind, data-nv-show-when)
+ *
+ * Design decisions:
+ *  - The IIFE is intentionally self-contained. It does not import any
+ *    external modules. All required logic is inlined.
+ *  - The DataStore and StateManager inside the iframe are fresh instances
+ *    seeded from the snapshot. Changes made in preview do NOT propagate
+ *    back to the builder. Preview is a sandboxed execution environment.
+ *  - The runtime uses the same data-nv-* attribute contract as the
+ *    AppRuntime (Phase 3), so components built in the editor work
+ *    identically in preview.
+ *  - Toast notifications are rendered inside the iframe using a local
+ *    container, not the builder's toast system.
+ */
+
+'use strict';
+
+/**
+ * Returns the complete PreviewRuntime as an IIFE string.
+ * This string is inlined into the preview document's <script> tag.
+ *
+ * @returns {string}
+ */
+export function getPreviewRuntimeScript() {
+  return `(${_previewRuntimeIIFE.toString()})();`;
+}
+
+// ─── The IIFE ─────────────────────────────────────────────────────────────────
+// This function is serialized via .toString() and inlined into the iframe.
+// It must be completely self-contained — no imports, no external references.
+
+/* eslint-disable */
+function _previewRuntimeIIFE() {
+  'use strict';
+
+  // ── 1. Read embedded data & context ─────────────────────────────────────────
+
+  let _dataSnapshot = { collections: {}, records: {} };
+  let _pageContext   = { pageId: 'preview', pageType: 'dashboard' };
+
+  try {
+    const snapEl = document.getElementById('nv-data-snapshot');
+    if (snapEl) _dataSnapshot = JSON.parse(snapEl.textContent);
+  } catch (e) { console.warn('[NvRuntime] Could not parse data snapshot:', e); }
+
+  try {
+    const ctxEl = document.getElementById('nv-page-context');
+    if (ctxEl) _pageContext = JSON.parse(ctxEl.textContent);
+  } catch (e) { console.warn('[NvRuntime] Could not parse page context:', e); }
+
+  const PAGE_ID = _pageContext.pageId;
+
+  // ── 2. In-memory DataStore ───────────────────────────────────────────────────
+
+  const _store = {
+    collections: {},  // { [id]: { id, name, fields } }
+    records:     {},  // { [collectionId]: Record[] }
+  };
+
+  // Seed from snapshot
+  Object.assign(_store.collections, _dataSnapshot.collections);
+  Object.entries(_dataSnapshot.records).forEach(([id, recs]) => {
+    _store.records[id] = recs.map(r => Object.assign({}, r));
+  });
+
+  function _getCollection(id) {
+    if (!_store.collections[id]) throw new Error('Collection not found: ' + id);
+    return _store.collections[id];
+  }
+
+  function _query(collectionId, opts) {
+    const recs = (_store.records[collectionId] || []).slice();
+    if (!opts) return recs;
+    if (opts.sortBy) {
+      recs.sort((a, b) => {
+        const av = a[opts.sortBy], bv = b[opts.sortBy];
+        const cmp = av < bv ? -1 : av > bv ? 1 : 0;
+        return opts.sortDir === 'desc' ? -cmp : cmp;
+      });
+    }
+    return recs;
+  }
+
+  function _getById(collectionId, id) {
+    return (_store.records[collectionId] || []).find(r => r._id === id) || null;
+  }
+
+  function _create(collectionId, data) {
+    if (!_store.records[collectionId]) _store.records[collectionId] = [];
+    const record = Object.assign({ _id: _uid(), _createdAt: new Date().toISOString() }, data);
+    _store.records[collectionId].push(record);
+    return record;
+  }
+
+  function _update(collectionId, id, data) {
+    const idx = (_store.records[collectionId] || []).findIndex(r => r._id === id);
+    if (idx === -1) throw new Error('Record not found: ' + id);
+    _store.records[collectionId][idx] = Object.assign({}, _store.records[collectionId][idx], data);
+    return _store.records[collectionId][idx];
+  }
+
+  function _deleteRecord(collectionId, id) {
+    const arr = _store.records[collectionId] || [];
+    const idx = arr.findIndex(r => r._id === id);
+    if (idx === -1) return false;
+    arr.splice(idx, 1);
+    return true;
+  }
+
+  function _uid() {
+    return Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
+  }
+
+  // ── 3. Reactive State ────────────────────────────────────────────────────────
+
+  function _createStateNode(initial) {
+    const _data = Object.assign({}, initial);
+    const _subs = {};  // { key: Set<fn> }
+
+    return {
+      get(key) { return _data[key]; },
+      set(key, val) {
+        _data[key] = val;
+        (_subs[key] || new Set()).forEach(fn => fn(val));
+      },
+      patch(obj) { Object.entries(obj).forEach(([k, v]) => this.set(k, v)); },
+      subscribe(key, fn) {
+        if (!_subs[key]) _subs[key] = new Set();
+        _subs[key].add(fn);
+        return () => _subs[key].delete(fn);
+      },
+    };
+  }
+
+  // App-level state (shared across all pages in this preview session)
+  const _appState = _createStateNode({});
+
+  // Page-level state
+  const _pageStates = {};
+  function _getPageState(pageId) {
+    if (!_pageStates[pageId]) _pageStates[pageId] = _createStateNode({
+      currentPage: 1,
+      searchQuery: '',
+      sortBy:      null,
+      sortDir:     'asc',
+      selectedId:  null,
+      isLoading:   false,
+      errorMessage: null,
+    });
+    return _pageStates[pageId];
+  }
+
+  // ── 4. Toast (in-preview) ────────────────────────────────────────────────────
+
+  function _showToast(message, type, duration) {
+    type     = type     || 'info';
+    duration = duration || 3000;
+
+    let container = document.getElementById('nv-preview-toast-container');
+    if (!container) {
+      container = document.createElement('div');
+      container.id = 'nv-preview-toast-container';
+      document.body.appendChild(container);
+    }
+
+    const toast = document.createElement('div');
+    toast.className = 'nv-preview-toast ' + type;
+    toast.textContent = message;
+    container.appendChild(toast);
+
+    setTimeout(function() {
+      toast.style.opacity = '0';
+      toast.style.transition = 'opacity 0.3s ease';
+      setTimeout(function() { toast.remove(); }, 300);
+    }, duration);
+  }
+
+  // ── 5. Component Hydration ───────────────────────────────────────────────────
+
+  function _hydrateAll() {
+    document.querySelectorAll('[data-nv-component]').forEach(function(el) {
+      var cid = el.dataset.nvComponent;
+      var iid = el.dataset.nvInstance || (cid + '-' + _uid());
+      el.dataset.nvInstance = iid;
+
+      switch (cid) {
+        case 'data-table':  _hydrateTable(el);  break;
+        case 'data-list':   _hydrateList(el);   break;
+        case 'data-form':   _hydrateForm(el);   break;
+        case 'data-detail': _hydrateDetail(el); break;
+        case 'stat-display':_hydrateStat(el);   break;
+        case 'show-if':     _hydrateShowIf(el); break;
+        case 'loading-gate':_hydrateLoadingGate(el); break;
+      }
+    });
+  }
+
+  // ── Table ────────────────────────────────────────────────────────────────────
+
+  function _hydrateTable(el) {
+    var collectionId = el.dataset.nvCollection;
+    if (!collectionId) return;
+
+    var schema;
+    try { schema = _getCollection(collectionId); }
+    catch(e) {
+      var tbody = el.querySelector('.nv-table-body');
+      if (tbody) tbody.innerHTML = '<tr><td class="nv-td" colspan="99" style="text-align:center;color:#9ca3af;">Collection "' + collectionId + '" not found.</td></tr>';
+      return;
+    }
+
+    var ps = _getPageState(PAGE_ID);
+
+    // Build column headers
+    var thead = el.querySelector('.nv-table-head tr');
+    if (thead) {
+      thead.innerHTML = '';
+      Object.entries(schema.fields).forEach(function(entry) {
+        var fieldId = entry[0], field = entry[1];
+        var th = document.createElement('th');
+        th.className = 'nv-th';
+        th.textContent = field.label || fieldId;
+        th.addEventListener('click', function() {
+          var cur = ps.get('sortBy');
+          var dir = (cur === fieldId && ps.get('sortDir') === 'asc') ? 'desc' : 'asc';
+          ps.patch({ sortBy: fieldId, sortDir: dir });
+          _renderTableRows(el, collectionId, schema, ps);
+        });
+        thead.appendChild(th);
+      });
+      var thAct = document.createElement('th');
+      thAct.className = 'nv-th';
+      thead.appendChild(thAct);
+    }
+
+    _renderTableRows(el, collectionId, schema, ps);
+
+    ps.subscribe('searchQuery', function() { _renderTableRows(el, collectionId, schema, ps); });
+    ps.subscribe('currentPage', function() { _renderTableRows(el, collectionId, schema, ps); });
+    ps.subscribe('sortBy',      function() { _renderTableRows(el, collectionId, schema, ps); });
+
+    var searchInput = el.querySelector('.nv-search-input');
+    if (searchInput) {
+      searchInput.addEventListener('input', function(e) { ps.set('searchQuery', e.target.value); });
+    }
+
+    el.querySelector('[data-nv-action="prev-page"]') && el.querySelector('[data-nv-action="prev-page"]').addEventListener('click', function() {
+      var cur = ps.get('currentPage') || 1;
+      if (cur > 1) ps.set('currentPage', cur - 1);
+    });
+    el.querySelector('[data-nv-action="next-page"]') && el.querySelector('[data-nv-action="next-page"]').addEventListener('click', function() {
+      var cur = ps.get('currentPage') || 1;
+      var recs = _query(collectionId);
+      var pageSize = parseInt(el.dataset.nvPageSize) || 10;
+      var total = Math.ceil(recs.length / pageSize);
+      if (cur < total) ps.set('currentPage', cur + 1);
+    });
+  }
+
+  function _renderTableRows(el, collectionId, schema, ps) {
+    var tbody = el.querySelector('.nv-table-body');
+    if (!tbody) return;
+
+    var searchQuery = (ps.get('searchQuery') || '').toLowerCase();
+    var sortBy      = ps.get('sortBy');
+    var sortDir     = ps.get('sortDir') || 'asc';
+    var curPage     = ps.get('currentPage') || 1;
+    var pageSize    = parseInt(el.dataset.nvPageSize) || 10;
+
+    var records = _query(collectionId, { sortBy: sortBy, sortDir: sortDir });
+
+    if (searchQuery) {
+      records = records.filter(function(rec) {
+        return Object.values(rec).some(function(v) { return String(v).toLowerCase().includes(searchQuery); });
+      });
+    }
+
+    var countEl = el.querySelector('.nv-table-count');
+    if (countEl) countEl.textContent = records.length + ' record' + (records.length !== 1 ? 's' : '');
+
+    var totalPages = Math.max(1, Math.ceil(records.length / pageSize));
+    var page       = Math.min(curPage, totalPages);
+    var start      = (page - 1) * pageSize;
+    var pageRecs   = records.slice(start, start + pageSize);
+
+    var pageInd = el.querySelector('.nv-page-indicator');
+    if (pageInd) pageInd.textContent = page + ' / ' + totalPages;
+
+    if (pageRecs.length === 0) {
+      tbody.innerHTML = '<tr><td class="nv-td" colspan="99" style="text-align:center;color:#9ca3af;">' + (el.dataset.nvEmptyMessage || 'No records found.') + '</td></tr>';
+      return;
+    }
+
+    var fieldIds = Object.keys(schema.fields);
+    tbody.innerHTML = pageRecs.map(function(rec) {
+      var cells = fieldIds.map(function(fid) {
+        return '<td class="nv-td">' + _formatCell(rec[fid], schema.fields[fid]) + '</td>';
+      }).join('');
+      return '<tr class="nv-tr" data-nv-record-id="' + rec._id + '">' + cells +
+        '<td class="nv-td" style="white-space:nowrap;">' +
+        '<button class="nv-btn sm" data-nv-action="edit" data-nv-record-id="' + rec._id + '">Edit</button>' +
+        '<button class="nv-btn sm danger" data-nv-action="delete" data-nv-record-id="' + rec._id + '" style="margin-left:4px;">Del</button>' +
+        '</td></tr>';
+    }).join('');
+
+    tbody.querySelectorAll('[data-nv-action]').forEach(function(btn) {
+      btn.addEventListener('click', function(e) {
+        e.stopPropagation();
+        var actionId = btn.dataset.nvAction;
+        var recordId = btn.dataset.nvRecordId || (btn.closest('[data-nv-record-id]') && btn.closest('[data-nv-record-id]').dataset.nvRecordId);
+        if (actionId === 'delete' && recordId) {
+          if (confirm('Delete this record?')) {
+            _deleteRecord(collectionId, recordId);
+            _renderTableRows(el, collectionId, schema, ps);
+            _showToast('Record deleted.', 'success');
+          }
+        } else if (actionId === 'edit' && recordId) {
+          ps.set('selectedId', recordId);
+          _showToast('Record selected for editing.', 'info');
+        }
+      });
+    });
+  }
+
+  // ── List ─────────────────────────────────────────────────────────────────────
+
+  function _hydrateList(el) {
+    var collectionId   = el.dataset.nvCollection;
+    if (!collectionId) return;
+
+    var schema;
+    try { schema = _getCollection(collectionId); } catch(e) { return; }
+
+    var displayField   = el.dataset.nvDisplayField   || 'name';
+    var secondaryField = el.dataset.nvSecondaryField || '';
+    var badgeField     = el.dataset.nvBadgeField     || '';
+
+    _renderListItems(el, collectionId, schema, displayField, secondaryField, badgeField);
+
+    el.querySelector('[data-nv-action="add"]') && el.querySelector('[data-nv-action="add"]').addEventListener('click', function() {
+      _showToast('Add functionality requires a form component.', 'info');
+    });
+  }
+
+  function _renderListItems(el, collectionId, schema, displayField, secondaryField, badgeField) {
+    var body = el.querySelector('.nv-list-body');
+    if (!body) return;
+
+    var records  = _query(collectionId);
+    var emptyMsg = el.dataset.nvEmptyMessage || 'No items yet.';
+
+    if (records.length === 0) {
+      body.innerHTML = '<div class="nv-list-placeholder">' + emptyMsg + '</div>';
+      return;
+    }
+
+    var ps = _getPageState(PAGE_ID);
+
+    body.innerHTML = records.map(function(rec) {
+      var primary   = rec[displayField]   || rec.name || rec._id;
+      var secondary = secondaryField ? rec[secondaryField] : '';
+      var badge     = badgeField     ? rec[badgeField]     : '';
+      return '<div class="nv-list-item" data-nv-record-id="' + rec._id + '">' +
+        '<div>' +
+        '<div class="nv-list-item-primary">' + _esc(String(primary)) + '</div>' +
+        (secondary ? '<div class="nv-list-item-secondary">' + _esc(String(secondary)) + '</div>' : '') +
+        '</div>' +
+        (badge ? '<span class="nv-badge nv-badge-neutral">' + _esc(String(badge)) + '</span>' : '') +
+        '</div>';
+    }).join('');
+
+    body.querySelectorAll('.nv-list-item').forEach(function(item) {
+      item.addEventListener('click', function() {
+        var recordId = item.dataset.nvRecordId;
+        ps.set('selectedId', recordId);
+        body.querySelectorAll('.nv-list-item').forEach(function(i) { i.classList.remove('selected'); });
+        item.classList.add('selected');
+      });
+    });
+  }
+
+  // ── Form ─────────────────────────────────────────────────────────────────────
+
+  function _hydrateForm(el) {
+    var collectionId = el.dataset.nvCollection;
+    if (!collectionId) return;
+
+    var schema;
+    try { schema = _getCollection(collectionId); } catch(e) { return; }
+
+    var fieldsContainer = el.querySelector('.nv-form-fields');
+    if (!fieldsContainer) return;
+
+    fieldsContainer.innerHTML = '';
+
+    Object.entries(schema.fields).forEach(function(entry) {
+      var fieldId = entry[0], field = entry[1];
+      var wrapper = document.createElement('div');
+      wrapper.className = 'nv-form-field';
+
+      var label = document.createElement('label');
+      label.className = 'nv-form-label';
+      label.textContent = (field.label || fieldId) + (field.required ? ' *' : '');
+
+      var input = _buildInput(fieldId, field);
+      wrapper.appendChild(label);
+      wrapper.appendChild(input);
+      fieldsContainer.appendChild(wrapper);
+    });
+
+    var submitBtn = el.querySelector('[data-nv-action="submit"]');
+    if (submitBtn) {
+      submitBtn.addEventListener('click', function() {
+        var data = {};
+        el.querySelectorAll('[data-nv-field]').forEach(function(inp) {
+          var fid = inp.dataset.nvField;
+          data[fid] = inp.type === 'checkbox' ? inp.checked : inp.value;
+        });
+
+        var errorEl   = el.querySelector('.nv-form-error');
+        var successEl = el.querySelector('.nv-form-success');
+
+        try {
+          var mode = el.dataset.nvMode || 'create';
+          var ps   = _getPageState(PAGE_ID);
+
+          if (mode === 'update' && ps.get('selectedId')) {
+            _update(collectionId, ps.get('selectedId'), data);
+            _showToast('Record updated.', 'success');
+          } else {
+            _create(collectionId, data);
+            _showToast('Record created.', 'success');
+            // Reset form
+            el.querySelectorAll('[data-nv-field]').forEach(function(inp) {
+              if (inp.type === 'checkbox') inp.checked = false;
+              else inp.value = '';
+            });
+          }
+
+          if (successEl) { successEl.textContent = 'Saved successfully.'; successEl.style.display = ''; }
+          if (errorEl)   { errorEl.style.display = 'none'; }
+
+          // Re-render any tables on the page
+          document.querySelectorAll('[data-nv-component="data-table"][data-nv-collection="' + collectionId + '"]').forEach(function(tableEl) {
+            var tSchema;
+            try { tSchema = _getCollection(collectionId); } catch(e) { return; }
+            _renderTableRows(tableEl, collectionId, tSchema, _getPageState(PAGE_ID));
+          });
+          document.querySelectorAll('[data-nv-component="data-list"][data-nv-collection="' + collectionId + '"]').forEach(function(listEl) {
+            var lSchema;
+            try { lSchema = _getCollection(collectionId); } catch(e) { return; }
+            _renderListItems(listEl, collectionId, lSchema,
+              listEl.dataset.nvDisplayField || 'name',
+              listEl.dataset.nvSecondaryField || '',
+              listEl.dataset.nvBadgeField || '');
+          });
+          // Re-render stat cards
+          document.querySelectorAll('[data-nv-component="stat-display"][data-nv-collection="' + collectionId + '"]').forEach(function(statEl) {
+            _hydrateStat(statEl);
+          });
+
+        } catch(err) {
+          if (errorEl) { errorEl.textContent = err.message; errorEl.style.display = ''; }
+          if (successEl) { successEl.style.display = 'none'; }
+          _showToast(err.message, 'error');
+        }
+      });
+    }
+
+    var resetBtn = el.querySelector('[data-nv-action="reset"]');
+    if (resetBtn) {
+      resetBtn.addEventListener('click', function() {
+        el.querySelectorAll('[data-nv-field]').forEach(function(inp) {
+          if (inp.type === 'checkbox') inp.checked = false;
+          else inp.value = '';
+        });
+      });
+    }
+
+    // Populate form when selectedId changes (update mode)
+    var ps = _getPageState(PAGE_ID);
+    ps.subscribe('selectedId', function(recordId) {
+      if (!recordId || el.dataset.nvMode !== 'update') return;
+      var record = _getById(collectionId, recordId);
+      if (!record) return;
+      el.querySelectorAll('[data-nv-field]').forEach(function(inp) {
+        var fid = inp.dataset.nvField;
+        if (inp.type === 'checkbox') inp.checked = Boolean(record[fid]);
+        else inp.value = record[fid] != null ? record[fid] : '';
+      });
+    });
+  }
+
+  function _buildInput(fieldId, field) {
+    var input;
+    if (field.type === 'boolean') {
+      input = document.createElement('input');
+      input.type = 'checkbox';
+      input.className = 'nv-form-checkbox';
+    } else if (field.type === 'select' && field.options) {
+      input = document.createElement('select');
+      input.className = 'nv-form-input';
+      field.options.forEach(function(opt) {
+        var o = document.createElement('option');
+        o.value = o.textContent = opt;
+        input.appendChild(o);
+      });
+    } else {
+      input = document.createElement('input');
+      input.className = 'nv-form-input';
+      input.type = field.type === 'email' ? 'email' : field.type === 'number' ? 'number' : field.type === 'date' ? 'date' : field.type === 'url' ? 'url' : 'text';
+      if (field.required) input.required = true;
+    }
+    input.dataset.nvField = fieldId;
+    input.name = fieldId;
+    return input;
+  }
+
+  // ── Detail View ──────────────────────────────────────────────────────────────
+
+  function _hydrateDetail(el) {
+    var collectionId = el.dataset.nvCollection;
+    if (!collectionId) return;
+
+    var schema;
+    try { schema = _getCollection(collectionId); } catch(e) { return; }
+
+    var ps = _getPageState(PAGE_ID);
+
+    function _render(recordId) {
+      var body = el.querySelector('.nv-detail-body');
+      if (!body) return;
+
+      if (!recordId) {
+        body.innerHTML = '<div class="nv-detail-placeholder">' + (el.dataset.nvEmptyMessage || 'Select a record to view details.') + '</div>';
+        return;
+      }
+
+      var record = _getById(collectionId, recordId);
+      if (!record) { body.innerHTML = '<div class="nv-detail-placeholder">Record not found.</div>'; return; }
+
+      body.innerHTML = Object.entries(schema.fields).map(function(entry) {
+        var fieldId = entry[0], field = entry[1];
+        return '<div class="nv-detail-field">' +
+          '<div class="nv-detail-field-label">' + _esc(field.label || fieldId) + '</div>' +
+          '<div class="nv-detail-field-value">' + _formatCell(record[fieldId], field) + '</div>' +
+          '</div>';
+      }).join('');
+    }
+
+    _render(ps.get('selectedId'));
+    ps.subscribe('selectedId', _render);
+
+    var editBtn = el.querySelector('[data-nv-action="edit"]');
+    if (editBtn) {
+      editBtn.addEventListener('click', function() {
+        var id = ps.get('selectedId');
+        if (!id) { _showToast('Select a record first.', 'error'); return; }
+        _showToast('Edit mode: update the form and submit.', 'info');
+      });
+    }
+
+    var deleteBtn = el.querySelector('[data-nv-action="delete"]');
+    if (deleteBtn) {
+      deleteBtn.addEventListener('click', function() {
+        var id = ps.get('selectedId');
+        if (!id) { _showToast('Select a record first.', 'error'); return; }
+        if (confirm('Delete this record?')) {
+          _deleteRecord(collectionId, id);
+          ps.set('selectedId', null);
+          _showToast('Record deleted.', 'success');
+        }
+      });
+    }
+  }
+
+  // ── Stat Card ────────────────────────────────────────────────────────────────
+
+  function _hydrateStat(el) {
+    var collectionId = el.dataset.nvCollection;
+    var aggregation  = el.dataset.nvAggregation || 'count';
+    var field        = el.dataset.nvField || null;
+    var prefix       = el.dataset.nvPrefix || '';
+    var suffix       = el.dataset.nvSuffix || '';
+
+    if (!collectionId) return;
+
+    var value;
+    try {
+      var records = _query(collectionId);
+      switch (aggregation) {
+        case 'count': value = records.length; break;
+        case 'sum':   value = records.reduce(function(s,r) { return s + (Number(r[field])||0); }, 0); break;
+        case 'avg':   value = records.length ? records.reduce(function(s,r) { return s + (Number(r[field])||0); }, 0) / records.length : 0; break;
+        case 'min':   value = Math.min.apply(null, records.map(function(r) { return Number(r[field])||0; })); break;
+        case 'max':   value = Math.max.apply(null, records.map(function(r) { return Number(r[field])||0; })); break;
+        default:      value = records.length;
+      }
+    } catch(e) { value = '—'; }
+
+    var valueEl = el.querySelector('.nv-stat-value');
+    if (valueEl) {
+      var formatted = typeof value === 'number' ? value.toLocaleString() : value;
+      valueEl.textContent = prefix + formatted + suffix;
+    }
+  }
+
+  // ── Show-If ──────────────────────────────────────────────────────────────────
+
+  function _hydrateShowIf(el) {
+    var stateKey  = el.dataset.nvStateKey;
+    var condition = el.dataset.nvCondition || 'truthy';
+    var value     = el.dataset.nvValue     || '';
+    var scope     = el.dataset.nvScope     || 'page';
+
+    if (!stateKey) return;
+
+    var stateNode = scope === 'app' ? _appState : _getPageState(PAGE_ID);
+
+    function _eval(val) {
+      switch (condition) {
+        case 'truthy':     return Boolean(val);
+        case 'falsy':      return !val;
+        case 'equals':     return String(val) === value;
+        case 'not-equals': return String(val) !== value;
+        case 'gt':         return Number(val) > Number(value);
+        case 'lt':         return Number(val) < Number(value);
+        default:           return Boolean(val);
+      }
+    }
+
+    var placeholder = el.querySelector('.nv-logic-placeholder');
+    if (placeholder) placeholder.style.display = 'none';
+
+    function _update(val) {
+      var show = _eval(val);
+      el.style.display = show ? '' : 'none';
+    }
+
+    _update(stateNode.get(stateKey));
+    stateNode.subscribe(stateKey, _update);
+  }
+
+  // ── Loading Gate ─────────────────────────────────────────────────────────────
+
+  function _hydrateLoadingGate(el) {
+    var stateKey  = el.dataset.nvStateKey || 'isLoading';
+    var scope     = el.dataset.nvScope    || 'page';
+    var stateNode = scope === 'app' ? _appState : _getPageState(PAGE_ID);
+
+    var spinnerEl = el.querySelector('.nv-loading-spinner');
+    var contentEl = el.querySelector('.nv-loading-content');
+
+    function _update(isLoading) {
+      if (spinnerEl) spinnerEl.style.display = isLoading ? 'flex' : 'none';
+      if (contentEl) contentEl.style.display = isLoading ? 'none' : '';
+    }
+
+    _update(stateNode.get(stateKey));
+    stateNode.subscribe(stateKey, _update);
+  }
+
+  // ── 6. State Bindings ────────────────────────────────────────────────────────
+
+  function _wireStateBindings() {
+    var ps = _getPageState(PAGE_ID);
+
+    document.querySelectorAll('[data-nv-bind]').forEach(function(el) {
+      var key = el.dataset.nvBind;
+      function _update(val) {
+        if (val == null) return;
+        el.textContent = typeof val === 'object' ? JSON.stringify(val) : String(val);
+      }
+      _update(ps.get(key));
+      ps.subscribe(key, _update);
+    });
+
+    document.querySelectorAll('[data-nv-bind-write]').forEach(function(el) {
+      var key = el.dataset.nvBindWrite;
+      el.addEventListener('input', function(e) { ps.set(key, e.target.value); });
+    });
+  }
+
+  // ── 7. Top-level Action Wiring ───────────────────────────────────────────────
+
+  function _wireTopLevelActions() {
+    document.querySelectorAll('[data-nv-action]:not([data-nv-component] [data-nv-action])').forEach(function(el) {
+      var actionId = el.dataset.nvAction;
+      el.addEventListener('click', function(e) {
+        switch (actionId) {
+          case 'show-toast':
+            _showToast(el.dataset.nvConfigMessage || 'Action triggered.', el.dataset.nvConfigType || 'info');
+            break;
+          case 'navigate':
+            var href = el.dataset.nvConfigHref;
+            if (href) window.location.href = href;
+            break;
+          case 'toggle-state': {
+            var key = el.dataset.nvConfigKey;
+            var ps  = _getPageState(PAGE_ID);
+            if (key) ps.set(key, !ps.get(key));
+            break;
+          }
+          case 'set-state': {
+            var k = el.dataset.nvConfigKey;
+            var v = el.dataset.nvConfigValue;
+            if (k) _getPageState(PAGE_ID).set(k, v);
+            break;
+          }
+          default:
+            break;
+        }
+      });
+    });
+  }
+
+  // ── 8. Helpers ───────────────────────────────────────────────────────────────
+
+  function _formatCell(value, field) {
+    if (value == null) return '<span style="color:#d1d5db;">—</span>';
+    if (field && field.type === 'boolean') {
+      return value
+        ? '<span class="nv-badge nv-badge-success">Yes</span>'
+        : '<span class="nv-badge nv-badge-neutral">No</span>';
+    }
+    if (field && field.type === 'select') {
+      var colorMap = { 'Active':'success','Published':'success','Delivered':'success','In Stock':'success','Pending':'warning','Processing':'warning','Lead':'info','Cancelled':'danger','Churned':'danger' };
+      var color = colorMap[value] || 'neutral';
+      return '<span class="nv-badge nv-badge-' + color + '">' + _esc(String(value)) + '</span>';
+    }
+    return _esc(String(value));
+  }
+
+  function _esc(str) {
+    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
+  }
+
+  // ── 9. Boot ──────────────────────────────────────────────────────────────────
+
+  function _boot() {
+    _hydrateAll();
+    _wireStateBindings();
+    _wireTopLevelActions();
+    console.info('[NvRuntime] Preview runtime booted for page "' + PAGE_ID + '"');
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', _boot);
+  } else {
+    _boot();
+  }
+}
