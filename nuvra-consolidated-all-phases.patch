index 0000000..bea79cf
--- /dev/null
+++ b/src/ai/aiSettings.js
@@ -0,0 +1,341 @@
+/**
+ * Nuvra Builder — AI Settings Panel  (Phase 5A)
+ *
+ * Renders a modal UI for configuring the AI provider, API key, model, and
+ * advanced options. Settings are persisted to localStorage under 'nuvra-ai-config'.
+ *
+ * Supports:
+ *  - Mock (offline, no key required)
+ *  - OpenAI (GPT-4o, GPT-4o-mini, GPT-4-turbo, GPT-3.5-turbo)
+ *  - Anthropic (Claude 3 Haiku, Sonnet, Opus; Claude 3.5 Haiku, Sonnet)
+ *  - Local LLM (Ollama, LM Studio, LocalAI — any OpenAI-compatible endpoint)
+ *
+ * Security note:
+ *  API keys are stored in localStorage only. They are sent directly from the
+ *  user's browser to the respective AI provider. Nuvra never receives them.
+ */
+
+'use strict';
+
+import { configureAI,
+         getActiveProviderName,
+         getActiveProviderId,
+         getSessionUsage }         from './aiEngine.js';
+import { detectLocalModels,
+         pingLocalServer }         from './providers/localProvider.js';
+import { showToast }               from '../utils/helpers.js';
+
+const SETTINGS_KEY = 'nuvra-ai-config';
+
+// ─── Provider Definitions ─────────────────────────────────────────────────────
+
+const PROVIDERS = {
+  mock: {
+    label:   'Mock (Offline — no API key needed)',
+    models:  ['mock-v2'],
+    hasKey:  false,
+    hasUrl:  false,
+  },
+  openai: {
+    label:   'OpenAI (GPT-4o, GPT-4o-mini)',
+    models:  ['gpt-4o-mini', 'gpt-4o', 'gpt-4-turbo', 'gpt-3.5-turbo'],
+    hasKey:  true,
+    hasUrl:  false,
+    keyHint: 'sk-…',
+    keyLink: 'https://platform.openai.com/api-keys',
+  },
+  anthropic: {
+    label:   'Anthropic (Claude 3 / 3.5)',
+    models:  [
+      'claude-3-haiku-20240307',
+      'claude-3-5-haiku-20241022',
+      'claude-3-sonnet-20240229',
+      'claude-3-5-sonnet-20241022',
+      'claude-3-opus-20240229',
+    ],
+    hasKey:  true,
+    hasUrl:  false,
+    keyHint: 'sk-ant-…',
+    keyLink: 'https://console.anthropic.com/settings/keys',
+  },
+  local: {
+    label:   'Local LLM (Ollama / LM Studio)',
+    models:  ['llama3', 'mistral', 'phi3', 'gemma2', 'mixtral', 'qwen2'],
+    hasKey:  false,
+    hasUrl:  true,
+    urlHint: 'http://localhost:11434/v1',
+  },
+};
+
+// ─── Load / Save Settings ─────────────────────────────────────────────────────
+
+export function loadAISettings() {
+  try {
+    const raw = localStorage.getItem(SETTINGS_KEY);
+    return raw ? JSON.parse(raw) : _defaultSettings();
+  } catch {
+    return _defaultSettings();
+  }
+}
+
+function _defaultSettings() {
+  return { provider: 'mock', apiKey: '', model: '', baseUrl: '' };
+}
+
+function saveAISettings(settings) {
+  localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
+}
+
+// ─── Init ─────────────────────────────────────────────────────────────────────
+
+/**
+ * Load saved AI settings and configure the engine on startup.
+ */
+export function initAI() {
+  const settings = loadAISettings();
+  configureAI(settings);
+}
+
+// ─── Settings Modal ───────────────────────────────────────────────────────────
+
+/**
+ * Open the AI settings modal.
+ */
+export function openAISettings() {
+  const current = loadAISettings();
+
+  // Remove any existing modal
+  document.getElementById('nuvra-ai-settings-overlay')?.remove();
+
+  const overlay = document.createElement('div');
+  overlay.id        = 'nuvra-ai-settings-overlay';
+  overlay.className = 'nuvra-modal-overlay';
+
+  overlay.innerHTML = _buildModalHTML(current);
+  document.body.appendChild(overlay);
+
+  _bindModalEvents(overlay, current);
+}
+
+// ─── Modal HTML Builder ───────────────────────────────────────────────────────
+
+function _buildModalHTML(current) {
+  const providerOptions = Object.entries(PROVIDERS)
+    .map(([id, p]) =>
+      `<option value="${id}" ${current.provider === id ? 'selected' : ''}>${p.label}</option>`
+    ).join('');
+
+  const usage = getSessionUsage();
+
+  return `
+    <div class="nuvra-modal ai-settings-modal">
+      <div class="nuvra-modal-header">
+        <h3>AI Engine Settings</h3>
+        <button class="nuvra-modal-close" id="ai-settings-close" title="Close">✕</button>
+      </div>
+
+      <div class="ai-settings-body">
+
+        <!-- Provider Selection -->
+        <div class="ai-settings-section">
+          <label class="ai-settings-label">AI Provider</label>
+          <select id="ai-provider-select" class="nuvra-select">
+            ${providerOptions}
+          </select>
+        </div>
+
+        <!-- API Key (shown for OpenAI and Anthropic) -->
+        <div id="ai-key-section" class="ai-settings-section" style="${!PROVIDERS[current.provider]?.hasKey ? 'display:none' : ''}">
+          <label class="ai-settings-label">
+            API Key
+            <a id="ai-key-link" href="${PROVIDERS[current.provider]?.keyLink || '#'}" target="_blank" rel="noopener" class="ai-settings-link">Get a key ↗</a>
+          </label>
+          <input type="password" id="ai-api-key" class="nuvra-input" placeholder="${PROVIDERS[current.provider]?.keyHint || 'Enter API key'}" value="${current.apiKey || ''}" autocomplete="off" />
+          <p class="ai-settings-note">
+            Your key is stored locally in your browser only. Nuvra never receives or stores it.
+          </p>
+        </div>
+
+        <!-- Base URL (shown for Local LLM) -->
+        <div id="ai-url-section" class="ai-settings-section" style="${!PROVIDERS[current.provider]?.hasUrl ? 'display:none' : ''}">
+          <label class="ai-settings-label">Local Server URL</label>
+          <div class="ai-settings-row">
+            <input type="text" id="ai-base-url" class="nuvra-input" placeholder="${PROVIDERS['local'].urlHint}" value="${current.baseUrl || ''}" />
+            <button class="nuvra-btn" id="ai-ping-server" title="Test connection">Test</button>
+          </div>
+          <p class="ai-settings-note" id="ai-ping-result"></p>
+        </div>
+
+        <!-- Model Selection -->
+        <div class="ai-settings-section">
+          <label class="ai-settings-label">Model</label>
+          <div class="ai-settings-row">
+            <select id="ai-model-select" class="nuvra-select">
+              ${_buildModelOptions(current.provider, current.model)}
+            </select>
+            <button class="nuvra-btn" id="ai-detect-models" style="${current.provider !== 'local' ? 'display:none' : ''}" title="Detect models from local server">Detect</button>
+          </div>
+        </div>
+
+        <!-- Session Usage -->
+        <div class="ai-settings-section ai-usage-section">
+          <label class="ai-settings-label">Session Usage</label>
+          <div class="ai-usage-stats">
+            <div class="ai-usage-stat">
+              <span class="ai-usage-value">${usage.tokens.toLocaleString()}</span>
+              <span class="ai-usage-label">Tokens used</span>
+            </div>
+            <div class="ai-usage-stat">
+              <span class="ai-usage-value">${usage.remaining.toLocaleString()}</span>
+              <span class="ai-usage-label">Remaining</span>
+            </div>
+            <div class="ai-usage-stat">
+              <span class="ai-usage-value">${usage.log.length}</span>
+              <span class="ai-usage-label">Requests</span>
+            </div>
+          </div>
+          ${usage.log.length > 0 ? `
+          <details class="ai-usage-log">
+            <summary>View usage log (${usage.log.length} entries)</summary>
+            <table class="ai-usage-table">
+              <thead><tr><th>Time</th><th>Provider</th><th>Model</th><th>Tokens</th><th>Est. Cost</th></tr></thead>
+              <tbody>
+                ${usage.log.slice(-10).reverse().map((e) => `
+                  <tr>
+                    <td>${new Date(e.ts).toLocaleTimeString()}</td>
+                    <td>${e.provider}</td>
+                    <td>${e.model}</td>
+                    <td>${e.totalTokens.toLocaleString()}</td>
+                    <td>$${e.estimatedCost.toFixed(5)}</td>
+                  </tr>
+                `).join('')}
+              </tbody>
+            </table>
+          </details>` : ''}
+        </div>
+
+        <!-- Active Provider Status -->
+        <div class="ai-settings-status">
+          <span class="ai-status-dot ${getActiveProviderId() !== 'mock' ? 'active' : ''}"></span>
+          Currently active: <strong>${getActiveProviderName()}</strong>
+        </div>
+
+      </div>
+
+      <div class="nuvra-modal-actions">
+        <button class="nuvra-btn" id="ai-settings-cancel">Cancel</button>
+        <button class="nuvra-btn primary" id="ai-settings-save">Save & Apply</button>
+      </div>
+    </div>
+  `;
+}
+
+function _buildModelOptions(providerId, selectedModel) {
+  const provider = PROVIDERS[providerId] || PROVIDERS.mock;
+  return provider.models.map((m) =>
+    `<option value="${m}" ${selectedModel === m ? 'selected' : ''}>${m}</option>`
+  ).join('');
+}
+
+// ─── Modal Event Binding ──────────────────────────────────────────────────────
+
+function _bindModalEvents(overlay, current) {
+  const providerSelect = overlay.querySelector('#ai-provider-select');
+  const keySection     = overlay.querySelector('#ai-key-section');
+  const urlSection     = overlay.querySelector('#ai-url-section');
+  const modelSelect    = overlay.querySelector('#ai-model-select');
+  const detectBtn      = overlay.querySelector('#ai-detect-models');
+  const keyLink        = overlay.querySelector('#ai-key-link');
+  const pingBtn        = overlay.querySelector('#ai-ping-server');
+  const pingResult     = overlay.querySelector('#ai-ping-result');
+
+  // Provider change — show/hide relevant sections
+  providerSelect.addEventListener('change', () => {
+    const id = providerSelect.value;
+    const p  = PROVIDERS[id];
+
+    keySection.style.display  = p.hasKey  ? '' : 'none';
+    urlSection.style.display  = p.hasUrl  ? '' : 'none';
+    detectBtn.style.display   = id === 'local' ? '' : 'none';
+
+    if (p.hasKey && p.keyLink) {
+      keyLink.href = p.keyLink;
+      overlay.querySelector('#ai-api-key').placeholder = p.keyHint || '';
+    }
+
+    // Rebuild model options
+    modelSelect.innerHTML = _buildModelOptions(id, '');
+  });
+
+  // Detect local models
+  detectBtn?.addEventListener('click', async () => {
+    const baseUrl = overlay.querySelector('#ai-base-url').value.trim()
+      || 'http://localhost:11434/v1';
+
+    detectBtn.textContent = 'Detecting…';
+    detectBtn.disabled    = true;
+
+    const models = await detectLocalModels(baseUrl);
+
+    detectBtn.textContent = 'Detect';
+    detectBtn.disabled    = false;
+
+    if (models.length > 0) {
+      modelSelect.innerHTML = models
+        .map((m) => `<option value="${m}">${m}</option>`)
+        .join('');
+      showToast(`Found ${models.length} local model${models.length > 1 ? 's' : ''}.`, 'success');
+    } else {
+      showToast('No models found. Is Ollama running?', 'warning');
+    }
+  });
+
+  // Ping local server
+  pingBtn?.addEventListener('click', async () => {
+    const baseUrl = overlay.querySelector('#ai-base-url').value.trim()
+      || 'http://localhost:11434/v1';
+
+    pingBtn.textContent  = 'Testing…';
+    pingBtn.disabled     = true;
+    pingResult.textContent = '';
+
+    const ok = await pingLocalServer(baseUrl);
+
+    pingBtn.textContent = 'Test';
+    pingBtn.disabled    = false;
+
+    if (ok) {
+      pingResult.textContent = '✓ Server is reachable.';
+      pingResult.style.color = '#4ade80';
+    } else {
+      pingResult.textContent = '✗ Could not connect. Make sure the server is running.';
+      pingResult.style.color = '#f87171';
+    }
+  });
+
+  // Close buttons
+  overlay.querySelector('#ai-settings-close')?.addEventListener('click',  () => overlay.remove());
+  overlay.querySelector('#ai-settings-cancel')?.addEventListener('click', () => overlay.remove());
+
+  // Click outside to close
+  overlay.addEventListener('click', (e) => {
+    if (e.target === overlay) overlay.remove();
+  });
+
+  // Save & Apply
+  overlay.querySelector('#ai-settings-save').addEventListener('click', () => {
+    const settings = {
+      provider: providerSelect.value,
+      apiKey:   overlay.querySelector('#ai-api-key')?.value.trim()  || '',
+      model:    modelSelect.value,
+      baseUrl:  overlay.querySelector('#ai-base-url')?.value.trim() || '',
+    };
+
+    saveAISettings(settings);
+    configureAI(settings);
+    overlay.remove();
+
+    const providerLabel = PROVIDERS[settings.provider]?.label || settings.provider;
+    showToast(`AI provider set to ${providerLabel}.`, 'success');
+  });
+}
