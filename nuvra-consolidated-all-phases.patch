++        <span class="nv-preview-page-type ${isApp ? 'app' : 'marketing'}">${isApp ? 'App' : 'Marketing'}</span>
++      </div>
++      <div class="nv-preview-viewport-controls">
++        ${VIEWPORTS.map((vp) => `
++          <button
++            class="nv-preview-viewport-btn ${vp.id === _currentViewport ? 'active' : ''}"
++            data-viewport="${vp.id}"
++            title="${vp.label} (${vp.width})"
++          >${vp.icon} ${vp.label}</button>
++        `).join('')}
++      </div>
++      <div class="nv-preview-actions">
++        <button id="nv-btn-refresh-preview" class="nv-preview-btn" title="Refresh preview with latest changes">↺ Refresh</button>
++        <button id="nv-btn-exit-preview"    class="nv-preview-btn exit" title="Exit preview (Esc)">✕ Exit Preview</button>
++      </div>
++    </div>
++    <div id="nv-preview-canvas" class="nv-preview-canvas">
++      <!-- iframe will be inserted here -->
++    </div>
++  `;
++
++  // Wire viewport buttons
++  overlay.querySelectorAll('[data-viewport]').forEach((btn) => {
++    btn.addEventListener('click', () => {
++      _currentViewport = btn.dataset.viewport;
++      overlay.querySelectorAll('[data-viewport]').forEach((b) => b.classList.remove('active'));
++      btn.classList.add('active');
++      _applyViewport(_currentViewport);
++    });
++  });
++
++  // Wire exit button
++  overlay.querySelector('#nv-btn-exit-preview').addEventListener('click', exitPreview);
++
++  // Wire refresh button
++  overlay.querySelector('#nv-btn-refresh-preview').addEventListener('click', refreshPreview);
++
++  return overlay;
++}
++
++/**
++ * Create the preview iframe with the given HTML document.
++ *
++ * @param {string} html - The full HTML document to load
++ * @returns {HTMLIFrameElement}
