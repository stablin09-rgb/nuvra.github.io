+class DataStore {
+  constructor() {
+    /**
+     * @type {Object.<string, CollectionSchema>}
+     */
+    this._schemas = {};
+
+    /**
+     * @type {Object.<string, DataRecord[]>}
+     */
+    this._records = {};
+
+    this._load();
+  }
+
+  // ── Schema Management ────────────────────────────────────────────────────
+
+  /**
+   * Create a new collection from a schema.
+   * Throws if the schema is invalid or the collection already exists.
+   *
+   * @param {CollectionSchema} schema
+   * @returns {CollectionSchema}
+   */
+  createCollection(schema) {
+    const { valid, errors } = validateCollectionSchema(schema);
+    if (!valid) {
+      throw new Error(`[DataStore] Invalid schema: ${errors.join('; ')}`);
+    }
+    if (this._schemas[schema.id]) {
+      throw new Error(`[DataStore] Collection "${schema.id}" already exists.`);
+    }
