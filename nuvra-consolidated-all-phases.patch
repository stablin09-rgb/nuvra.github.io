index 0000000..85f34d6
--- /dev/null
+++ b/src/data/collectionManager.js
@@ -0,0 +1,258 @@
+/**
+ * Nuvra Builder — Collection Manager  (Phase 3)
+ *
+ * Provides a higher-level, UI-facing API for managing collections.
+ * This sits above the raw DataStore and handles:
+ *  - Creating collections from user input (with sensible defaults)
+ *  - Adding / removing / reordering fields
+ *  - Providing collection summaries for the UI
+ *  - Emitting events so the UI can react to schema changes
+ *
+ * Design decision:
+ *  The DataStore is the source of truth. The CollectionManager is a
+ *  convenience layer — it never stores its own state.
+ */
+
+'use strict';
+
+import { dataStore, FIELD_TYPES, validateCollectionSchema } from './dataModel.js';
+import { slugify } from '../utils/helpers.js';
+
+// ─── Event Bus ────────────────────────────────────────────────────────────────
+
+/**
+ * Simple event emitter for collection change events.
+ * Consumers subscribe with `onCollectionChange(handler)`.
+ *
+ * Events: 'created' | 'updated' | 'deleted' | 'field:added' | 'field:removed'
+ */
+const _listeners = [];
+
+function _emit(event, payload) {
+  _listeners.forEach((fn) => {
+    try { fn(event, payload); } catch (e) { console.error('[CollectionManager] Listener error:', e); }
+  });
+}
+
+/**
+ * Subscribe to collection change events.
+ *
+ * @param {Function} handler - (event: string, payload: object) => void
+ * @returns {Function} Unsubscribe function
+ */
+export function onCollectionChange(handler) {
+  _listeners.push(handler);
+  return () => {
+    const i = _listeners.indexOf(handler);
+    if (i !== -1) _listeners.splice(i, 1);
+  };
+}
