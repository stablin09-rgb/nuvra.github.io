+/**
+ * Nuvra Builder — Page Semantics  (Phase 3)
+ *
+ * Distinguishes between different page types and provides the metadata,
+ * layout hints, and default state schemas appropriate for each.
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────┐
+ * │  Page Types                                                              │
+ * │                                                                          │
+ * │  MARKETING PAGES   landing, pricing, blog-post, about, contact          │
+ * │    → Full-width layouts, scroll-based sections, no sidebar              │
+ * │    → No state management needed                                         │
+ * │    → Generated by the existing AI schema pipeline                       │
+ * │                                                                          │
+ * │  APP PAGES         dashboard, crud-list, crud-detail, form-page,        │
+ * │                    settings, profile, report                            │
+ * │    → App shell layouts (sidebar + header + content)                     │
+ * │    → Require state management and data binding                          │
+ * │    → Generated by the new App Builder pipeline (Phase 4)               │
+ * └──────────────────────────────────────────────────────────────────────────┘
+ *
+ * Design decisions:
+ *  - `PageConfig` is stored in the project JSON alongside `html` and `css`.
+ *    This makes page type a first-class, serializable property.
+ *  - The page type drives which blocks, components, and AI prompts are shown
+ *    in the editor sidebar. Marketing pages see the marketing block library;
+ *    app pages see the app component library.
+ *  - `layoutHints` are CSS variables injected into the GrapesJS canvas,
+ *    allowing the rendered page to adapt to its intended context.
+ */
+
+'use strict';
+
+// ─── Page Type Registry ───────────────────────────────────────────────────────
+
+/**
+ * @typedef {Object} PageTypeConfig
+ * @property {string}   id           - Unique page type ID
+ * @property {string}   name         - Human-readable name
+ * @property {'marketing'|'app'} kind - Broad category
+ * @property {string}   description  - Short description for AI context
+ * @property {string}   icon         - Emoji icon for UI display
+ * @property {object}   defaultState - Default page state schema extensions
+ * @property {object}   layoutHints  - CSS variable hints for the canvas
+ * @property {string[]} suggestedComponents - Component IDs to suggest in the sidebar
+ * @property {string}   aiHint       - Hint for the AI when generating this page type
+ */
+
+/** @type {Object.<string, PageTypeConfig>} */
+export const PAGE_TYPES = {
+
+  // ── Marketing Pages ────────────────────────────────────────────────────────
+
+  landing: {
+    id:          'landing',
+    name:        'Landing Page',
+    kind:        'marketing',
