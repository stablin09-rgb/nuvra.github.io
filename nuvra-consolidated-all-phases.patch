@@ -0,0 +1,214 @@
+/**
+ * Nuvra Builder — Manifest Builder  (Phase 4B)
+ *
+ * Generates the `nuvra.manifest.json` file that accompanies every
+ * published site bundle. The manifest is a machine-readable description
+ * of the site's structure, data model, runtime requirements, and build
+ * metadata.
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────┐
+ * │  nuvra.manifest.json structure                                           │
+ * │                                                                          │
+ * │  {                                                                       │
+ * │    "schema":    "nuvra-manifest/1.0",                                   │
+ * │    "buildId":   "nuvra-build-...",                                       │
+ * │    "builtAt":   "2026-02-26T...",                                        │
+ * │    "generator": "Nuvra Builder 1.0.0",                                  │
+ * │    "site": {                                                             │
+ * │      "name":    "My Nuvra Site",                                        │
+ * │      "baseUrl": ""                                                       │
+ * │    },                                                                    │
+ * │    "pages": [                                                            │
+ * │      { "id", "name", "type", "kind", "filename", "isHome" }            │
+ * │    ],                                                                    │
+ * │    "dataModel": {                                                        │
+ * │      "collections": [                                                    │
+ * │        { "id", "name", "fieldCount", "recordCount", "fields": [...] }  │
+ * │      ]                                                                   │
+ * │    },                                                                    │
+ * │    "runtime": {                                                          │
+ * │      "hasAppPages":   true,                                             │
+ * │      "modules":       ["state-manager", "data-store", "action-engine"] │
+ * │    },                                                                    │
+ * │    "build": {                                                            │
+ * │      "totalFiles":    4,                                                │
+ * │      "warnings":      [],                                               │
+ * │      "durationMs":    312                                               │
+ * │    }                                                                     │
+ * │  }                                                                       │
+ * └──────────────────────────────────────────────────────────────────────────┘
+ *
+ * Design decisions:
+ *  - The manifest uses a `schema` field with a versioned identifier.
+ *    This allows future tooling (CI/CD, cloud deploy, mobile builds) to
+ *    detect the manifest version and handle it appropriately.
+ *  - The `dataModel` section describes the schema of each collection but
+ *    does NOT include records. Records are embedded in the HTML pages
+ *    themselves as runtime data snapshots. This keeps the manifest small
+ *    and schema-focused.
+ *  - The `runtime.modules` array lists the logical modules the runtime
+ *    depends on. This is informational for now but will be used in future
+ *    phases to determine which runtime features to include in a build.
+ *  - The manifest is included in the ZIP as `nuvra.manifest.json` at the
+ *    root level, not inside `_nuvra/`. This makes it easy to find and
+ *    process by external tooling.
+ */
+
+'use strict';
+
+import { dataStore }    from '../data/dataModel.js';
+import { isAppPage }    from '../core/pageSemantics.js';
+import { slugify }      from '../utils/helpers.js';
+
+// ─── Manifest Schema Version ──────────────────────────────────────────────────
+
+const MANIFEST_SCHEMA  = 'nuvra-manifest/1.0';
+const GENERATOR_STRING = 'Nuvra Builder 1.0.0';
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * Build the complete nuvra.manifest.json for a site.
+ *
+ * @param {object}   options
+ * @param {string}   options.siteName    - User-provided site name
+ * @param {string}   options.buildId     - Unique build identifier
+ * @param {string}   options.builtAt     - ISO timestamp of the build
+ * @param {object}   options.pages       - The pages map from getSnapshot()
+ * @param {string[]} options.warnings    - Build warnings
+ * @param {number}   options.totalFiles  - Total number of files in the bundle
+ * @param {number}   options.durationMs  - Build duration in milliseconds
+ * @param {string}   [options.baseUrl]   - Optional canonical base URL
+ * @returns {object}                     - The manifest as a plain JS object
+ */
+export function buildManifest(options) {
+  const {
+    siteName   = 'Nuvra Site',
+    buildId,
+    builtAt,
+    pages      = {},
+    warnings   = [],
+    totalFiles = 0,
+    durationMs = 0,
+    baseUrl    = '',
+  } = options;
+
+  const pageIds = Object.keys(pages);
+
+  // ── Pages section ──────────────────────────────────────────────────────────
+
+  const pagesManifest = pageIds.map((pageId, index) => {
+    const page     = pages[pageId];
+    const pageType = page?.pageConfig?.type || 'landing';
+    const isApp    = isAppPage(pageType);
+    const filename = (pageId === 'home' || index === 0)
+      ? 'index.html'
+      : `${slugify(pageId) || pageId}.html`;
+
+    return {
+      id:       pageId,
+      name:     page.name || pageId,
+      type:     pageType,
+      kind:     isApp ? 'app' : 'marketing',
+      filename,
+      isHome:   filename === 'index.html',
+    };
+  });
+
+  // ── Data model section ─────────────────────────────────────────────────────
+
+  const collectionsManifest = _buildDataModelManifest();
+
+  // ── Runtime section ────────────────────────────────────────────────────────
+
+  const hasAppPages = pagesManifest.some((p) => p.kind === 'app');
+
+  const runtimeModules = hasAppPages
+    ? ['state-manager', 'data-store', 'action-engine', 'component-hydrator']
+    : [];
+
+  // ── Assemble manifest ──────────────────────────────────────────────────────
+
+  return {
+    schema:    MANIFEST_SCHEMA,
+    buildId,
+    builtAt,
+    generator: GENERATOR_STRING,
+
+    site: {
+      name:    siteName,
+      baseUrl: baseUrl || '',
+    },
+
+    pages: pagesManifest,
+
+    dataModel: {
+      collections: collectionsManifest,
+    },
+
+    runtime: {
+      hasAppPages,
+      modules: runtimeModules,
+    },
+
+    build: {
+      totalFiles,
+      warnings,
+      durationMs,
+    },
+  };
+}
+
+/**
+ * Serialize the manifest object to a formatted JSON string.
+ *
+ * @param {object} manifest - From buildManifest()
+ * @returns {string}
+ */
+export function serializeManifest(manifest) {
+  return JSON.stringify(manifest, null, 2);
+}
+
+// ─── Private Helpers ──────────────────────────────────────────────────────────
+
+/**
+ * Build the data model section of the manifest.
+ * Includes schema information but NOT records (records are in the HTML pages).
+ *
+ * @returns {object[]}
+ */
+function _buildDataModelManifest() {
+  const collections = [];
+
+  try {
+    const collectionIds = dataStore.listCollections();
+
+    for (const id of collectionIds) {
+      try {
+        const schema      = dataStore.getCollection(id);
+        const records     = dataStore.query(id);
+        const fieldCount  = schema.fields?.length ?? 0;
+        const recordCount = records?.length ?? 0;
+
+        collections.push({
+          id,
+          name:        schema.name,
+          fieldCount,
+          recordCount,
+          fields: (schema.fields || []).map((f) => ({
+            id:       f.id,
+            name:     f.name,
+            type:     f.type,
+            required: f.required || false,
+          })),
+        });
+      } catch {
+        // Skip collections that can't be serialized
+      }
+    }
+  } catch {
+    // dataStore not yet initialized
+  }
+
+  return collections;
+}
diff --git a/src/publish/publishManager.js b/src/publish/publishManager.js
new file mode 100644
index 0000000..bef31cf
--- /dev/null
+++ b/src/publish/publishManager.js
@@ -0,0 +1,399 @@
+/**
+ * Nuvra Builder — Publish Manager  (Phase 4B)
+ *
+ * Orchestrates the full publish flow with two export targets:
+ *
+ *  Target A — Static ZIP Export
+ *    Packages the complete site bundle into a .zip file and triggers
+ *    a browser download. Ready to deploy on GitHub Pages, Netlify, Vercel,
+ *    or any static host.
+ *
+ *  Target B — Local Live Preview Server
+ *    Simulates "going live" locally by serving the published output through
+ *    a Blob URL in a new browser tab. This is a local-only simulation —
+ *    no server, no network, no cloud. It demonstrates exactly what the
+ *    published site will look like and behave like.
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────┐
+ * │  Publish Flow                                                            │
+ * │                                                                          │
+ * │  User clicks "Publish"                                                   │
+ * │    → PublishModal opens (shows page list, site name input)              │
+ * │    → User selects target (ZIP or Live Preview)                          │
+ * │    → User clicks "Build"                                                │
+ * │    → Progress bar updates as each page is rendered                      │
+ * │    → For ZIP: browser downloads <site-name>.zip                        │
+ * │    → For Live Preview: new tab opens with the home page                │
+ * │    → Build report shows success / warnings                             │
+ * └──────────────────────────────────────────────────────────────────────────┘
+ *
+ * Design decisions:
+ *  - ZIP generation uses `fflate` loaded from CDN via dynamic import.
+ *    fflate is a pure-JS, zero-dependency ZIP library that works entirely
+ *    in the browser with no build step.
+ *  - The "Local Live Preview" target uses the Blob URL API to create
+ *    an in-memory URL for the home page HTML. This opens in a new tab
+ *    and behaves identically to the published output. The Blob URL is
+ *    revoked after 60 seconds to avoid memory leaks.
+ *  - The PublishManager is stateless. Each call to `openPublishModal()`
+ *    is a fresh, independent publish session.
+ *  - Error handling is granular: individual page failures produce warnings
+ *    but do not abort the build.
+ */
+
+'use strict';
+
+import { buildSite, getBuildSummary } from './siteBuilder.js';
+import { showToast }                  from '../utils/helpers.js';
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * Open the Publish modal.
+ * This is the single entry point for the entire publish system.
+ */
+export function openPublishModal() {
+  const summary = getBuildSummary();
+
+  if (summary.pageCount === 0) {
+    showToast('No pages to publish. Add at least one page first.', 'error');
+    return;
+  }
+
+  _showPublishModal(summary);
+}
+
+// ─── Publish Modal ────────────────────────────────────────────────────────────
+
+function _showPublishModal(summary) {
+  // Remove any existing modal
+  document.getElementById('nv-publish-overlay')?.remove();
+
+  const overlay = document.createElement('div');
+  overlay.className = 'nuvra-modal-overlay';
+  overlay.id        = 'nv-publish-overlay';
+
+  const pageRows = summary.pages.map((p) => `
+    <div class="nv-publish-page-row">
+      <span class="nv-publish-page-icon">${p.isApp ? '⚡' : '📄'}</span>
+      <span class="nv-publish-page-name">${_esc(p.name)}</span>
+      <span class="nv-publish-page-file">${_esc(p.filename)}</span>
+      <span class="nv-publish-page-type ${p.isApp ? 'app' : 'marketing'}">${p.isApp ? 'App' : 'Marketing'}</span>
+    </div>
+  `).join('');
+
+  overlay.innerHTML = `
+    <div class="nuvra-modal nv-publish-modal">
+      <div class="nuvra-modal-header">
+        <span class="nuvra-modal-title">Publish Site</span>
+        <button class="nuvra-modal-close" id="nv-publish-close" title="Close">✕</button>
+      </div>
+
+      <div class="nuvra-modal-body">
+
+        <!-- Site Name -->
+        <div class="nv-publish-section">
+          <label class="nv-publish-label" for="nv-publish-site-name">Site Name</label>
+          <input
+            class="nv-publish-input"
+            id="nv-publish-site-name"
+            type="text"
+            placeholder="My Nuvra Site"
+            value="My Nuvra Site"
+          />
+        </div>
+
+        <!-- Export Target -->
+        <div class="nv-publish-section">
+          <label class="nv-publish-label">Export Target</label>
+          <div class="nv-publish-targets">
+
+            <label class="nv-publish-target" id="nv-target-zip-label">
+              <input type="radio" name="nv-publish-target" value="zip" checked />
+              <div class="nv-publish-target-content">
+                <span class="nv-publish-target-icon">📦</span>
+                <div>
+                  <div class="nv-publish-target-name">Static ZIP</div>
+                  <div class="nv-publish-target-desc">Download a .zip file ready to deploy on GitHub Pages, Netlify, or Vercel.</div>
+                </div>
+              </div>
+            </label>
+
+            <label class="nv-publish-target" id="nv-target-live-label">
+              <input type="radio" name="nv-publish-target" value="live" />
+              <div class="nv-publish-target-content">
+                <span class="nv-publish-target-icon">🌐</span>
+                <div>
+                  <div class="nv-publish-target-name">Local Live Preview</div>
+                  <div class="nv-publish-target-desc">Open the published site in a new tab to verify it behaves exactly like production.</div>
+                </div>
+              </div>
+            </label>
+
+          </div>
+        </div>
+
+        <!-- Pages Summary -->
+        <div class="nv-publish-section">
+          <label class="nv-publish-label">
+            Pages
+            <span class="nv-publish-count">${summary.pageCount}</span>
+          </label>
+          <div class="nv-publish-page-list">
+            ${pageRows}
+          </div>
+        </div>
+
+        <!-- Progress (hidden until build starts) -->
+        <div class="nv-publish-progress-wrap" id="nv-publish-progress-wrap" style="display:none">
+          <div class="nv-publish-progress-bar-track">
+            <div class="nv-publish-progress-bar" id="nv-publish-progress-bar"></div>
+          </div>
+          <div class="nv-publish-progress-label" id="nv-publish-progress-label">Building…</div>
+        </div>
+
+      </div>
+
+      <div class="nuvra-modal-footer">
+        <button class="nuvra-btn secondary" id="nv-publish-cancel">Cancel</button>
+        <button class="nuvra-btn primary" id="nv-publish-build">
+          <span id="nv-publish-btn-text">Build &amp; Export</span>
+        </button>
+      </div>
+    </div>
+  `;
+
+  document.body.appendChild(overlay);
+
+  // ── Event listeners ────────────────────────────────────────────────────────
+
+  overlay.querySelector('#nv-publish-close').addEventListener('click',  () => overlay.remove());
+  overlay.querySelector('#nv-publish-cancel').addEventListener('click', () => overlay.remove());
+  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
+
+  overlay.querySelector('#nv-publish-build').addEventListener('click', async () => {
+    const siteName = overlay.querySelector('#nv-publish-site-name').value.trim() || 'Nuvra Site';
+    const target   = overlay.querySelector('input[name="nv-publish-target"]:checked')?.value || 'zip';
+
+    await _runBuild(overlay, siteName, target);
+  });
+}
+
+// ─── Build Orchestration ──────────────────────────────────────────────────────
+
+async function _runBuild(overlay, siteName, target) {
+  const buildBtn      = overlay.querySelector('#nv-publish-build');
+  const btnText       = overlay.querySelector('#nv-publish-btn-text');
+  const progressWrap  = overlay.querySelector('#nv-publish-progress-wrap');
+  const progressBar   = overlay.querySelector('#nv-publish-progress-bar');
+  const progressLabel = overlay.querySelector('#nv-publish-progress-label');
+
+  // Disable UI during build
+  buildBtn.disabled = true;
+  btnText.textContent = 'Building…';
+  progressWrap.style.display = 'block';
+  progressBar.style.width    = '0%';
+
+  let result;
+
+  try {
+    result = await buildSite({
+      siteName,
+      onProgress: (pageId, index, total) => {
+        const pct = Math.round((index / total) * 90);
+        progressBar.style.width    = `${pct}%`;
+        progressLabel.textContent  = `Rendering "${pageId}" (${index}/${total})…`;
+      },
+    });
+
+    progressBar.style.width   = '100%';
+    progressLabel.textContent = 'Packaging…';
+
+    // Small delay so the user sees 100% before the download triggers
+    await _sleep(300);
+
+    if (target === 'zip') {
+      await _downloadZip(result, siteName);
+    } else {
+      _openLivePreview(result);
+    }
+
+    // Show the build report
+    overlay.remove();
+    _showBuildReport(result, target);
+
+  } catch (err) {
+    console.error('[PublishManager] Build failed:', err);
+    buildBtn.disabled   = false;
+    btnText.textContent = 'Build & Export';
+    progressWrap.style.display = 'none';
+    showToast(`Build failed: ${err.message}`, 'error');
+  }
+}
+
+// ─── Target A: Static ZIP Export ─────────────────────────────────────────────
+
+/**
+ * Package the build result into a ZIP file and trigger a browser download.
+ * Uses fflate loaded from CDN.
+ *
+ * @param {object} result   - BuildResult from buildSite()
+ * @param {string} siteName - Used as the ZIP filename
+ */
+async function _downloadZip(result, siteName) {
+  // Load fflate from CDN (lightweight, zero-dependency ZIP library)
+  const fflate = await _loadFflate();
+
+  // Build the file map: { 'relative/path': Uint8Array }
+  const fileMap = {};
+
+  for (const file of result.files) {
+    const encoded = new TextEncoder().encode(file.content);
+    fileMap[file.path] = encoded;
+  }
+
+  return new Promise((resolve, reject) => {
+    fflate.zip(fileMap, { level: 6 }, (err, data) => {
+      if (err) { reject(err); return; }
+
+      const blob     = new Blob([data], { type: 'application/zip' });
+      const url      = URL.createObjectURL(blob);
+      const anchor   = document.createElement('a');
+      const filename = `${_slugify(siteName) || 'nuvra-site'}.zip`;
+
+      anchor.href     = url;
+      anchor.download = filename;
+      anchor.click();
+
+      setTimeout(() => URL.revokeObjectURL(url), 10_000);
+      resolve();
+    });
+  });
+}
+
+// ─── Target B: Local Live Preview ────────────────────────────────────────────
+
+/**
+ * Open the published home page in a new browser tab using a Blob URL.
+ * This simulates "going live" locally — no server, no network, no cloud.
+ * The behavior is identical to the published output.
+ *
+ * @param {object} result - BuildResult from buildSite()
+ */
+function _openLivePreview(result) {
+  // Find the home page (index.html)
+  const homeFile = result.files.find((f) => f.path === 'index.html');
+
+  if (!homeFile) {
+    showToast('Could not find the home page in the build output.', 'error');
+    return;
+  }
+
+  const blob    = new Blob([homeFile.content], { type: 'text/html' });
+  const blobUrl = URL.createObjectURL(blob);
+
+  // Open in a new tab
+  const tab = window.open(blobUrl, '_blank');
+
+  if (!tab) {
+    showToast('Pop-up blocked. Please allow pop-ups for this site and try again.', 'error');
+    URL.revokeObjectURL(blobUrl);
+    return;
+  }
+
+  // Revoke the Blob URL after 60 seconds to avoid memory leaks
+  // (the tab will have loaded the content by then)
+  setTimeout(() => URL.revokeObjectURL(blobUrl), 60_000);
+}
+
+// ─── Build Report Modal ───────────────────────────────────────────────────────
+
+function _showBuildReport(result, target) {
+  const overlay = document.createElement('div');
+  overlay.className = 'nuvra-modal-overlay';
+  overlay.id        = 'nv-build-report-overlay';
+
+  const targetLabel = target === 'zip' ? 'Static ZIP downloaded' : 'Live preview opened in new tab';
+  const statusIcon  = result.success ? '✅' : '⚠️';
+  const statusText  = result.success ? 'Build successful' : 'Build completed with warnings';
+
+  const warningRows = result.warnings.length > 0
+    ? result.warnings.map((w) => `<div class="nv-report-warning">⚠ ${_esc(w)}</div>`).join('')
+    : '';
+
+  const pageRows = result.pageList.map((p) => `
+    <div class="nv-report-page-row">
+      <span>${p.isApp ? '⚡' : '📄'}</span>
+      <span>${_esc(p.name)}</span>
+      <code>${_esc(p.filename)}</code>
+    </div>
+  `).join('');
+
+  overlay.innerHTML = `
+    <div class="nuvra-modal nv-report-modal">
+      <div class="nuvra-modal-header">
+        <span class="nuvra-modal-title">${statusIcon} ${statusText}</span>
+        <button class="nuvra-modal-close" id="nv-report-close">✕</button>
+      </div>
+      <div class="nuvra-modal-body">
+        <div class="nv-report-meta">
+          <div class="nv-report-meta-row"><span>Target</span><strong>${targetLabel}</strong></div>
+          <div class="nv-report-meta-row"><span>Pages</span><strong>${result.pageList.length}</strong></div>
+          <div class="nv-report-meta-row"><span>Files</span><strong>${result.files.length}</strong></div>
+          <div class="nv-report-meta-row"><span>Duration</span><strong>${result.durationMs}ms</strong></div>
+          <div class="nv-report-meta-row"><span>Build ID</span><code>${result.buildId}</code></div>
+        </div>
+        ${warningRows ? `<div class="nv-report-warnings">${warningRows}</div>` : ''}
+        <div class="nv-report-pages">${pageRows}</div>
+      </div>
+      <div class="nuvra-modal-footer">
+        <button class="nuvra-btn primary" id="nv-report-close-btn">Done</button>
+      </div>
+    </div>
+  `;
+
+  document.body.appendChild(overlay);
+
+  overlay.querySelector('#nv-report-close').addEventListener('click',     () => overlay.remove());
+  overlay.querySelector('#nv-report-close-btn').addEventListener('click', () => overlay.remove());
+  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
+}
+
+// ─── fflate Loader ────────────────────────────────────────────────────────────
+
+let _fflateCache = null;
+
+async function _loadFflate() {
+  if (_fflateCache) return _fflateCache;
+
+  return new Promise((resolve, reject) => {
+    if (window.fflate) { _fflateCache = window.fflate; resolve(window.fflate); return; }
+
+    const script = document.createElement('script');
+    script.src   = 'https://cdn.jsdelivr.net/npm/fflate@0.8.2/umd/index.js';
+    script.onload  = () => { _fflateCache = window.fflate; resolve(window.fflate); };
+    script.onerror = () => reject(new Error('Failed to load fflate from CDN. Check your internet connection.'));
+    document.head.appendChild(script);
+  });
+}
+
+// ─── Utilities ────────────────────────────────────────────────────────────────
+
+function _sleep(ms) {
+  return new Promise((r) => setTimeout(r, ms));
+}
+
+function _slugify(str) {
+  return String(str || '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
+
+function _esc(str) {
+  return String(str || '')
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
diff --git a/src/publish/publishRenderer.js b/src/publish/publishRenderer.js
new file mode 100644
index 0000000..f426676
--- /dev/null
+++ b/src/publish/publishRenderer.js
@@ -0,0 +1,377 @@
+/**
+ * Nuvra Builder — Publish Renderer  (Phase 4B)
+ *
+ * Generates production-ready, editor-free HTML documents for each page.
+ * This is the canonical render path for published output.
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────┐
+ * │  Relationship to the Preview Renderer                                    │
+ * │                                                                          │
+ * │  PreviewRenderer  →  iframe-loaded, sandboxed, may carry debug hints    │
+ * │  PublishRenderer  →  standalone HTML files, zero editor artifacts        │
+ * │                                                                          │
+ * │  Both share the same CORE LOGIC:                                         │
+ * │   - Same data snapshot serialization                                     │
+ * │   - Same runtime IIFE (getPreviewRuntimeScript)                         │
+ * │   - Same app component styles                                            │
+ * │   - Same two render paths (marketing / app)                             │
+ * │                                                                          │
+ * │  PublishRenderer ADDS:                                                   │
+ * │   - Production <meta> tags (description, OG, canonical)                 │
+ * │   - Canonical inter-page <nav> links                                    │
+ * │   - A nuvra-build comment header (no editor UI references)              │
+ * │   - Clean script IDs (nv-runtime-data, nv-runtime-context)             │
+ * │   - No iframe-specific sandbox attributes                               │
+ * └──────────────────────────────────────────────────────────────────────────┘
+ *
+ * Design decisions:
+ *  - The PublishRenderer does NOT extend or import the PreviewRenderer.
+ *    It is a sibling module that shares the same runtime (previewRuntime.js)
+ *    but has its own document assembly logic. This prevents accidental
+ *    coupling: changes to the preview experience cannot silently break
+ *    the published output.
+ *  - The runtime script is the same IIFE used in preview. This is the
+ *    single source of truth for app-page execution behavior.
+ *  - Marketing pages are rendered as pure, minimal HTML/CSS with no scripts.
+ *    They have zero JavaScript dependencies and will work on any host.
+ *  - The `buildContext` parameter allows the SiteBuilder to pass site-wide
+ *    metadata (site name, all page slugs) so each page can include correct
+ *    canonical URLs and inter-page navigation.
+ */
+
+'use strict';
+
+import { isAppPage }               from '../core/pageSemantics.js';
+import { dataStore }               from '../data/dataModel.js';
+import { getPreviewRuntimeScript } from '../preview/previewRuntime.js';
+import { slugify }                 from '../utils/helpers.js';
+
+// ─── Types ────────────────────────────────────────────────────────────────────
+
+/**
+ * @typedef {Object} BuildContext
+ * @property {string}   siteName    - The user-provided site name
+ * @property {string}   buildId     - Unique build identifier
+ * @property {string}   builtAt     - ISO timestamp of the build
+ * @property {object[]} allPages    - Array of { id, name, filename, isHome } for all pages
+ */
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * Build a production-ready, editor-free HTML document for a single page.
+ *
+ * @param {object}       page         - The page object from the project state
+ * @param {string}       pageId       - The page's ID
+ * @param {BuildContext} buildContext - Site-wide metadata for canonical links and nav
+ * @returns {string}                  - A complete, standalone HTML document string
+ */
+export function buildPublishDocument(page, pageId, buildContext) {
+  const pageType = page?.pageConfig?.type || 'landing';
+  const isApp    = isAppPage(pageType);
+
+  if (isApp) {
+    return _buildAppDocument(page, pageId, pageType, buildContext);
+  } else {
+    return _buildMarketingDocument(page, pageId, buildContext);
+  }
+}
+
+// ─── Marketing Page Renderer ──────────────────────────────────────────────────
+
+/**
+ * Render a marketing page as clean, static HTML/CSS.
+ * Zero JavaScript. Zero runtime. Pure HTML.
+ *
+ * @param {object}       page
+ * @param {string}       pageId
+ * @param {BuildContext} ctx
+ * @returns {string}
+ */
+function _buildMarketingDocument(page, pageId, ctx) {
+  const title       = _esc(page.name || pageId);
+  const description = _esc(page?.pageConfig?.description || `${title} — built with Nuvra`);
+  const bodyHtml    = page.html || '';
+  const css         = page.css  || '';
+  const canonical   = _getCanonicalUrl(pageId, ctx);
+  const buildHeader = _buildComment(pageId, 'marketing', ctx);
+
+  return `${buildHeader}<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>${title}</title>
+  <meta name="description" content="${description}" />
+  <meta name="generator" content="Nuvra Builder" />
+  ${canonical ? `<link rel="canonical" href="${canonical}" />` : ''}
+
+  <!-- Open Graph -->
+  <meta property="og:title"       content="${title}" />
+  <meta property="og:description" content="${description}" />
+  <meta property="og:type"        content="website" />
+  ${canonical ? `<meta property="og:url" content="${canonical}" />` : ''}
+
+  <style>
+    /* Nuvra Production Reset */
+    *, *::before, *::after { box-sizing: border-box; }
+    body { margin: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
+    img { max-width: 100%; height: auto; display: block; }
+    a { color: inherit; }
+  </style>
+  <style>
+${css}
+  </style>
+</head>
+<body>
+${bodyHtml}
+</body>
+</html>`;
+}
+
+// ─── App Page Renderer ────────────────────────────────────────────────────────
+
+/**
+ * Render an app page with the embedded runtime and data snapshot.
+ * The runtime is the same IIFE used in Preview Mode — ensuring parity.
+ *
+ * @param {object}       page
+ * @param {string}       pageId
+ * @param {string}       pageType
+ * @param {BuildContext} ctx
+ * @returns {string}
+ */
+function _buildAppDocument(page, pageId, pageType, ctx) {
+  const title       = _esc(page.name || pageId);
+  const description = _esc(page?.pageConfig?.description || `${title} — built with Nuvra`);
+  const bodyHtml    = page.html || '';
+  const css         = page.css  || '';
+  const canonical   = _getCanonicalUrl(pageId, ctx);
+  const buildHeader = _buildComment(pageId, pageType, ctx);
+
+  // Serialize the data snapshot for the runtime
+  const dataSnapshot = _serializeDataSnapshot();
+
+  // Get the shared runtime IIFE — same as preview, no divergence
+  const runtimeScript = getPreviewRuntimeScript();
+
+  return `${buildHeader}<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>${title}</title>
+  <meta name="description" content="${description}" />
+  <meta name="generator" content="Nuvra Builder" />
+  ${canonical ? `<link rel="canonical" href="${canonical}" />` : ''}
+
+  <!-- Open Graph -->
+  <meta property="og:title"       content="${title}" />
+  <meta property="og:description" content="${description}" />
+  <meta property="og:type"        content="website" />
+  ${canonical ? `<meta property="og:url" content="${canonical}" />` : ''}
+
+  <style>
+    /* Nuvra Production Reset */
+    *, *::before, *::after { box-sizing: border-box; }
+    body { margin: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f8f9fa; }
+    img { max-width: 100%; height: auto; display: block; }
+    a { color: inherit; }
+
+    /* App Component Base Styles */
+    ${_getAppComponentStyles()}
+  </style>
+  <style>
+${css}
+  </style>
+</head>
+<body>
+${bodyHtml}
+
+<!--
+  Nuvra Runtime Data
+  This block contains the serialized data model snapshot used to hydrate
+  the application at startup. It is generated at build time and reflects
+  the state of your data collections at the moment of publishing.
+-->
+<script id="nv-runtime-data" type="application/json">
+${JSON.stringify(dataSnapshot, null, 2)}
+</script>
+
+<!-- Nuvra Runtime Context -->
+<script id="nv-runtime-context" type="application/json">
+${JSON.stringify({ pageId, pageType, siteName: ctx?.siteName || '', buildId: ctx?.buildId || '' }, null, 2)}
+</script>
+
+<!-- Nuvra Application Runtime -->
+<script>
+${runtimeScript}
+</script>
+
+</body>
+</html>`;
+}
+
+// ─── Data Snapshot Serialization ──────────────────────────────────────────────
+
+/**
+ * Serialize all collections and records into a plain JSON snapshot.
+ * This is the same logic as in previewRenderer.js, kept in sync manually.
+ * The snapshot is embedded in the published HTML so the runtime can
+ * hydrate its in-memory store without any network requests.
+ *
+ * @returns {{ collections: object, records: object }}
+ */
+function _serializeDataSnapshot() {
+  const snapshot = { collections: {}, records: {} };
+
+  try {
+    const collectionIds = dataStore.listCollections();
+
+    for (const id of collectionIds) {
+      try {
+        const schema  = dataStore.getCollection(id);
+        const records = dataStore.query(id);
+
+        snapshot.collections[id] = {
+          id:     schema.id,
+          name:   schema.name,
+          fields: schema.fields,
+        };
+        snapshot.records[id] = records;
+      } catch {
+        // Skip collections that can't be serialized
+      }
+    }
+  } catch {
+    // dataStore not yet initialized — return empty snapshot
+  }
+
+  return snapshot;
+}
+
+// ─── App Component Styles ─────────────────────────────────────────────────────
+
