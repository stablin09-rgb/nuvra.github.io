++function _createPreviewIframe(html) {
++  const iframe = document.createElement('iframe');
++  iframe.id        = 'nv-preview-iframe';
++  iframe.className = 'nv-preview-iframe';
++
++  // Sandbox: allow scripts (for the runtime) and same-origin (for localStorage)
++  // Prevent navigation away from the builder
++  iframe.sandbox   = 'allow-scripts allow-same-origin allow-forms';
++  iframe.srcdoc    = html;
++  iframe.title     = 'Nuvra Preview';
++
++  return iframe;
++}
