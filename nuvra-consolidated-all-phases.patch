+// ─── Content Generators ───────────────────────────────────────────────────────
+
+function _heroTagline({ intent }, industry) {
+  const taglines = {
+    tech:       ['Build More, Worry Less', 'Ship Faster, Scale Smarter', 'The Developer Platform That Gets Out of Your Way'],
+    creative:   ['Where Ideas Become Reality', 'Design That Speaks for Itself', 'Crafted with Intention'],
+    finance:    ['Finance, Simplified', 'Secure. Compliant. Effortless.', 'The Modern Way to Manage Money'],
+    health:     ['Better Care, Delivered Simply', 'Your Health, Your Way', 'Modern Healthcare for Modern Lives'],
+    education:  ['Learn Without Limits', 'Skills That Open Doors', 'Education That Fits Your Life'],
+    ecommerce:  ['Quality Worth Keeping', 'Shop Smarter, Live Better', 'The New Standard in Online Shopping'],
+    general:    ['Built for What\'s Next', 'Simple. Powerful. Yours.', 'The Better Way Forward'],
+  };
+  const pool = taglines[industry] ?? taglines.general;
+  return pool[Math.floor(Math.random() * pool.length)];
+}
+
+function _primaryCta({ intent }) {
+  if (/portfolio|freelance|hire/.test(intent)) return 'View My Work';
+  if (/agency|studio/.test(intent))            return 'Start a Project';
+  if (/app|mobile|download/.test(intent))      return 'Download Free';
+  if (/blog|article/.test(intent))             return 'Read the Blog';
+  if (/shop|store|ecommerce/.test(intent))     return 'Shop Now';
+  if (/dashboard|analytics/.test(intent))      return 'Open Dashboard';
+  return 'Get Started Free';
+}
+
+function _secondaryCta({ intent }) {
+  if (/portfolio|freelance/.test(intent)) return 'Get in Touch';
+  if (/agency/.test(intent))              return 'See Our Work';
+  if (/app/.test(intent))                 return 'Watch Demo';
+  return 'See a Demo';
+}
+
+function _featuresHeading({ intent }) {
+  if (/portfolio/.test(intent))  return 'What I Do';
+  if (/agency/.test(intent))     return 'Our Services';
+  if (/app/.test(intent))        return 'Why You\'ll Love It';
+  if (/shop|store/.test(intent)) return 'Why Shop With Us';
+  return 'Everything you need, nothing you don\'t';
+}
