+/**
+ * Nuvra Builder — Data Model System  (Phase 3)
+ *
+ * Defines the schema language for Nuvra's data layer: field types,
+ * collection schemas, and the in-memory DataStore that persists to
+ * localStorage alongside the project JSON.
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────┐
+ * │                        DATA MODEL HIERARCHY                              │
+ * │                                                                          │
+ * │  Project                                                                 │
+ * │    └── Collections  (e.g. "users", "tasks", "products")                 │
+ * │           └── Fields  (e.g. name:text, price:number, done:boolean)      │
+ * │                  └── Records  (rows of data matching the field schema)  │
+ * └──────────────────────────────────────────────────────────────────────────┘
+ *
+ * Design decisions:
+ *  - All schemas are plain JSON objects — fully serializable, storable, and
+ *    AI-generatable. The AI can produce a CollectionSchema just like a PageSchema.
+ *  - The DataStore is intentionally in-memory with localStorage persistence.
+ *    Swapping to a backend API means replacing only `_persist()` and `_load()`.
+ *  - Records are stored as flat arrays of objects. No relational joins yet.
+ *  - Field validation is schema-driven. Adding a new field type = adding one
+ *    entry to FIELD_TYPES and one validator to _validateValue().
+ */
+
+'use strict';
+
+// ─── Field Type Registry ──────────────────────────────────────────────────────
+
+/**
+ * All supported field types in Nuvra's data model.
+ * Each entry defines the type's display name, default value, and a description
+ * for AI context.
+ *
+ * @type {Object.<string, { label: string, defaultValue: *, description: string }>}
+ */
+export const FIELD_TYPES = {
+  text: {
+    label:        'Text',
+    defaultValue: '',
+    description:  'A short or long text string.',
+  },
+  number: {
+    label:        'Number',
+    defaultValue: 0,
+    description:  'An integer or decimal number.',
+  },
+  boolean: {
+    label:        'Boolean',
+    defaultValue: false,
+    description:  'A true/false toggle.',
+  },
+  date: {
+    label:        'Date',
+    defaultValue: () => new Date().toISOString().split('T')[0],
+    description:  'An ISO 8601 date string (YYYY-MM-DD).',
+  },
+  select: {
+    label:        'Select',
+    defaultValue: '',
+    description:  'One value from a predefined list of options.',
+  },
+  url: {
+    label:        'URL',
+    defaultValue: '',
+    description:  'A fully-qualified URL string.',
+  },
+  email: {
+    label:        'Email',
+    defaultValue: '',
+    description:  'An email address string.',
+  },
+  relation: {
+    label:        'Relation',
+    defaultValue: null,
+    description:  'A reference to a record in another collection (by record ID).',
+  },
+};
+
+// ─── Type Definitions (JSDoc) ─────────────────────────────────────────────────
+
+/**
+ * @typedef {Object} FieldDefinition
+ * @property {keyof FIELD_TYPES}  type         - The field's data type
+ * @property {string}             label        - Human-readable label
+ * @property {*}                  [default]    - Default value for new records
+ * @property {boolean}            [required]   - Whether the field is required
+ * @property {boolean}            [unique]     - Whether values must be unique
+ * @property {string[]}           [options]    - Allowed values for 'select' type
+ * @property {string}             [collection] - Target collection for 'relation' type
+ * @property {string}             [description]- AI context hint
+ */
+
+/**
+ * @typedef {Object} CollectionSchema
+ * @property {string}                          id          - Unique slug (e.g. 'tasks')
+ * @property {string}                          name        - Display name (e.g. 'Tasks')
+ * @property {string}                          [description]- Short description for AI
+ * @property {Object.<string, FieldDefinition>} fields     - Field definitions keyed by field ID
+ * @property {object}                          [meta]      - { createdAt, updatedAt }
+ */
+
+/**
+ * @typedef {Object} DataRecord
+ * @property {string} _id        - Auto-generated unique record ID
+ * @property {string} _createdAt - ISO timestamp
+ * @property {string} _updatedAt - ISO timestamp
+ * @property {*}      [field]    - Any field defined in the collection schema
+ */
+
+// ─── CollectionSchema Validation ─────────────────────────────────────────────
+
+/**
+ * Validate a CollectionSchema object.
+ * Returns { valid: true } or { valid: false, errors: string[] }.
+ *
+ * @param {object} schema
+ * @returns {{ valid: boolean, errors?: string[] }}
+ */
+export function validateCollectionSchema(schema) {
+  const errors = [];
+
+  if (!schema || typeof schema !== 'object') {
+    return { valid: false, errors: ['Schema must be an object.'] };
+  }
+
+  if (!schema.id || typeof schema.id !== 'string') {
+    errors.push('Schema must have a string "id".');
+  }
+
+  if (!schema.name || typeof schema.name !== 'string') {
+    errors.push('Schema must have a string "name".');
+  }
+
+  if (!schema.fields || typeof schema.fields !== 'object') {
+    errors.push('Schema must have a "fields" object.');
+  } else {
+    for (const [fieldId, field] of Object.entries(schema.fields)) {
+      if (!field.type) {
+        errors.push(`Field "${fieldId}" is missing a "type".`);
+      } else if (!FIELD_TYPES[field.type]) {
+        errors.push(`Field "${fieldId}" has unknown type "${field.type}". Valid types: ${Object.keys(FIELD_TYPES).join(', ')}.`);
+      }
+      if (field.type === 'select' && (!Array.isArray(field.options) || field.options.length === 0)) {
+        errors.push(`Field "${fieldId}" is type "select" but has no "options" array.`);
+      }
+      if (field.type === 'relation' && !field.collection) {
+        errors.push(`Field "${fieldId}" is type "relation" but has no "collection" reference.`);
+      }
+    }
+  }
+
+  return errors.length === 0 ? { valid: true } : { valid: false, errors };
+}
+
+// ─── DataStore ────────────────────────────────────────────────────────────────
+
+const DATA_STORAGE_KEY = 'nuvra-data-v1';
+
+/**
+ * The DataStore manages all collections and their records in memory,
+ * with automatic persistence to localStorage.
+ *
+ * Usage:
+ *   dataStore.createCollection({ id: 'tasks', name: 'Tasks', fields: { ... } });
+ *   dataStore.insert('tasks', { title: 'Buy milk', done: false });
+ *   dataStore.query('tasks');
+ *   dataStore.update('tasks', recordId, { done: true });
+ *   dataStore.delete('tasks', recordId);
