+    [/\breach us\b/,                    8],
+    [/\bsupport page\b/,                8],
+    [/\bhelp page\b/,                   7],
+  ],
+};
+
+const INDUSTRY_SIGNALS = {
+  tech:       [/\btech\b/, /\bsoftware\b/, /\bapi\b/, /\bcloud\b/, /\bdevops\b/, /\bai\b/, /\bml\b/, /\bcode\b/, /\bdeveloper\b/, /\bplatform\b/],
+  creative:   [/\bdesign\b/, /\bcreative\b/, /\bart\b/, /\bphoto\b/, /\bfilm\b/, /\bmusic\b/, /\bstudio\b/, /\bportfolio\b/, /\bbrand\b/],
+  finance:    [/\bfinance\b/, /\bfintech\b/, /\binvest\b/, /\bbank\b/, /\bpayment\b/, /\bcrypto\b/, /\baccounting\b/, /\btax\b/],
+  health:     [/\bhealth\b/, /\bmedical\b/, /\bwellness\b/, /\bfitness\b/, /\bdoctor\b/, /\bclinic\b/, /\btherapy\b/, /\bmental\b/],
+  education:  [/\beducation\b/, /\blearning\b/, /\bcourse\b/, /\bschool\b/, /\btutor\b/, /\btraining\b/, /\bacademy\b/, /\bskill\b/],
+  ecommerce:  [/\bshop\b/, /\bstore\b/, /\bproduct\b/, /\bmerch\b/, /\bfashion\b/, /\bfood\b/, /\bretail\b/],
+};
+
+const TONE_SIGNALS = {
+  playful:      [/\bfun\b/, /\bplayful\b/, /\bcute\b/, /\bkids\b/, /\bgame\b/, /\bcolorful\b/, /\bfriendly\b/, /\bcasual\b/],
+  minimal:      [/\bminimal\b/, /\bclean\b/, /\bsimple\b/, /\belegant\b/, /\bwhitespace\b/, /\bmodern\b/],
+  bold:         [/\bbold\b/, /\bimpact\b/, /\bpowerful\b/, /\baggressive\b/, /\bstrong\b/, /\bdramatic\b/],
+  professional: [/\bprofessional\b/, /\bcorporate\b/, /\bbusiness\b/, /\benterprise\b/, /\bformal\b/, /\btrust\b/],
+};
+
+const FEATURE_SIGNALS = {
+  pricing:      [/\bpricing\b/, /\bplan\b/, /\btier\b/, /\bsubscription\b/],
+  testimonials: [/\btestimonial\b/, /\breview\b/, /\bquote\b/, /\bsocial proof\b/, /\bcustomer\b/],
+  faq:          [/\bfaq\b/, /\bfrequently asked\b/, /\bquestion\b/],
+  newsletter:   [/\bnewsletter\b/, /\bsubscribe\b/, /\bemail list\b/],
+  team:         [/\bteam\b/, /\bstaff\b/, /\bpeople\b/, /\bfounder\b/, /\bemployee\b/],
+  'multi-page': [/\bmulti.?page\b/, /\bfull site\b/, /\bwhole site\b/, /\bwith pages\b/, /\bincluding.*page\b/, /\band.*page\b/, /\bsite with\b/, /\bwebsite with\b/],
+};
+
+// ─── Color & Font Palettes ────────────────────────────────────────────────────
+
+const INDUSTRY_COLORS = {
+  tech:       '#6366f1',  // Indigo
+  creative:   '#f97316',  // Orange
+  finance:    '#0ea5e9',  // Sky blue
+  health:     '#10b981',  // Emerald
+  education:  '#8b5cf6',  // Violet
+  ecommerce:  '#ec4899',  // Pink
+  general:    '#7c6af7',  // Nuvra purple
+};
+
+const TONE_COLORS = {
+  playful:      '#f59e0b',  // Amber
+  bold:         '#ef4444',  // Red
+  minimal:      '#111827',  // Near-black
+  professional: '#1d4ed8',  // Blue
+};
+
+const TONE_FONTS = {
+  playful:      "'Segoe UI', Tahoma, sans-serif",
+  minimal:      "'Inter', system-ui, sans-serif",
+  bold:         "'Arial Black', Impact, sans-serif",
+  professional: "Georgia, 'Times New Roman', serif",
+  default:      'system-ui, -apple-system, sans-serif',
+};
+
+// ─── Multi-page Pattern Detection ────────────────────────────────────────────
+
+/**
+ * Detects explicit multi-page requests in the prompt.
+ * Examples:
+ *   "a SaaS landing page with home, about, and contact"
+ *   "full website for a photographer"
+ *   "multi-page site for my startup"
+ *
+ * @param {string} p - lowercased prompt
+ * @returns {boolean}
+ */
+function _detectMultiPageIntent(p) {
+  // Explicit multi-page keywords
+  if (FEATURE_SIGNALS['multi-page'].some(r => r.test(p))) return true;
+
+  // Counting page names mentioned: if 2+ distinct page names appear, it's multi-page
+  const pageNames = ['home', 'about', 'contact', 'pricing', 'blog', 'portfolio', 'services', 'team', 'faq', 'work'];
+  const found = pageNames.filter(name => new RegExp(`\\b${name}\\b`).test(p));
+  if (found.length >= 2) return true;
+
+  // "full website" / "whole website" / "complete site"
+  if (/\b(full|whole|complete|entire)\s+(website|site|web)\b/.test(p)) return true;
+
+  return false;
+}
+
+// ─── Brand Extraction ─────────────────────────────────────────────────────────
+
+/**
+ * Attempts to extract a brand/product name from the prompt.
+ * Looks for patterns like "called X", "named X", "for X", "a X landing page".
+ *
+ * @param {string} prompt - original (not lowercased) prompt
+ * @returns {string} - extracted name, or a title-cased version of the first noun phrase
+ */
+function _extractBrand(prompt) {
+  // "called Foo" / "named Foo"
+  let m = prompt.match(/\b(?:called|named)\s+["']?([A-Z][A-Za-z0-9\s]{1,24}?)["']?(?:\s|$|,)/);
+  if (m) return m[1].trim();
+
+  // "for Foo" where Foo starts with a capital
+  m = prompt.match(/\bfor\s+([A-Z][A-Za-z0-9]{2,20})\b/);
+  if (m) return m[1].trim();
+
+  // "a Foo landing page" / "a Foo website"
+  m = prompt.match(/\ba\s+([A-Z][A-Za-z0-9\s]{2,20}?)\s+(?:landing page|website|app|platform|tool|blog|portfolio)\b/i);
+  if (m) return _titleCase(m[1].trim());
+
+  // Fall back: title-case the first 2-3 significant words
+  const stopWords = new Set(['a', 'an', 'the', 'for', 'with', 'and', 'or', 'of', 'in', 'on', 'to', 'build', 'create', 'make', 'generate', 'design', 'page', 'website', 'site']);
+  const words = prompt
+    .replace(/[^\w\s]/g, ' ')
+    .split(/\s+/)
+    .filter(w => w.length > 2 && !stopWords.has(w.toLowerCase()))
+    .slice(0, 3);
+
+  return words.length > 0
+    ? _titleCase(words.join(' '))
+    : 'My Project';
+}
+
+// ─── Scoring Engine ───────────────────────────────────────────────────────────
+
+/**
+ * Score a prompt against a signal table and return the top-scoring key.
+ *
+ * @param {string} p - lowercased prompt
+ * @param {object} signalTable - { key: [[regex, weight], ...] }
+ * @param {string} fallback
+ * @returns {{ winner: string, scores: object.<string, number> }}
+ */
+function _score(p, signalTable, fallback) {
+  const scores = {};
+
+  for (const [key, signals] of Object.entries(signalTable)) {
+    scores[key] = 0;
+    for (const [regex, weight] of signals) {
+      if (regex.test(p)) scores[key] += weight;
+    }
+  }
+
+  const winner = Object.entries(scores).reduce(
+    (best, [key, score]) => score > best[1] ? [key, score] : best,
+    [fallback, 0]
+  );
+
+  return { winner: winner[0], scores };
+}
+
+// ─── Helpers ──────────────────────────────────────────────────────────────────
+
+function _titleCase(str) {
+  return str
+    .split(/\s+/)
+    .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
+    .join(' ');
+}
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * @typedef {object} PromptIntent
+ * @property {string}   pageType     - Primary page type
+ * @property {string}   siteType     - 'single-page' | 'multi-page'
+ * @property {string}   brand        - Extracted brand/product name
+ * @property {string}   industry     - Inferred industry
+ * @property {string}   tone         - Inferred tone
+ * @property {string}   accentColor  - Hex color
+ * @property {string}   fontFamily   - CSS font stack
+ * @property {string}   theme        - 'dark' | 'light'
+ * @property {string[]} features     - Detected feature keywords
+ * @property {string[]} signals      - Human-readable explanation log
+ */
+
+/**
+ * Analyse a raw user prompt and return a structured `PromptIntent`.
+ *
+ * @param {string} prompt
+ * @returns {PromptIntent}
+ */
+export function analysePrompt(prompt) {
+  const p       = prompt.toLowerCase();
+  const signals = [];
+
+  // ── 1. Page type ────────────────────────────────────────────────────────────
+  const { winner: pageType, scores: pageScores } = _score(p, PAGE_TYPE_SIGNALS, 'generic');
+  const topScore = pageScores[pageType] ?? 0;
+  signals.push(`Page type: "${pageType}" (score: ${topScore})`);
+
+  // ── 2. Multi-page intent ────────────────────────────────────────────────────
+  const isMultiPage = _detectMultiPageIntent(p);
+  const siteType    = isMultiPage ? 'multi-page' : 'single-page';
+  signals.push(`Site type: "${siteType}"${isMultiPage ? ' (multi-page signals detected)' : ''}`);
+
+  // ── 3. Brand extraction ─────────────────────────────────────────────────────
+  const brand = _extractBrand(prompt);
+  signals.push(`Brand: "${brand}"`);
+
+  // ── 4. Industry ─────────────────────────────────────────────────────────────
+  const { winner: industry } = _score(p, Object.fromEntries(
+    Object.entries(INDUSTRY_SIGNALS).map(([k, regexes]) => [k, regexes.map(r => [r, 1])])
+  ), 'general');
+  signals.push(`Industry: "${industry}"`);
+
+  // ── 5. Tone ─────────────────────────────────────────────────────────────────
+  const { winner: tone } = _score(p, Object.fromEntries(
+    Object.entries(TONE_SIGNALS).map(([k, regexes]) => [k, regexes.map(r => [r, 1])])
+  ), 'professional');
+  signals.push(`Tone: "${tone}"`);
+
+  // ── 6. Features ─────────────────────────────────────────────────────────────
+  const features = Object.entries(FEATURE_SIGNALS)
+    .filter(([key, regexes]) => key !== 'multi-page' && regexes.some(r => r.test(p)))
+    .map(([key]) => key);
+  if (features.length > 0) signals.push(`Features detected: ${features.join(', ')}`);
+
+  // ── 7. Colors & fonts ───────────────────────────────────────────────────────
+  // Tone overrides industry color only when tone score is strong
+  const toneScore = Object.values(TONE_SIGNALS[tone] ?? []).length;
+  const accentColor = (toneScore >= 2 && TONE_COLORS[tone])
+    ? TONE_COLORS[tone]
+    : (INDUSTRY_COLORS[industry] ?? INDUSTRY_COLORS.general);
+
+  const fontFamily = TONE_FONTS[tone] ?? TONE_FONTS.default;
+
+  // ── 8. Theme ────────────────────────────────────────────────────────────────
+  const theme = /\bdark\b|\bdark mode\b|\bdark theme\b/.test(p) ? 'dark' : 'light';
+
+  signals.push(`Accent color: ${accentColor}, Font: ${fontFamily}, Theme: ${theme}`);
+
+  return {
+    pageType,
+    siteType,
+    brand,
+    industry,
+    tone,
+    accentColor,
+    fontFamily,
+    theme,
+    features,
+    signals,
+  };
+}
