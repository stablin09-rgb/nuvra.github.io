+
+// ─── Shared CSS ───────────────────────────────────────────────────────────────
+
+const _FORM_CSS = `
+.nv-form { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 24px; max-width: 560px; }
