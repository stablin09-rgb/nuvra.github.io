+++ b/src/ai/providers/localProvider.js
@@ -0,0 +1,190 @@
+/**
+ * Nuvra Builder — Local LLM Provider  (Phase 5A)
+ *
+ * Implements the ProviderBase contract for locally-running LLMs.
+ * Compatible with any server that exposes an OpenAI-compatible API, including:
+ *
+ *  - Ollama          (default: http://localhost:11434/v1)
+ *  - LM Studio       (default: http://localhost:1234/v1)
+ *  - LocalAI         (default: http://localhost:8080/v1)
+ *  - llama.cpp server (default: http://localhost:8080/v1)
+ *  - Jan             (default: http://localhost:1337/v1)
+ *  - Any OpenAI-compatible endpoint via custom `baseUrl`
+ *
+ * Key features:
+ *  - No API key required — local models are free to use.
+ *  - Connects to a user-specified `baseUrl` (defaults to Ollama).
+ *  - Detects available models from the local server's `/models` endpoint.
+ *  - Handles connection errors gracefully with clear, actionable messages.
+ *  - Disables rate limiting (no cost, no external quota).
+ *
+ * Design decisions:
+ *  - Local models vary widely in their ability to follow JSON instructions.
+ *    The schema repair logic in ProviderBase is especially important here.
+ *  - We do not use `response_format: json_object` by default because many
+ *    local servers do not support it. Instead, we rely on the system prompt
+ *    and the schema repair logic.
+ *  - The default `baseUrl` is Ollama's OpenAI-compatible endpoint.
+ *    Users can override this in AI Settings.
+ *  - Token counting is approximate since local servers may not report usage.
+ */
+
+'use strict';
+
+import { ProviderBase } from '../providerBase.js';
+
+/** Default base URL for Ollama's OpenAI-compatible API. */
+const DEFAULT_BASE_URL = 'http://localhost:11434/v1';
+
+export class LocalProvider extends ProviderBase {
+
+  constructor(config = {}) {
+    // Disable session token limits for local models (no cost)
+    super({
+      ...config,
+      maxSessionTokens: 999_999,
+      maxRequestsPerMin: 60,
+    });
+    this.baseUrl     = config.baseUrl    || DEFAULT_BASE_URL;
+    this.temperature = config.temperature ?? 0.7;
+  }
+
+  get id()           { return 'local'; }
+  get name()         { return 'Local LLM'; }
+  get defaultModel() { return 'llama3'; }
+
+  get supportedModels() {
+    // These are common Ollama model names. The UI will also offer
+    // a "Detect Models" button that queries the local server.
+    return [
+      'llama3',
+      'llama3:8b',
+      'llama3:70b',
+      'mistral',
+      'mistral:7b',
+      'mixtral',
+      'phi3',
+      'phi3:mini',
+      'gemma2',
+      'gemma2:9b',
+      'codellama',
+      'qwen2',
+    ];
+  }
+
+  /**
+   * Make a single Chat Completions request to the local server.
+   * @param {string} systemPrompt
+   * @param {string} userMessage
+   * @param {object} options
+   * @returns {Promise<{text: string, inputTokens: number, outputTokens: number}>}
+   */
+  async _callAPI(systemPrompt, userMessage, options = {}) {
+    const url = `${this.baseUrl}/chat/completions`;
+
+    let response;
+    try {
+      response = await fetch(url, {
+        method:  'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          model:       this.model,
+          temperature: this.temperature,
+          messages: [
+            { role: 'system', content: systemPrompt },
+            { role: 'user',   content: userMessage  },
+          ],
+        }),
+      });
+    } catch (networkErr) {
+      // Connection refused or DNS failure — the local server is not running
+      throw new Error(
+        `Could not connect to the local LLM server at ${this.baseUrl}. ` +
+        `Make sure Ollama (or your local server) is running. ` +
+        `Start it with: ollama serve`
+      );
+    }
+
+    if (!response.ok) {
+      const err = await response.json().catch(() => ({}));
+      const msg = err?.error?.message || response.statusText;
+
+      if (response.status === 404) {
+        throw new Error(
+          `Model "${this.model}" not found on the local server. ` +
+          `Pull it with: ollama pull ${this.model}`
+        );
+      }
+      throw new Error(`Local LLM error (${response.status}): ${msg}`);
+    }
+
+    const data = await response.json();
+
+    // Local servers may not report token usage; estimate if missing
+    const inputTokens  = data.usage?.prompt_tokens     ?? _estimateTokens(systemPrompt + userMessage);
+    const outputTokens = data.usage?.completion_tokens ?? _estimateTokens(data.choices?.[0]?.message?.content || '');
+
+    return {
+      text:         data.choices?.[0]?.message?.content || '',
+      inputTokens,
+      outputTokens,
+    };
+  }
+}
+
+// ─── Model Detection ──────────────────────────────────────────────────────────
+
+/**
+ * Query the local server's /models endpoint to get available models.
+ * Returns an array of model names, or an empty array on failure.
+ *
+ * @param {string} baseUrl
+ * @returns {Promise<string[]>}
+ */
+export async function detectLocalModels(baseUrl = DEFAULT_BASE_URL) {
+  try {
+    const response = await fetch(`${baseUrl}/models`, {
+      signal: AbortSignal.timeout(3000), // 3 second timeout
+    });
+
+    if (!response.ok) return [];
+
+    const data = await response.json();
+
+    // OpenAI format: { data: [{ id: 'model-name' }] }
+    if (Array.isArray(data.data)) {
+      return data.data.map((m) => m.id || m.name).filter(Boolean);
+    }
+
+    // Ollama format: { models: [{ name: 'model-name' }] }
+    if (Array.isArray(data.models)) {
+      return data.models.map((m) => m.name || m.id).filter(Boolean);
+    }
+
+    return [];
+  } catch {
+    return [];
+  }
+}
+
+/**
+ * Check if a local LLM server is reachable.
+ * @param {string} baseUrl
+ * @returns {Promise<boolean>}
+ */
+export async function pingLocalServer(baseUrl = DEFAULT_BASE_URL) {
+  try {
+    const response = await fetch(`${baseUrl}/models`, {
+      signal: AbortSignal.timeout(2000),
+    });
+    return response.ok;
+  } catch {
+    return false;
+  }
+}
+
+// ─── Utilities ────────────────────────────────────────────────────────────────
+
+function _estimateTokens(text) {
+  return Math.ceil((text || '').length / 4);
+}
diff --git a/src/ai/providers/openaiProvider.js b/src/ai/providers/openaiProvider.js
new file mode 100644
index 0000000..eb13def
--- /dev/null
+++ b/src/ai/providers/openaiProvider.js
@@ -0,0 +1,212 @@
+/**
+ * Nuvra Builder — OpenAI Provider  (Phase 5A)
+ *
+ * Implements the ProviderBase contract for OpenAI's Chat Completions API.
+ *
+ * Key features:
+ *  - Uses `response_format: { type: "json_object" }` to enforce JSON-only output.
+ *    This eliminates the need for markdown stripping on supported models.
+ *  - Supports GPT-4o, GPT-4o-mini, GPT-4-turbo, and GPT-3.5-turbo.
+ *  - Supports OpenAI-compatible endpoints (e.g., Azure OpenAI, LiteLLM, Together AI)
+ *    via the `baseUrl` config option.
+ *  - Implements `_generateSite()` for true multi-page generation using a single
+ *    API call with the site system prompt.
+ *  - Reports exact token counts from the API response for accurate budget tracking.
+ *
+ * Design decisions:
+ *  - `response_format: json_object` is only supported on gpt-4o, gpt-4o-mini,
+ *    and gpt-3.5-turbo-1106+. For other models, we fall back to text mode and
+ *    rely on the schema repair logic in ProviderBase.
+ *  - The `temperature` is set to 0.7 for a good balance of creativity and
+ *    consistency. This can be overridden via `config.temperature`.
+ */
+
+'use strict';
+
+import { ProviderBase }          from '../providerBase.js';
+import { buildSystemPrompt,
+         buildSiteSystemPrompt,
+         buildUserMessage,
+         buildSiteUserMessage }  from '../promptBuilder.js';
+
+// Models that support JSON mode (response_format: json_object)
+const JSON_MODE_MODELS = [
+  'gpt-4o',
+  'gpt-4o-mini',
+  'gpt-4-turbo',
+  'gpt-3.5-turbo-1106',
+  'gpt-3.5-turbo-0125',
+];
+
+export class OpenAIProvider extends ProviderBase {
+
+  constructor(config = {}) {
+    super(config);
+    this.baseUrl     = config.baseUrl    || 'https://api.openai.com/v1';
+    this.temperature = config.temperature ?? 0.7;
+  }
+
+  get id()           { return 'openai'; }
+  get name()         { return 'OpenAI'; }
+  get defaultModel() { return 'gpt-4o-mini'; }
+
+  get supportedModels() {
+    return [
+      'gpt-4o-mini',
+      'gpt-4o',
+      'gpt-4-turbo',
+      'gpt-3.5-turbo',
+    ];
+  }
+
+  /**
+   * Make a single Chat Completions request.
+   * @param {string} systemPrompt
+   * @param {string} userMessage
+   * @param {object} options
+   * @returns {Promise<{text: string, inputTokens: number, outputTokens: number}>}
+   */
+  async _callAPI(systemPrompt, userMessage, options = {}) {
+    if (!this.config.apiKey) {
+      throw new Error(
+        'OpenAI API key is not configured. ' +
+        'Open AI Settings and enter your key.'
+      );
+    }
+
+    const supportsJsonMode = JSON_MODE_MODELS.some((m) =>
+      this.model.toLowerCase().includes(m)
+    );
+
+    const body = {
+      model:       this.model,
+      temperature: this.temperature,
+      messages: [
+        { role: 'system', content: systemPrompt },
+        { role: 'user',   content: userMessage  },
+      ],
+    };
+
+    if (supportsJsonMode) {
+      body.response_format = { type: 'json_object' };
+    }
+
+    const response = await fetch(`${this.baseUrl}/chat/completions`, {
+      method:  'POST',
+      headers: {
+        'Content-Type':  'application/json',
+        'Authorization': `Bearer ${this.config.apiKey}`,
+      },
+      body: JSON.stringify(body),
+    });
+
+    if (!response.ok) {
+      const err = await response.json().catch(() => ({}));
+      const msg = err?.error?.message || response.statusText;
+
+      // Provide user-friendly messages for common errors
+      if (response.status === 401) throw new Error('Invalid OpenAI API key. Please check your key in AI Settings.');
+      if (response.status === 429) throw new Error('OpenAI rate limit exceeded. Please wait a moment and try again.');
+      if (response.status === 402) throw new Error('OpenAI quota exceeded. Please check your billing at platform.openai.com.');
+      throw new Error(`OpenAI error (${response.status}): ${msg}`);
+    }
+
+    const data = await response.json();
+
+    return {
+      text:         data.choices?.[0]?.message?.content || '',
+      inputTokens:  data.usage?.prompt_tokens     ?? 0,
+      outputTokens: data.usage?.completion_tokens ?? 0,
+    };
+  }
+
+  /**
+   * Multi-page site generation using a single API call.
+   * Returns an array of page results.
+   *
+   * @param {string} prompt
+   * @param {object} options
+   * @returns {Promise<Array<{pageId, pageName, schema, meta}>>}
+   */
+  async _generateSite(prompt, options = {}) {
+    if (!this.config.apiKey) {
+      throw new Error('OpenAI API key is not configured. Open AI Settings and enter your key.');
+    }
+
+    const systemPrompt = buildSiteSystemPrompt(options);
+    const userMessage  = buildSiteUserMessage(prompt);
+
+    const { text, inputTokens, outputTokens } = await this._callAPI(
+      systemPrompt,
+      userMessage,
+      options
+    );
+
+    // Record usage
+    const { sessionBudget } = await import('../providerBase.js');
+    sessionBudget.recordUsage(this.id, this.model, inputTokens, outputTokens);
+
+    // Parse the array of page schemas
+    const pages = _parseSiteResponse(text);
+
+    return pages.map((page, index) => ({
+      pageId:   page.pageId   || `page-${index + 1}`,
+      pageName: page.pageName || `Page ${index + 1}`,
+      schema:   page.schema,
+      meta: {
+        provider:     this.id,
+        model:        this.model,
+        tokens:       Math.round((inputTokens + outputTokens) / pages.length),
+        inputTokens:  Math.round(inputTokens  / pages.length),
+        outputTokens: Math.round(outputTokens / pages.length),
+        pageIndex:    index,
+      },
+    }));
+  }
+}
+
+// ─── Site Response Parser ─────────────────────────────────────────────────────
+
+/**
+ * Parse the LLM's response for a multi-page site request.
+ * Handles both array responses and single-object responses.
+ *
+ * @param {string} raw
+ * @returns {Array<{pageId, pageName, schema}>}
+ */
+function _parseSiteResponse(raw) {
+  if (!raw) throw new Error('OpenAI returned an empty site response.');
+
+  let text = raw.trim();
+
+  // Strip markdown code fences
+  if (text.startsWith('```')) {
+    text = text.replace(/^```(?:json)?\s*\n?/, '').replace(/\n?\s*```$/, '').trim();
+  }
+
+  let parsed;
+  try {
+    parsed = JSON.parse(text);
+  } catch {
+    // Try to extract a JSON array
+    const match = text.match(/\[[\s\S]*\]/);
+    if (match) {
+      try { parsed = JSON.parse(match[0]); } catch { /* fall through */ }
+    }
+  }
+
+  if (!parsed) {
+    throw new Error('Could not parse OpenAI site response as JSON.');
+  }
+
+  // Normalise: if the model returned a single object instead of an array
+  if (!Array.isArray(parsed)) {
+    if (parsed.pages && Array.isArray(parsed.pages)) {
+      parsed = parsed.pages;
+    } else {
+      parsed = [{ pageId: 'home', pageName: 'Home', schema: parsed }];
+    }
+  }
+
+  return parsed;
+}
