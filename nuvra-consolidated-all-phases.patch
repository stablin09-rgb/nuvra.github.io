+/**
+ * Nuvra Builder — Prompt Analyser
+ *
+ * Extracts structured intent and signals from a raw user prompt.
+ * This replaces the single-regex classifier from Phase 2 with a
+ * multi-dimensional analysis that produces a rich `PromptIntent` object.
+ *
+ * The `PromptIntent` is consumed by the `SitePlanner` to decide what pages
+ * to generate and which sections to include on each page.
+ *
+ * Design philosophy:
+ *  - No external dependencies. Pure deterministic logic.
+ *  - Scores are additive: multiple signals reinforce each other.
+ *  - All decisions are transparent and traceable (see `signals` array).
+ *  - A real LLM provider bypasses this module entirely — it does its own
+ *    understanding. This module exists solely to make the mock provider
+ *    feel intelligent.
+ *
+ * ─── PromptIntent shape ───────────────────────────────────────────────────────
+ * {
+ *   pageType:     string,   // Primary page type: 'saas-landing' | 'portfolio' | 'blog' | 'ecommerce' | 'dashboard' | 'agency' | 'app-homepage' | 'pricing' | 'about' | 'contact' | 'generic'
+ *   siteType:     string,   // 'single-page' | 'multi-page'
+ *   brand:        string,   // Extracted brand/product name
+ *   industry:     string,   // Inferred industry: 'tech' | 'creative' | 'finance' | 'health' | 'education' | 'ecommerce' | 'general'
+ *   tone:         string,   // 'professional' | 'playful' | 'minimal' | 'bold'
+ *   accentColor:  string,   // Hex color inferred from industry/tone
+ *   fontFamily:   string,   // Font stack inferred from tone
+ *   theme:        string,   // 'dark' | 'light'
+ *   features:     string[], // Detected feature keywords (e.g. ['pricing', 'testimonials', 'faq'])
+ *   signals:      string[], // Explanation log — what signals were detected and why
+ * }
+ */
+
+'use strict';
+
+// ─── Signal Tables ────────────────────────────────────────────────────────────
+
+/**
+ * Each entry is a [regex, weight] pair.
+ * Higher weight = stronger signal for that page type.
+ */
+const PAGE_TYPE_SIGNALS = {
