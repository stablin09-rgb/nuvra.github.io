+++ b/src/app-components/appComponents.js
@@ -0,0 +1,594 @@
+/**
+ * Nuvra Builder — App Components Registry  (Phase 3)
+ *
+ * Defines the schema-driven app components that power dashboards, CRUD tools,
+ * and internal tools. Each component is described by an `AppComponentDef`
+ * that includes its schema, HTML template, CSS, and the state keys it reads/writes.
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────┐
+ * │  Component Types                                                         │
+ * │                                                                          │
+ * │  FORM COMPONENTS      data-form, data-field-text, data-field-select,    │
+ * │                        data-field-boolean                                │
+ * │                                                                          │
+ * │  LIST / TABLE         data-table, data-list, data-kanban-board          │
+ * │                                                                          │
+ * │  DISPLAY              stat-card, data-badge, data-detail-view           │
+ * │                                                                          │
+ * │  CONDITIONAL          show-if, hide-if, loading-gate                    │
+ * │                                                                          │
+ * │  LAYOUT               app-sidebar, app-header, app-content-area         │
+ * └──────────────────────────────────────────────────────────────────────────┘
+ *
+ * Design decisions:
+ *  - All components are schema-first. The `config` object (stored in the
+ *    project JSON) drives both the rendered HTML and the runtime behaviour.
+ *  - Components declare which `stateKeys` they read and write, making
+ *    data-flow explicit and AI-generatable.
+ *  - The `render(config)` function produces static HTML for the GrapesJS
+ *    canvas. The `AppRuntime` (runtime/appRuntime.js) then hydrates the
+ *    rendered HTML with live state and action bindings.
+ *  - Adding a new component = adding one entry to APP_COMPONENT_DEFS.
+ *    No other files need to change.
+ */
+
+'use strict';
+
+// ─── Type Definitions ─────────────────────────────────────────────────────────
+
+/**
+ * @typedef {Object} AppComponentDef
+ * @property {string}   id          - Unique component type ID
+ * @property {string}   name        - Human-readable name
+ * @property {string}   category    - UI grouping: 'Form' | 'Data' | 'Display' | 'Layout' | 'Logic'
+ * @property {string}   description - Short description for AI context
+ * @property {object}   configSchema - JSON schema for the component's config object
+ * @property {string[]} stateReads  - State keys this component reads
+ * @property {string[]} stateWrites - State keys this component writes
+ * @property {string[]} actions     - Action IDs this component can trigger
+ * @property {Function} render      - (config: object) => { html: string, css: string }
+ */
+
+// ─── Component Definitions ────────────────────────────────────────────────────
+
+/** @type {AppComponentDef[]} */
+const APP_COMPONENT_DEFS = [
+
+  // ── FORM COMPONENTS ────────────────────────────────────────────────────────
+
+  {
+    id:          'data-form',
+    name:        'Data Form',
+    category:    'Form',
+    description: 'A form that creates or updates a record in a collection. Bound to a CollectionSchema.',
+    configSchema: {
+      collectionId: { type: 'string',  required: true,  description: 'The collection this form writes to' },
+      mode:         { type: 'string',  default: 'create', options: ['create', 'update'], description: 'Create a new record or update an existing one' },
+      title:        { type: 'string',  default: 'Add Record', description: 'Form heading' },
+      submitLabel:  { type: 'string',  default: 'Save', description: 'Submit button label' },
+      cancelLabel:  { type: 'string',  default: 'Cancel', description: 'Cancel button label (leave empty to hide)' },
+      fields:       { type: 'array',   default: [],   description: 'Ordered list of field IDs to show. Empty = show all.' },
+    },
+    stateReads:  ['selectedId'],
+    stateWrites: ['isLoading', 'errorMessage'],
+    actions:     ['submit', 'reset'],
+    render(config) {
+      const title       = config.title       || 'Add Record';
+      const submitLabel = config.submitLabel || 'Save';
+      const cancelLabel = config.cancelLabel || '';
+      const collection  = config.collectionId || 'your-collection';
+
+      const html = `
+<div class="nv-form" data-nv-component="data-form" data-nv-collection="${collection}" data-nv-mode="${config.mode || 'create'}">
+  <div class="nv-form-header">
+    <h3 class="nv-form-title">${title}</h3>
+  </div>
+  <div class="nv-form-body">
+    <div class="nv-form-fields">
+      <!-- Fields are injected here by the AppRuntime based on the collection schema -->
+      <div class="nv-form-field-placeholder">
+        <span>Form fields will appear here at runtime</span>
+        <small>Bound to collection: <code>${collection}</code></small>
+      </div>
+    </div>
+    <div class="nv-form-error" data-nv-bind="errorMessage" style="display:none;"></div>
+  </div>
+  <div class="nv-form-footer">
+    ${cancelLabel ? `<button class="nv-btn" data-nv-action="reset">${cancelLabel}</button>` : ''}
+    <button class="nv-btn primary" data-nv-action="submit" data-nv-loading-bind="isLoading">
+      <span class="nv-btn-label">${submitLabel}</span>
+      <span class="nv-btn-spinner" style="display:none;">…</span>
+    </button>
+  </div>
+</div>`;
+
+      return { html, css: _FORM_CSS };
+    },
+  },
+
+  // ── TABLE COMPONENT ────────────────────────────────────────────────────────
+
+  {
+    id:          'data-table',
+    name:        'Data Table',
+    category:    'Data',
+    description: 'A sortable, paginated table that displays records from a collection.',
+    configSchema: {
+      collectionId: { type: 'string',  required: true,  description: 'The collection to display' },
+      title:        { type: 'string',  default: '',     description: 'Optional table heading' },
+      columns:      { type: 'array',   default: [],     description: 'Field IDs to show as columns. Empty = show all.' },
+      pageSize:     { type: 'number',  default: 10,     description: 'Rows per page' },
+      searchable:   { type: 'boolean', default: true,   description: 'Show a search/filter input' },
+      sortable:     { type: 'boolean', default: true,   description: 'Allow column header sorting' },
+      showActions:  { type: 'boolean', default: true,   description: 'Show Edit and Delete action buttons' },
+      emptyMessage: { type: 'string',  default: 'No records found.', description: 'Message when the table is empty' },
+    },
+    stateReads:  ['searchQuery', 'sortBy', 'sortDir', 'currentPage', 'pageSize'],
+    stateWrites: ['selectedId', 'isLoading'],
+    actions:     ['fetch', 'delete', 'select'],
+    render(config) {
+      const title      = config.title      || '';
+      const collection = config.collectionId || 'your-collection';
+      const emptyMsg   = config.emptyMessage || 'No records found.';
+      const pageSize   = config.pageSize   || 10;
+
+      const html = `
+<div class="nv-table-wrapper" data-nv-component="data-table" data-nv-collection="${collection}" data-nv-page-size="${pageSize}">
+  ${title ? `<div class="nv-table-header"><h3 class="nv-table-title">${title}</h3></div>` : ''}
+  ${config.searchable !== false ? `
+  <div class="nv-table-toolbar">
+    <input class="nv-search-input" type="text" placeholder="Search…" data-nv-bind-write="searchQuery" />
+  </div>` : ''}
+  <div class="nv-table-scroll">
+    <table class="nv-table">
+      <thead class="nv-table-head">
+        <tr>
+          <!-- Column headers injected by AppRuntime -->
+          <th class="nv-th nv-th-placeholder" colspan="99">
+            Table columns will appear here at runtime
+            <br/><small>Bound to collection: <code>${collection}</code></small>
+          </th>
+        </tr>
+      </thead>
+      <tbody class="nv-table-body" data-nv-empty-message="${emptyMsg}">
+        <!-- Rows injected by AppRuntime -->
+      </tbody>
+    </table>
+  </div>
+  <div class="nv-table-footer">
+    <span class="nv-table-count" data-nv-bind="data">0 records</span>
+    <div class="nv-pagination">
+      <button class="nv-btn sm" data-nv-action="prev-page">&#8592;</button>
+      <span class="nv-page-indicator" data-nv-bind="currentPage">1</span>
+      <button class="nv-btn sm" data-nv-action="next-page">&#8594;</button>
+    </div>
+  </div>
+</div>`;
+
+      return { html, css: _TABLE_CSS };
+    },
+  },
+
+  // ── LIST COMPONENT ─────────────────────────────────────────────────────────
+
+  {
+    id:          'data-list',
+    name:        'Data List',
+    category:    'Data',
+    description: 'A card-based list view of records from a collection.',
+    configSchema: {
+      collectionId:  { type: 'string',  required: true,  description: 'The collection to display' },
+      title:         { type: 'string',  default: '',     description: 'Optional list heading' },
+      displayField:  { type: 'string',  default: 'name', description: 'Primary field to show in each card' },
+      secondaryField:{ type: 'string',  default: '',     description: 'Secondary field to show below the primary' },
+      badgeField:    { type: 'string',  default: '',     description: 'Field to show as a status badge' },
+      emptyMessage:  { type: 'string',  default: 'No items yet.', description: 'Message when the list is empty' },
+      showAddButton: { type: 'boolean', default: true,   description: 'Show an Add button at the top' },
+    },
+    stateReads:  ['data', 'isLoading'],
+    stateWrites: ['selectedId'],
+    actions:     ['fetch', 'select', 'delete'],
+    render(config) {
+      const title      = config.title      || '';
+      const collection = config.collectionId || 'your-collection';
+      const emptyMsg   = config.emptyMessage || 'No items yet.';
+
+      const html = `
+<div class="nv-list-wrapper" data-nv-component="data-list" data-nv-collection="${collection}">
+  ${title || config.showAddButton !== false ? `
+  <div class="nv-list-header">
+    ${title ? `<h3 class="nv-list-title">${title}</h3>` : ''}
+    ${config.showAddButton !== false ? `<button class="nv-btn primary sm" data-nv-action="add">+ Add</button>` : ''}
+  </div>` : ''}
+  <div class="nv-list-body" data-nv-empty-message="${emptyMsg}">
+    <!-- List items injected by AppRuntime -->
+    <div class="nv-list-placeholder">
+      <span>List items will appear here at runtime</span>
+      <small>Bound to collection: <code>${collection}</code></small>
+    </div>
+  </div>
+</div>`;
+
+      return { html, css: _LIST_CSS };
+    },
+  },
+
+  // ── STAT CARD ──────────────────────────────────────────────────────────────
+
+  {
+    id:          'stat-display',
+    name:        'Stat Display',
+    category:    'Display',
+    description: 'Shows a KPI metric computed from a collection (count, sum, average).',
+    configSchema: {
+      collectionId: { type: 'string',  required: true,  description: 'The collection to aggregate' },
+      label:        { type: 'string',  default: 'Total Records', description: 'Metric label' },
+      aggregation:  { type: 'string',  default: 'count', options: ['count', 'sum', 'avg', 'min', 'max'], description: 'Aggregation type' },
+      field:        { type: 'string',  default: '',     description: 'Field to aggregate (required for sum/avg/min/max)' },
+      filter:       { type: 'object',  default: null,   description: 'Optional filter: { fieldId: value }' },
+      prefix:       { type: 'string',  default: '',     description: 'Value prefix (e.g. "$")' },
+      suffix:       { type: 'string',  default: '',     description: 'Value suffix (e.g. "%")' },
+      trendField:   { type: 'string',  default: '',     description: 'Field to compute trend from' },
+    },
+    stateReads:  ['data'],
+    stateWrites: [],
+    actions:     ['fetch'],
+    render(config) {
+      const label  = config.label  || 'Total Records';
+      const prefix = config.prefix || '';
+      const suffix = config.suffix || '';
+
+      const html = `
+<div class="nv-stat-display" data-nv-component="stat-display" data-nv-collection="${config.collectionId || ''}" data-nv-aggregation="${config.aggregation || 'count'}">
+  <div class="nv-stat-label">${label}</div>
+  <div class="nv-stat-value" data-nv-bind="data">${prefix}—${suffix}</div>
+  <div class="nv-stat-trend" data-nv-bind="trend" style="display:none;"></div>
+</div>`;
+
+      return { html, css: _STAT_CSS };
+    },
+  },
+
+  // ── DETAIL VIEW ────────────────────────────────────────────────────────────
+
+  {
+    id:          'data-detail',
+    name:        'Detail View',
+    category:    'Display',
+    description: 'Shows all fields of a single selected record.',
+    configSchema: {
+      collectionId: { type: 'string',  required: true,  description: 'The collection to read from' },
+      title:        { type: 'string',  default: 'Record Details', description: 'Panel heading' },
+      fields:       { type: 'array',   default: [],     description: 'Field IDs to show. Empty = show all.' },
+      showEditButton:  { type: 'boolean', default: true, description: 'Show an Edit button' },
+      showDeleteButton:{ type: 'boolean', default: true, description: 'Show a Delete button' },
+    },
+    stateReads:  ['selectedId', 'data'],
+    stateWrites: ['isLoading'],
+    actions:     ['fetch', 'edit', 'delete'],
+    render(config) {
+      const title = config.title || 'Record Details';
+
+      const html = `
+<div class="nv-detail-view" data-nv-component="data-detail" data-nv-collection="${config.collectionId || ''}">
+  <div class="nv-detail-header">
+    <h3 class="nv-detail-title">${title}</h3>
+    <div class="nv-detail-actions">
+      ${config.showEditButton   !== false ? `<button class="nv-btn sm" data-nv-action="edit">Edit</button>` : ''}
+      ${config.showDeleteButton !== false ? `<button class="nv-btn sm danger" data-nv-action="delete">Delete</button>` : ''}
+    </div>
+  </div>
+  <div class="nv-detail-body" data-nv-empty-message="Select a record to view details.">
+    <!-- Fields injected by AppRuntime -->
+    <div class="nv-detail-placeholder">Select a record to view details.</div>
+  </div>
+</div>`;
+
+      return { html, css: _DETAIL_CSS };
+    },
+  },
+
+  // ── CONDITIONAL RENDERING ──────────────────────────────────────────────────
+
+  {
+    id:          'show-if',
+    name:        'Show If',
+    category:    'Logic',
+    description: 'Wraps content and shows it only when a state condition is true.',
+    configSchema: {
+      stateKey:   { type: 'string',  required: true, description: 'The state key to evaluate' },
+      condition:  { type: 'string',  default: 'truthy', options: ['truthy', 'falsy', 'equals', 'not-equals', 'gt', 'lt'], description: 'Condition type' },
+      value:      { type: 'string',  default: '',    description: 'Value to compare against (for equals/not-equals/gt/lt)' },
+      stateScope: { type: 'string',  default: 'page', options: ['app', 'page', 'component'], description: 'Which state tier to read from' },
+    },
+    stateReads:  ['*'],
+    stateWrites: [],
+    actions:     [],
+    render(config) {
+      const stateKey   = config.stateKey   || 'isLoading';
+      const condition  = config.condition  || 'truthy';
+      const stateScope = config.stateScope || 'page';
+
+      const html = `
+<div class="nv-show-if" data-nv-component="show-if" data-nv-state-key="${stateKey}" data-nv-condition="${condition}" data-nv-value="${config.value || ''}" data-nv-scope="${stateScope}">
+  <!-- Drop content here. It will be shown when: ${stateScope}.${stateKey} is ${condition} -->
+  <div class="nv-logic-placeholder">
+    <span>Show If: <code>${stateScope}.${stateKey}</code> is <strong>${condition}</strong></span>
+    <small>Drop components inside this block.</small>
+  </div>
+</div>`;
+
+      return { html, css: _LOGIC_CSS };
+    },
+  },
+
+  {
+    id:          'loading-gate',
+    name:        'Loading Gate',
+    category:    'Logic',
+    description: 'Shows a spinner while a state key is true, then reveals content.',
+    configSchema: {
