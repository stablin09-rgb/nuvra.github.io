diff --git a/src/actions/actionEngine.js b/src/actions/actionEngine.js
new file mode 100644
index 0000000..c078cf7
--- /dev/null
+++ b/src/actions/actionEngine.js
@@ -0,0 +1,546 @@
+/**
+ * Nuvra Builder — Action Engine  (Phase 3)
+ *
+ * Defines and executes the lightweight actions that power Nuvra app pages.
+ * Actions are the "verbs" of the app builder — they describe what happens
+ * when a user interacts with a component.
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────┐
+ * │  Built-in Actions                                                        │
+ * │                                                                          │
+ * │  DATA ACTIONS     submit, fetch, update, delete, reset                  │
+ * │  NAV ACTIONS      navigate, open-modal, close-modal                     │
+ * │  STATE ACTIONS    set-state, toggle-state, increment-state              │
+ * │  UTIL ACTIONS     copy-to-clipboard, download, show-toast               │
+ * └──────────────────────────────────────────────────────────────────────────┘
+ *
+ * Design decisions:
+ *  - Actions are schema-driven. Each action is described by an `ActionDef`
+ *    with a `config` schema, making them AI-generatable and serializable.
+ *  - Actions are executed by the `ActionEngine.run(actionId, context)` method.
+ *    The `context` provides the current state, the event, and the component.
+ *  - Actions are bound to DOM elements via `data-nv-action` attributes.
+ *    The `AppRuntime` scans the canvas for these attributes and wires them up.
+ *  - Custom actions can be registered via `registerAction()`.
+ *  - Actions are intentionally synchronous or async — the engine handles both.
+ *  - No workflow engine yet. Complex multi-step flows will be Phase 4.
+ */
+
+'use strict';
+
+import { dataStore }    from '../data/dataModel.js';
+import { getPageState, appState } from '../state/stateManager.js';
+import { showToast }    from '../utils/helpers.js';
+
+// ─── Type Definitions ─────────────────────────────────────────────────────────
+
+/**
+ * @typedef {Object} ActionContext
+ * @property {string}      actionId     - The action being executed
+ * @property {HTMLElement} element      - The element that triggered the action
+ * @property {string}      pageId       - The current page ID
+ * @property {string}      [instanceId] - The component instance ID
+ * @property {object}      config       - The action's config (from the component schema)
+ * @property {Event}       [event]      - The original DOM event
+ */
+
+/**
+ * @typedef {Object} ActionDef
+ * @property {string}   id          - Unique action ID
+ * @property {string}   name        - Human-readable name
+ * @property {string}   category    - 'Data' | 'Navigation' | 'State' | 'Utility'
+ * @property {string}   description - Short description for AI context
+ * @property {object}   configSchema - JSON schema for the action's config
+ * @property {Function} execute     - async (context: ActionContext) => void
+ */
+
+// ─── Action Definitions ───────────────────────────────────────────────────────
+
+/** @type {Map<string, ActionDef>} */
+const _actions = new Map();
+
+/**
+ * Register a new action definition.
+ * Throws if an action with the same ID already exists.
+ *
+ * @param {ActionDef} def
+ */
+export function registerAction(def) {
+  if (_actions.has(def.id)) {
+    throw new Error(`[ActionEngine] Action "${def.id}" is already registered.`);
+  }
+  _actions.set(def.id, def);
+}
+
+// ─── Built-in Actions ─────────────────────────────────────────────────────────
+
+// ── DATA: submit ──────────────────────────────────────────────────────────────
+
+registerAction({
+  id:          'submit',
+  name:        'Submit Form',
+  category:    'Data',
+  description: 'Reads form field values and creates or updates a record in a collection.',
+  configSchema: {
+    collectionId: { type: 'string',  required: true,  description: 'Target collection' },
+    mode:         { type: 'string',  default: 'create', options: ['create', 'update'] },
+    successMessage: { type: 'string', default: 'Saved successfully.' },
+    errorMessage:   { type: 'string', default: 'Failed to save. Please try again.' },
+    onSuccess:    { type: 'string',  default: '',     description: 'Action ID to run after success' },
+    resetOnSuccess: { type: 'boolean', default: true, description: 'Clear the form after a successful create' },
+  },
+  async execute(ctx) {
+    const { config, element, pageId } = ctx;
+    const pageState = getPageState(pageId);
+
+    pageState.set('isLoading', true);
+    pageState.set('errorMessage', null);
+
+    try {
+      // Collect form data from all [data-nv-field] inputs inside the form
+      const form = element.closest('[data-nv-component="data-form"]') || element;
+      const inputs = form.querySelectorAll('[data-nv-field]');
+      const data = {};
+      inputs.forEach((input) => {
+        const field = input.dataset.nvField;
+        data[field] = input.type === 'checkbox' ? input.checked : input.value;
+      });
+
+      if (config.mode === 'update') {
+        const selectedId = pageState.get('selectedId');
+        if (!selectedId) throw new Error('No record selected for update.');
+        dataStore.update(config.collectionId, selectedId, data);
+      } else {
+        dataStore.insert(config.collectionId, data);
+      }
+
+      showToast(config.successMessage || 'Saved successfully.', 'success');
+
+      if (config.resetOnSuccess !== false && config.mode === 'create') {
+        form.querySelectorAll('[data-nv-field]').forEach((input) => {
+          if (input.type === 'checkbox') input.checked = false;
+          else input.value = '';
+        });
+      }
+
+      // Trigger a follow-up action if configured
+      if (config.onSuccess) {
+        await ActionEngine.run(config.onSuccess, { ...ctx, config: {} });
+      }
+    } catch (err) {
+      pageState.set('errorMessage', err.message || config.errorMessage || 'An error occurred.');
+      showToast(err.message || config.errorMessage || 'Failed to save.', 'error');
+    } finally {
+      pageState.set('isLoading', false);
+    }
+  },
+});
+
+// ── DATA: fetch ───────────────────────────────────────────────────────────────
+
+registerAction({
+  id:          'fetch',
+  name:        'Fetch Records',
+  category:    'Data',
+  description: 'Loads records from a collection into a component\'s state.',
+  configSchema: {
+    collectionId: { type: 'string',  required: true,  description: 'Source collection' },
+    filter:       { type: 'object',  default: null,   description: 'Optional filter object' },
+    sortBy:       { type: 'string',  default: null,   description: 'Field to sort by' },
+    sortDir:      { type: 'string',  default: 'asc',  description: 'Sort direction' },
+    limit:        { type: 'number',  default: null,   description: 'Max records to fetch' },
+  },
+  async execute(ctx) {
+    const { config, pageId, instanceId } = ctx;
+    const pageState = getPageState(pageId);
+
+    pageState.set('isLoading', true);
+
+    try {
+      const queryOptions = {
+        filter:  config.filter  || null,
+        sortBy:  pageState.get('sortBy')  || config.sortBy  || null,
+        sortDir: pageState.get('sortDir') || config.sortDir || 'asc',
+        limit:   config.limit   || pageState.get('pageSize') || null,
+        offset:  ((pageState.get('currentPage') || 1) - 1) * (pageState.get('pageSize') || 20),
+      };
+
+      // Remove nulls
+      Object.keys(queryOptions).forEach((k) => {
+        if (queryOptions[k] === null) delete queryOptions[k];
+      });
+
+      const records = dataStore.query(config.collectionId, queryOptions);
+
+      // Store results in component state if instanceId provided, else page state
+      if (instanceId) {
+        const { getComponentState } = await import('../state/stateManager.js');
+        const compState = getComponentState(instanceId);
+        compState.set('data', records);
+      } else {
+        pageState.patch({ data: records, isLoading: false });
+      }
+
+      return records;
+    } catch (err) {
+      pageState.set('errorMessage', err.message);
+      showToast(`Fetch failed: ${err.message}`, 'error');
+    } finally {
+      pageState.set('isLoading', false);
+    }
+  },
+});
+
+// ── DATA: update ──────────────────────────────────────────────────────────────
+
+registerAction({
+  id:          'update',
+  name:        'Update Record',
+  category:    'Data',
+  description: 'Updates a specific record in a collection by ID.',
+  configSchema: {
+    collectionId:   { type: 'string',  required: true },
+    recordId:       { type: 'string',  default: null,  description: 'Record ID. Defaults to selectedId from page state.' },
+    data:           { type: 'object',  default: {},    description: 'Fields to update' },
+    successMessage: { type: 'string',  default: 'Updated successfully.' },
+  },
+  async execute(ctx) {
+    const { config, pageId } = ctx;
+    const pageState  = getPageState(pageId);
+    const recordId   = config.recordId || pageState.get('selectedId');
+
+    if (!recordId) {
+      showToast('No record selected to update.', 'error');
+      return;
+    }
+
+    try {
+      dataStore.update(config.collectionId, recordId, config.data || {});
+      showToast(config.successMessage || 'Updated successfully.', 'success');
+    } catch (err) {
+      showToast(`Update failed: ${err.message}`, 'error');
+    }
+  },
+});
+
+// ── DATA: delete ──────────────────────────────────────────────────────────────
+
+registerAction({
+  id:          'delete',
+  name:        'Delete Record',
+  category:    'Data',
+  description: 'Deletes a record from a collection. Prompts for confirmation.',
+  configSchema: {
+    collectionId:    { type: 'string',  required: true },
+    recordId:        { type: 'string',  default: null,  description: 'Record ID. Defaults to selectedId.' },
+    confirmMessage:  { type: 'string',  default: 'Are you sure you want to delete this record?' },
+    successMessage:  { type: 'string',  default: 'Record deleted.' },
+    skipConfirmation:{ type: 'boolean', default: false },
+  },
+  async execute(ctx) {
+    const { config, pageId } = ctx;
+    const pageState = getPageState(pageId);
+    const recordId  = config.recordId || pageState.get('selectedId');
+
+    if (!recordId) {
+      showToast('No record selected to delete.', 'error');
+      return;
+    }
+
+    if (!config.skipConfirmation) {
+      const { confirmModal } = await import('../utils/helpers.js');
+      const confirmed = await confirmModal('Delete Record', config.confirmMessage || 'Are you sure?');
+      if (!confirmed) return;
+    }
+
+    try {
+      const deleted = dataStore.delete(config.collectionId, recordId);
+      if (deleted) {
+        pageState.set('selectedId', null);
+        showToast(config.successMessage || 'Record deleted.', 'success');
+      }
+    } catch (err) {
+      showToast(`Delete failed: ${err.message}`, 'error');
+    }
+  },
+});
+
+// ── DATA: reset ───────────────────────────────────────────────────────────────
+
+registerAction({
+  id:          'reset',
+  name:        'Reset Form',
+  category:    'Data',
+  description: 'Clears all inputs in the nearest form component.',
+  configSchema: {},
+  async execute(ctx) {
+    const form = ctx.element.closest('[data-nv-component="data-form"]') || ctx.element;
+    form.querySelectorAll('[data-nv-field]').forEach((input) => {
+      if (input.type === 'checkbox') input.checked = false;
+      else input.value = '';
+    });
+    getPageState(ctx.pageId).set('errorMessage', null);
+  },
+});
+
+// ── STATE: set-state ──────────────────────────────────────────────────────────
+
+registerAction({
+  id:          'set-state',
+  name:        'Set State',
+  category:    'State',
+  description: 'Sets a state key to a specific value.',
+  configSchema: {
+    key:   { type: 'string', required: true, description: 'State key to set' },
+    value: { type: 'any',    required: true, description: 'New value' },
+    scope: { type: 'string', default: 'page', options: ['app', 'page'], description: 'State scope' },
+  },
+  async execute(ctx) {
+    const { config, pageId } = ctx;
+    const state = config.scope === 'app' ? appState : getPageState(pageId);
+    state.set(config.key, config.value);
+  },
+});
+
+// ── STATE: toggle-state ───────────────────────────────────────────────────────
+
+registerAction({
+  id:          'toggle-state',
+  name:        'Toggle State',
+  category:    'State',
+  description: 'Toggles a boolean state key between true and false.',
+  configSchema: {
+    key:   { type: 'string', required: true },
+    scope: { type: 'string', default: 'page', options: ['app', 'page'] },
+  },
+  async execute(ctx) {
+    const { config, pageId } = ctx;
+    const state = config.scope === 'app' ? appState : getPageState(pageId);
+    state.set(config.key, !state.get(config.key));
+  },
+});
+
+// ── STATE: increment-state ────────────────────────────────────────────────────
+
+registerAction({
+  id:          'increment-state',
+  name:        'Increment State',
+  category:    'State',
+  description: 'Increments a numeric state key by a given amount.',
+  configSchema: {
+    key:    { type: 'string', required: true },
+    amount: { type: 'number', default: 1 },
+    scope:  { type: 'string', default: 'page', options: ['app', 'page'] },
+  },
+  async execute(ctx) {
+    const { config, pageId } = ctx;
+    const state = config.scope === 'app' ? appState : getPageState(pageId);
+    const current = Number(state.get(config.key)) || 0;
+    state.set(config.key, current + (config.amount || 1));
+  },
+});
+
+// ── NAV: navigate ─────────────────────────────────────────────────────────────
+
+registerAction({
+  id:          'navigate',
+  name:        'Navigate to Page',
+  category:    'Navigation',
+  description: 'Switches to a different page in the Nuvra project.',
+  configSchema: {
+    pageId: { type: 'string', required: true, description: 'Target page ID' },
+  },
+  async execute(ctx) {
+    const { config } = ctx;
+    if (!config.pageId) return;
+
+    // Import pageManager lazily to avoid circular deps
+    const { switchPage } = await import('../core/pageManager.js');
+    switchPage(config.pageId);
+  },
+});
+
+// ── UTIL: show-toast ──────────────────────────────────────────────────────────
+
+registerAction({
+  id:          'show-toast',
+  name:        'Show Toast',
+  category:    'Utility',
+  description: 'Shows a toast notification message.',
+  configSchema: {
+    message:  { type: 'string', required: true },
+    type:     { type: 'string', default: 'info', options: ['info', 'success', 'error'] },
+    duration: { type: 'number', default: 3000 },
+  },
+  async execute(ctx) {
+    const { config } = ctx;
+    showToast(config.message || '', config.type || 'info', config.duration || 3000);
+  },
+});
+
+// ── UTIL: copy-to-clipboard ───────────────────────────────────────────────────
+
+registerAction({
+  id:          'copy-to-clipboard',
+  name:        'Copy to Clipboard',
+  category:    'Utility',
+  description: 'Copies a value to the user\'s clipboard.',
+  configSchema: {
+    value:          { type: 'string', required: true, description: 'Text to copy' },
+    successMessage: { type: 'string', default: 'Copied to clipboard.' },
+  },
+  async execute(ctx) {
+    try {
+      await navigator.clipboard.writeText(ctx.config.value || '');
+      showToast(ctx.config.successMessage || 'Copied to clipboard.', 'success', 2000);
+    } catch {
+      showToast('Failed to copy to clipboard.', 'error');
+    }
+  },
+});
+
+// ── UTIL: select-record ───────────────────────────────────────────────────────
+
+registerAction({
+  id:          'select',
+  name:        'Select Record',
+  category:    'Data',
+  description: 'Sets the selectedId in page state to the given record ID.',
+  configSchema: {
+    recordId: { type: 'string', default: null, description: 'Record ID to select. Reads from data-nv-record-id attribute if null.' },
+  },
+  async execute(ctx) {
+    const { config, element, pageId } = ctx;
+    const recordId = config.recordId
+      || element.closest('[data-nv-record-id]')?.dataset?.nvRecordId
+      || null;
+
+    getPageState(pageId).set('selectedId', recordId);
+  },
+});
+
+// ── UTIL: prev-page / next-page (pagination) ──────────────────────────────────
+
+registerAction({
+  id:          'prev-page',
+  name:        'Previous Page',
+  category:    'Data',
+  description: 'Decrements the pagination currentPage state key.',
+  configSchema: {},
+  async execute(ctx) {
+    const state = getPageState(ctx.pageId);
+    const current = state.get('currentPage') || 1;
+    if (current > 1) state.set('currentPage', current - 1);
+  },
+});
+
+registerAction({
+  id:          'next-page',
+  name:        'Next Page',
+  category:    'Data',
+  description: 'Increments the pagination currentPage state key.',
+  configSchema: {},
+  async execute(ctx) {
+    const state = getPageState(ctx.pageId);
+    const current = state.get('currentPage') || 1;
+    state.set('currentPage', current + 1);
+  },
+});
+
+// ── UTIL: add (open create form) ──────────────────────────────────────────────
+
+registerAction({
+  id:          'add',
+  name:        'Add Record',
+  category:    'Data',
+  description: 'Clears selectedId and sets the form to create mode.',
+  configSchema: {},
+  async execute(ctx) {
+    const state = getPageState(ctx.pageId);
+    state.set('selectedId', null);
+    state.set('errorMessage', null);
+  },
+});
+
+// ── UTIL: edit (select for update) ───────────────────────────────────────────
+
+registerAction({
+  id:          'edit',
+  name:        'Edit Record',
+  category:    'Data',
+  description: 'Sets selectedId so a form can populate with the record\'s data.',
+  configSchema: {
+    recordId: { type: 'string', default: null },
+  },
+  async execute(ctx) {
+    const { config, element, pageId } = ctx;
+    const recordId = config.recordId
+      || element.closest('[data-nv-record-id]')?.dataset?.nvRecordId
+      || null;
+
+    if (recordId) getPageState(pageId).set('selectedId', recordId);
+  },
+});
+
+// ─── ActionEngine ─────────────────────────────────────────────────────────────
+
+/**
+ * The ActionEngine is the central executor for all Nuvra actions.
+ * It is used by the AppRuntime to handle `data-nv-action` attribute bindings.
+ */
+export const ActionEngine = {
+
+  /**
+   * Execute a registered action by ID.
+   *
+   * @param {string}        actionId
+   * @param {ActionContext} context
+   * @returns {Promise<void>}
+   */
+  async run(actionId, context) {
+    const def = _actions.get(actionId);
+    if (!def) {
+      console.warn(`[ActionEngine] Unknown action "${actionId}".`);
+      return;
+    }
+
+    try {
+      await def.execute(context);
+    } catch (err) {
+      console.error(`[ActionEngine] Action "${actionId}" threw an error:`, err);
+      showToast(`Action "${actionId}" failed: ${err.message}`, 'error');
+    }
+  },
+
+  /**
+   * Get all registered action definitions.
+   * @returns {ActionDef[]}
+   */
+  getAll() {
+    return [..._actions.values()];
+  },
+
+  /**
+   * Get a registered action definition by ID.
+   * @param {string} id
+   * @returns {ActionDef|undefined}
+   */
+  get(id) {
+    return _actions.get(id);
+  },
+
+  /**
+   * Build a compact AI context string listing all actions.
+   * @returns {string}
+   */
+  buildAIContext() {
+    const byCategory = {};
+    for (const def of _actions.values()) {
+      if (!byCategory[def.category]) byCategory[def.category] = [];
+      byCategory[def.category].push(`  - ${def.id}: ${def.description}`);
+    }
+    return Object.entries(byCategory)
+      .map(([cat, items]) => `${cat}:\n${items.join('\n')}`)
+      .join('\n\n');
+  },
+};
diff --git a/src/ai/aiEngine.js b/src/ai/aiEngine.js
new file mode 100644
index 0000000..ed6a2ce
--- /dev/null
+++ b/src/ai/aiEngine.js
@@ -0,0 +1,240 @@
+/**
+ * Nuvra Builder — AI Engine  (Phase 5A)
+ *
+ * Single public API surface for all AI generation in Nuvra.
+ * Consumers call `generatePage()` or `generateSite()` and receive
+ * structured results — they never interact with providers directly.
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────────┐
+ * │                        AI GENERATION PIPELINE                               │
+ * │                                                                              │
+ * │  User Prompt                                                                 │
+ * │      │                                                                       │
+ * │      ▼                                                                       │
+ * │  ┌───────────────────────────────────────────────────────────────────┐       │
+ * │  │  PromptBudget  (providerBase.js)                                  │       │
+ * │  │    Checks: token limits, session limits, rate limits              │       │
+ * │  └───────────────────────────────────────────────────────────────────┘       │
+ * │      │  (passes if within budget)                                            │
+ * │      ▼                                                                       │
+ * │  ┌───────────────────────────────────────────────────────────────────┐       │
+ * │  │  Active Provider  (ProviderBase subclass)                         │       │
+ * │  │    ├── MockProvider     → fills blueprints with contextual content│       │
+ * │  │    ├── OpenAIProvider   → GPT returns PageSchema JSON             │       │
+ * │  │    ├── AnthropicProvider→ Claude returns PageSchema JSON          │       │
+ * │  │    └── LocalProvider    → Ollama/LM Studio returns PageSchema JSON│       │
+ * │  └───────────────────────────────────────────────────────────────────┘       │
+ * │      │  ProviderResult { schema: PageSchema, meta: {...} }                   │
+ * │      ▼                                                                       │
+ * │  ┌───────────────────────────────────────────────────────────────────┐       │
+ * │  │  SchemaRenderer  (schemaRenderer.js)                              │       │
+ * │  │    PageSchema → { html: string, css: string }                     │       │
+ * │  └───────────────────────────────────────────────────────────────────┘       │
+ * │      │  GenerationResult { html, css, name, schema, meta }                   │
+ * │      ▼                                                                       │
+ * │  GrapesJS editor.setComponents(html) + editor.setStyle(css)                 │
+ * └──────────────────────────────────────────────────────────────────────────────┘
+ *
+ * Public API:
+ *  - generatePage(prompt, options)   → GenerationResult          (single page)
+ *  - generateSite(prompt, options)   → SiteGenerationResult[]    (multi-page)
+ *  - configureAI(config)             → void
+ *  - getActiveProviderName()         → string
+ *  - getActiveProviderId()           → string
+ *  - getSessionUsage()               → { tokens, log }
+ *  - getRegisteredProviderIds()      → string[]
+ */
+
+'use strict';
+
+import { mockGenerate, mockGenerateSite } from './mockProvider.js';
+import { renderPageSchema }               from './schemaRenderer.js';
+import { ProviderBase, sessionBudget }    from './providerBase.js';
+import { OpenAIProvider }                 from './providers/openaiProvider.js';
+import { AnthropicProvider }              from './providers/anthropicProvider.js';
+import { LocalProvider }                  from './providers/localProvider.js';
+
+// ─── Mock Provider ────────────────────────────────────────────────────────────
+
+/**
+ * The mock provider wraps the existing mockGenerate / mockGenerateSite functions
+ * in the ProviderBase interface. It does NOT use the PromptBudget system
+ * (no API calls, no cost), but it does validate the output schema.
+ */
+class MockProvider extends ProviderBase {
+  get id()           { return 'mock'; }
+  get name()         { return 'Mock (Offline)'; }
+  get defaultModel() { return 'mock-v2'; }
+
+  get supportedModels() { return ['mock-v2']; }
+
+  /**
+   * Override `generate()` entirely to bypass the budget system.
+   * The mock provider is free and offline.
+   */
+  async generate(prompt, options = {}) {
+    return mockGenerate(prompt, options);
+  }
+
+  async _generateSite(prompt, options = {}) {
+    return mockGenerateSite(prompt, options);
+  }
+
+  // _callAPI is not used by MockProvider
+  async _callAPI() {
+    throw new Error('MockProvider does not use _callAPI.');
+  }
+}
+
+// ─── Provider Registry ────────────────────────────────────────────────────────
+
+/**
+ * Maps provider IDs to their constructor classes.
+ * To add a new provider, register it here.
+ */
+const PROVIDER_REGISTRY = {
+  mock:      MockProvider,
+  openai:    OpenAIProvider,
+  anthropic: AnthropicProvider,
+  local:     LocalProvider,
+};
+
+// ─── Active Provider State ────────────────────────────────────────────────────
+
+let _activeProvider = null;
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * Configure the AI engine. Call once at startup or when settings change.
+ *
+ * @param {object} config
+ * @param {'mock'|'openai'|'anthropic'|'local'} [config.provider='mock']
+ * @param {string}  [config.apiKey]
+ * @param {string}  [config.model]
+ * @param {string}  [config.baseUrl]          - Override for OpenAI-compatible endpoints
+ * @param {number}  [config.maxInputTokens]   - Override input token limit
+ * @param {number}  [config.maxOutputTokens]  - Override output token limit
+ * @param {number}  [config.maxSessionTokens] - Override session token limit
+ */
+export function configureAI(config = {}) {
+  const id            = config.provider || 'mock';
+  const ProviderClass = PROVIDER_REGISTRY[id];
+
+  if (!ProviderClass) {
+    console.error(`[Nuvra AI] Unknown provider "${id}" — falling back to mock.`);
+    _activeProvider = new MockProvider({});
+    return;
+  }
+
+  _activeProvider = new ProviderClass(config);
+
+  console.info(
+    `[Nuvra AI] Active provider: ${_activeProvider.name} ` +
+    `(model: ${_activeProvider.model || 'default'})`
+  );
+}
+
+/**
+ * Generate a page from a natural-language prompt.
+ *
+ * @typedef {object} GenerationResult
+ * @property {string} html    - Rendered HTML body for GrapesJS
+ * @property {string} css     - Rendered CSS for GrapesJS
+ * @property {string} name    - Suggested page name
+ * @property {object} schema  - The raw PageSchema (store this for re-rendering)
+ * @property {object} meta    - { provider, model, tokens, inputTokens, outputTokens, attempt }
+ *
+ * @param {string} prompt
+ * @param {object} [options]
+ * @param {string} [options.accentColor]
+ * @param {string} [options.theme]
+ * @returns {Promise<GenerationResult>}
+ */
+export async function generatePage(prompt, options = {}) {
+  if (!_activeProvider) {
+    console.warn('[Nuvra AI] No provider configured — defaulting to mock.');
+    _activeProvider = new MockProvider({});
+  }
+
+  // Step 1: Provider → PageSchema (with budget checks and retries)
+  const { schema, meta } = await _activeProvider.generate(prompt, options);
+
+  // Step 2: SchemaRenderer → HTML + CSS
+  const { html, css } = renderPageSchema(schema);
+
+  return {
+    html,
+    css,
+    name:   schema.name,
+    schema,  // stored in project JSON for future re-rendering
+    meta,
+  };
+}
+
+/**
+ * Generate a full multi-page site from a natural-language prompt.
+ *
+ * @typedef {object} SiteGenerationResult
+ * @property {string} pageId    - URL slug for the page (e.g. 'home', 'pricing')
+ * @property {string} pageName  - Display name (e.g. 'Home', 'Pricing')
+ * @property {string} html      - Rendered HTML for GrapesJS
+ * @property {string} css       - Rendered CSS for GrapesJS
+ * @property {object} schema    - The raw PageSchema
+ * @property {object} meta      - { provider, model, tokens, pageIndex }
+ *
+ * @param {string} prompt
+ * @param {object} [options]
+ * @returns {Promise<SiteGenerationResult[]>}
+ */
+export async function generateSite(prompt, options = {}) {
+  if (!_activeProvider) {
+    console.warn('[Nuvra AI] No provider configured — defaulting to mock.');
+    _activeProvider = new MockProvider({});
+  }
+
+  // Use provider-specific multi-page method
+  const pageResults = await _activeProvider._generateSite(prompt, options);
+
+  // Render each page schema
+  return pageResults.map(({ pageId, pageName, schema, meta }) => {
+    const { html, css } = renderPageSchema(schema);
+    return { pageId, pageName, html, css, schema, meta };
+  });
+}
+
+/**
+ * Return the name of the currently active provider.
+ * @returns {string}
+ */
+export function getActiveProviderName() {
+  return _activeProvider?.name ?? 'none';
+}
+
+/**
+ * Return the ID of the currently active provider.
+ * @returns {string}
+ */
+export function getActiveProviderId() {
+  return _activeProvider?.id ?? 'none';
+}
+
+/**
+ * Return session token usage statistics.
+ * @returns {{ tokens: number, remaining: number, log: object[] }}
+ */
+export function getSessionUsage() {
+  return {
+    tokens:    sessionBudget.sessionTokens,
+    remaining: sessionBudget.remainingTokens,
+    log:       sessionBudget.usageLog,
+  };
+}
+
+/**
+ * Return all registered provider IDs.
+ * @returns {string[]}
+ */
+export function getRegisteredProviderIds() {
+  return Object.keys(PROVIDER_REGISTRY);
+}
