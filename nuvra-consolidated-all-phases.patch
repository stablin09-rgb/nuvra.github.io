+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * Generate a single page schema from a prompt.
+ * Used by the `MockProvider` class in `aiEngine.js`.
+ *
+ * @param {string} prompt
+ * @param {object} [options]
+ * @returns {Promise<{ schema: import('./pageSchema.js').PageSchema, meta: object }>}
+ */
+export async function mockGenerate(prompt, options = {}) {
+  await _sleep(MOCK_DELAY_MS);
+
+  const intent  = analysePrompt(prompt);
+  const plan    = planSite(intent);
+  const schema  = _buildPageSchema(plan.pages[0], plan);
+
+  console.info('[MockProvider] Prompt analysis:', intent.signals);
+  console.info('[MockProvider] Site plan:', plan.pages.map(p => `${p.name} (${p.sections.length} sections)`));
+
+  if (!isValidPageSchema(schema)) {
+    throw new Error('[MockProvider] Built an invalid PageSchema. This is a bug.');
+  }
+
+  return {
+    schema,
+    meta: {
+      provider: 'mock',
+      model:    `mock-${intent.pageType}-v3`,
+      tokens:   null,
+      intent,   // Expose intent for debugging in the console
+    },
+  };
+}
+
+/**
+ * Generate a multi-page site from a prompt.
+ * Returns an array of `ProviderResult` objects, one per page.
+ *
+ * @param {string} prompt
+ * @param {object} [options]
+ * @returns {Promise<Array<{ schema: import('./pageSchema.js').PageSchema, meta: object }>>}
+ */
+export async function mockGenerateSite(prompt, options = {}) {
+  await _sleep(MOCK_DELAY_MS);
+
+  const intent = analysePrompt(prompt);
+  const plan   = planSite(intent);
+
+  console.info('[MockProvider] Multi-page plan:', plan.pages.map(p => `${p.name} (${p.sections.length} sections)`));
+
+  const results = plan.pages.map((pagePlan, index) => {
+    const schema = _buildPageSchema(pagePlan, plan);
+
+    if (!isValidPageSchema(schema)) {
+      throw new Error(`[MockProvider] Built an invalid PageSchema for page "${pagePlan.name}". This is a bug.`);
+    }
+
+    return {
+      pageId:   pagePlan.id,
+      pageName: pagePlan.name,
+      schema,
+      meta: {
+        provider: 'mock',
+        model:    `mock-${intent.pageType}-v3`,
+        tokens:   null,
+        pageIndex: index,
+        intent: index === 0 ? intent : undefined,
+      },
+    };
+  });
+
+  return results;
+}
