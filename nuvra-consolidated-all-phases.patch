+/**
+ * Builds a complete `PageSchema` from a `PagePlan` and `SitePlan`.
+ * This is where the section blueprints get filled with real content.
+ *
+ * @param {import('./sitePlanner.js').PagePlan} pagePlan
+ * @param {import('./sitePlanner.js').SitePlan} sitePlan
+ * @returns {import('./pageSchema.js').PageSchema}
+ */
+function _buildPageSchema(pagePlan, sitePlan) {
+  const { brand, accentColor, fontFamily, theme, industry, navLinks } = sitePlan;
+  const { name, sections } = pagePlan;
+
+  // Pick content pools based on industry, falling back to 'general'
+  const heroContent    = CONTENT.hero;
+  const featureItems   = CONTENT.features[pagePlan.intent.includes('portfolio') ? 'portfolio'
+                       : pagePlan.intent.includes('agency')   ? 'agency'
+                       : pagePlan.intent.includes('app')      ? 'app-homepage'
+                       : pagePlan.intent.includes('shop')     ? 'ecommerce'
+                       : 'saas-landing'] ?? CONTENT.features.generic;
+
+  const testimonials   = CONTENT.testimonials[industry] ?? CONTENT.testimonials.general;
+  const testimonial    = testimonials[Math.floor(Math.random() * testimonials.length)];
+
+  // Determine the page type key for CTA content
+  const ctaKey = Object.keys(CONTENT.cta).find(k => pagePlan.intent.toLowerCase().includes(k.replace('-', ' '))) ?? 'generic';
+  const ctaContent = CONTENT.cta[ctaKey] ?? CONTENT.cta.generic;
+
+  // Pick hero subtitle
+  const pageTypeKey = Object.keys(CONTENT.hero.subtitles).find(k =>
+    pagePlan.intent.toLowerCase().includes(k.replace('-', ' '))
+  ) ?? 'generic';
+  const subtitlePool = heroContent.subtitles[pageTypeKey] ?? heroContent.subtitles.generic;
+  const subtitle = subtitlePool[Math.floor(Math.random() * subtitlePool.length)]
+    .replace(/{brand}/g, brand);
+
+  // Pick badge
+  const badgePool = heroContent.badges[industry] ?? heroContent.badges.general;
+  const badge = badgePool[Math.floor(Math.random() * badgePool.length)];
+
+  // Build sections
+  const builtSections = sections.map(({ type }) => {
+    switch (type) {
+
+      case 'navbar':
+        return {
+          type: 'navbar',
+          props: {
+            brand,
+            links: navLinks.filter(l => l !== name).slice(0, 4),
+            cta:   'Get Started',
+          },
+        };
+
+      case 'hero':
+        return {
+          type: 'hero',
+          props: {
+            badge,
+            title:        `${brand} — ${_heroTagline(pagePlan, industry)}`,
+            subtitle,
+            primaryCta:   _primaryCta(pagePlan),
+            secondaryCta: _secondaryCta(pagePlan),
+            theme:        'dark',
+          },
+        };
+
+      case 'features':
+        return {
+          type: 'features',
+          props: {
+            heading: _featuresHeading(pagePlan),
+            items:   featureItems.slice(0, 6),
+          },
+        };
+
+      case 'testimonial':
+        return {
+          type: 'testimonial',
+          props: testimonial,
+        };
+
+      case 'cta':
+        return {
+          type: 'cta',
+          props: {
+            heading: ctaContent.heading,
+            subtext: ctaContent.subtext.replace(/{brand}/g, brand),
+            cta:     _primaryCta(pagePlan),
+          },
+        };
+
+      case 'footer':
+        return {
+          type: 'footer',
+          props: {
+            brand,
+            links: ['Privacy', 'Terms', 'Contact', 'Status'],
+          },
+        };
+
+      case 'blog-header':
+        return {
+          type: 'blog-header',
+          props: {
+            heading: `${brand} Blog`,
+            subtext: 'Insights, tutorials, and deep dives from our team.',
+          },
+        };
+
+      case 'blog-grid':
+        return {
+          type: 'blog-grid',
+          props: {
+            posts: _generateBlogPosts(brand, industry),
+          },
+        };
+
+      case 'newsletter':
+        return {
+          type: 'newsletter',
+          props: {
+            heading: 'Stay in the loop',
+            subtext: `Get the best ${brand} content delivered to your inbox every two weeks.`,
+          },
+        };
+
+      case 'pricing-header':
+        return {
+          type: 'pricing-header',
+          props: {
+            heading: 'Simple, transparent pricing',
+            subtext: 'No hidden fees. No surprise invoices. Cancel any time.',
+          },
+        };
+
+      case 'pricing-grid':
+        return {
+          type: 'pricing-grid',
+          props: { plans: _generatePricingPlans(brand) },
+        };
+
+      case 'faq':
+        return {
+          type: 'faq',
+          props: {
+            heading: 'Frequently asked questions',
+            items:   _generateFaqItems(industry),
+          },
+        };
+
+      case 'dashboard-header':
+        return {
+          type: 'dashboard-header',
+          props: { title: brand, subtitle: 'Overview for the last 30 days', cta: 'Export Report' },
+        };
+
+      case 'stat-row':
+        return {
+          type: 'stat-row',
+          props: { stats: _generateStats(industry) },
+        };
+
+      case 'data-table':
+        return {
+          type: 'data-table',
+          props: _generateDataTable(industry),
+        };
+
+      default:
+        // Unknown section type — return a generic placeholder
+        console.warn(`[MockProvider] Unknown section type in blueprint: "${type}"`);
+        return null;
+    }
+  }).filter(Boolean);
+
+  return {
+    name,
+    settings: { theme, accentColor, fontFamily },
+    sections: builtSections,
+  };
+}
