++/**
++ * Nuvra Builder — Site Builder  (Phase 5)
++ *
++ * Assembles the complete, production-ready site bundle from the current
++ * project state. This is the core of the publish pipeline.
++ *
++ * ┌──────────────────────────────────────────────────────────────────────────┐
++ * │  What the SiteBuilder produces                                           │
++ * │                                                                          │
++ * │  site/                                                                   │
++ * │    index.html          ← Home page (or first page)                      │
++ * │    about.html          ← Additional pages (slug-named)                  │
++ * │    contact.html                                                          │
++ * │    dashboard.html                                                        │
++ * │    _nuvra/                                                               │
++ * │      manifest.json     ← Site metadata (name, pages, build info)        │
++ * │      runtime.js        ← Standalone runtime for app pages               │
++ * └──────────────────────────────────────────────────────────────────────────┘
++ *
++ * Design decisions:
++ *  - The SiteBuilder reuses `buildPreviewDocument()` from the PreviewRenderer
++ *    for every page. This guarantees that the published output is identical
++ *    to the preview — no separate render path, no divergence.
++ *  - The "home" page is always output as `index.html` so the site works on
++ *    any static host without configuration.
++ *  - All other pages are output as `<slug>.html` for clean URLs.
++ *  - A `_nuvra/manifest.json` file is included for tooling, future CI/CD
++ *    pipelines, and debugging.
++ *  - The SiteBuilder returns a `SiteBundle` object (a plain map of
++ *    filename → content strings). The PublishManager is responsible for
++ *    packaging this into a ZIP file. This separation keeps the builder
++ *    testable and independent of the ZIP library.
++ *  - Errors in individual pages are caught and reported without aborting
++ *    the entire build. The manifest records which pages failed.
++ */
++
++'use strict';
++
++import { buildPreviewDocument }  from '../preview/previewRenderer.js';
++import { getSnapshot }           from '../core/pageManager.js';
++import { slugify }               from '../utils/helpers.js';
++
++// ─── Types ────────────────────────────────────────────────────────────────────
++
++/**
++ * @typedef {Object} SiteFile
++ * @property {string} path    - Relative path in the output bundle (e.g. "index.html")
++ * @property {string} content - File content as a string
++ * @property {string} type    - MIME type hint ('text/html' | 'application/json' | 'text/javascript')
++ */
++
++/**
++ * @typedef {Object} BuildResult
++ * @property {boolean}    success   - Whether the build completed without fatal errors
++ * @property {SiteFile[]} files     - All generated files
++ * @property {object}     manifest  - The site manifest (also included in files)
++ * @property {string[]}   warnings  - Non-fatal warnings (e.g. pages that failed to render)
++ * @property {number}     duration  - Build duration in milliseconds
++ * @property {string}     buildId   - Unique build identifier
++ */
++
++// ─── Public API ───────────────────────────────────────────────────────────────
++
++/**
++ * Build the complete site bundle from the current project state.
++ *
++ * @param {object} [options]
++ * @param {string} [options.siteName]    - Override the site name in the manifest
++ * @param {Function} [options.onProgress] - Callback(pageId, index, total) for progress reporting
++ * @returns {Promise<BuildResult>}
++ */
++export async function buildSite(options = {}) {
++  const startTime = Date.now();
++  const buildId   = `nuvra-build-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
++
++  const { pages, currentPage } = getSnapshot();
++  const pageIds  = Object.keys(pages);
++  const warnings = [];
++  const files    = [];
++
++  if (pageIds.length === 0) {
++    return {
++      success:  false,
++      files:    [],
++      manifest: null,
++      warnings: ['No pages found in the project.'],
++      duration: Date.now() - startTime,
++      buildId,
++    };
++  }
++
++  // ── Render each page ──────────────────────────────────────────────────────
++
++  const pageManifestEntries = [];
++
++  for (let i = 0; i < pageIds.length; i++) {
++    const pageId = pageIds[i];
++    const page   = pages[pageId];
++
++    if (options.onProgress) {
++      options.onProgress(pageId, i + 1, pageIds.length);
++    }
++
++    // Determine output filename
++    // The "home" page is always index.html; all others use their slug
++    const filename = (pageId === 'home' || i === 0)
++      ? 'index.html'
++      : `${slugify(pageId) || pageId}.html`;
++
++    const pageType = page?.pageConfig?.type || 'landing';
++
++    try {
++      const html = buildPreviewDocument(page, pageId);
++
++      files.push({
++        path:    filename,
++        content: html,
++        type:    'text/html',
++      });
++
++      pageManifestEntries.push({
++        id:       pageId,
++        name:     page.name,
++        type:     pageType,
++        file:     filename,
++        isHome:   filename === 'index.html',
++      });
