index 0000000..fe0d4e0
--- /dev/null
+++ b/src/runtime/appRuntime.js
@@ -0,0 +1,734 @@
+/**
+ * Nuvra Builder — App Runtime  (Phase 3)
+ *
+ * The AppRuntime is the bridge between the static HTML produced by the
+ * SchemaRenderer / AppComponents and the live, interactive app page.
+ *
+ * It is responsible for:
+ *  1. Scanning the canvas for `data-nv-*` attributes
+ *  2. Wiring up state bindings (data-nv-bind, data-nv-show-when)
+ *  3. Attaching action handlers (data-nv-action)
+ *  4. Populating data-driven components (tables, lists, forms) with real data
+ *  5. Managing the lifecycle of page and component state nodes
+ *
+ * The AppRuntime is intentionally lightweight. It does not manage a virtual
+ * DOM or re-render the entire page on state change. Instead, it uses the
+ * fine-grained subscriptions from StateNode to update only the affected DOM
+ * elements.
+ *
+ * Design decisions:
+ *  - The runtime is only activated for APP pages (kind === 'app').
+ *    Marketing pages are static HTML and do not need it.
+ *  - The runtime is re-initialized every time a new app page is loaded
+ *    into the GrapesJS canvas preview.
+ *  - All data-nv-* attributes are the public API between the component
+ *    templates (appComponents.js) and the runtime. Changing a template
+ *    only requires updating the attribute, not the runtime.
+ */
+
+'use strict';
+
+import { dataStore }                           from '../data/dataModel.js';
+import { getPageState, getComponentState,
+         destroyComponentState, bindState,
+         bindVisibility }                      from '../state/stateManager.js';
+import { ActionEngine }                        from '../actions/actionEngine.js';
+import { getPageTypeConfig, isAppPage }        from '../core/pageSemantics.js';
+import { FIELD_TYPES }                         from '../data/dataModel.js';
+
+// ─── Runtime State ────────────────────────────────────────────────────────────
+
+/** Currently active page ID */
+let _activePageId = null;
+
+/** Cleanup functions to call when the page is unloaded */
+const _cleanupFns = [];
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * Mount the AppRuntime on a canvas root element for a given page.
+ * Call this every time a new page is loaded into the preview.
+ *
+ * @param {HTMLElement} root   - The canvas root element
+ * @param {string}      pageId - The page ID being loaded
+ * @param {string}      [pageType] - The page type ID (from pageSemantics)
+ */
+export function mountRuntime(root, pageId, pageType = 'landing') {
+  // Unmount any previous runtime first
+  unmountRuntime();
+
+  if (!isAppPage(pageType)) {
+    // Marketing pages: no runtime needed
+    return;
+  }
+
+  _activePageId = pageId;
+
+  console.info(`[AppRuntime] Mounting on page "${pageId}" (type: ${pageType})`);
+
+  // Wire up all components found in the canvas
+  _hydrateComponents(root, pageId);
+  _wireActions(root, pageId);
+  _wireStateBindings(root, pageId);
+
+  // Initial data fetch for all data-bound components
+  _fetchAllComponents(root, pageId);
+}
+
+/**
+ * Unmount the runtime and clean up all subscriptions.
+ * Call this before loading a new page.
+ */
+export function unmountRuntime() {
+  _cleanupFns.forEach((fn) => fn());
+  _cleanupFns.length = 0;
+  _activePageId = null;
+}
+
+// ─── Component Hydration ──────────────────────────────────────────────────────
+
+/**
+ * Find all `[data-nv-component]` elements and hydrate them.
+ *
+ * @param {HTMLElement} root
+ * @param {string}      pageId
+ */
+function _hydrateComponents(root, pageId) {
+  const components = root.querySelectorAll('[data-nv-component]');
+
+  components.forEach((el) => {
+    const componentId = el.dataset.nvComponent;
+    const instanceId  = el.dataset.nvInstance || _generateInstanceId(componentId);
+
+    // Stamp the instance ID onto the element for later reference
+    el.dataset.nvInstance = instanceId;
+
+    switch (componentId) {
+      case 'data-table':
+        _hydrateTable(el, pageId, instanceId);
+        break;
+      case 'data-list':
+        _hydrateList(el, pageId, instanceId);
+        break;
+      case 'data-form':
+        _hydrateForm(el, pageId, instanceId);
+        break;
+      case 'data-detail':
+        _hydrateDetail(el, pageId, instanceId);
+        break;
+      case 'stat-display':
+        _hydrateStat(el, pageId, instanceId);
+        break;
+      case 'show-if':
+        _hydrateShowIf(el, pageId, instanceId);
+        break;
+      case 'loading-gate':
+        _hydrateLoadingGate(el, pageId, instanceId);
+        break;
+      default:
+        // Unknown component — no-op
+        break;
+    }
+  });
+}
+
+// ─── Table Hydration ──────────────────────────────────────────────────────────
+
+function _hydrateTable(el, pageId, instanceId) {
+  const collectionId = el.dataset.nvCollection;
+  if (!collectionId) return;
+
+  let schema;
+  try {
+    schema = dataStore.getCollection(collectionId);
+  } catch {
+    _renderEmptyState(el.querySelector('.nv-table-body'), `Collection "${collectionId}" not found.`);
+    return;
+  }
+
+  const pageState = getPageState(pageId);
+  const compState = getComponentState(instanceId);
+
+  // Build column headers
+  const thead = el.querySelector('.nv-table-head tr');
+  if (thead) {
+    thead.innerHTML = '';
+    Object.entries(schema.fields).forEach(([fieldId, field]) => {
+      const th = document.createElement('th');
+      th.className = 'nv-th';
+      th.dataset.nvSort = fieldId;
+      th.textContent = field.label || fieldId;
+      th.addEventListener('click', () => {
+        const current = pageState.get('sortBy');
+        const dir     = current === fieldId && pageState.get('sortDir') === 'asc' ? 'desc' : 'asc';
+        pageState.patch({ sortBy: fieldId, sortDir: dir });
+        _renderTableRows(el, collectionId, schema, pageState, pageId);
+      });
+      thead.appendChild(th);
+    });
+
+    // Actions column
+    const thActions = document.createElement('th');
+    thActions.className = 'nv-th';
+    thActions.textContent = '';
+    thead.appendChild(thActions);
+  }
+
+  // Initial render
+  _renderTableRows(el, collectionId, schema, pageState, pageId);
+
+  // Re-render on state changes
+  const unsub1 = pageState.subscribe('searchQuery', () =>
+    _renderTableRows(el, collectionId, schema, pageState, pageId));
+  const unsub2 = pageState.subscribe('currentPage', () =>
+    _renderTableRows(el, collectionId, schema, pageState, pageId));
+  const unsub3 = pageState.subscribe('sortBy', () =>
+    _renderTableRows(el, collectionId, schema, pageState, pageId));
+
+  _cleanupFns.push(unsub1, unsub2, unsub3, () => destroyComponentState(instanceId));
+
+  // Wire search input
+  const searchInput = el.querySelector('.nv-search-input');
+  if (searchInput) {
+    searchInput.addEventListener('input', (e) => {
+      pageState.set('searchQuery', e.target.value);
+    });
+  }
+
+  // Wire pagination
+  el.querySelector('[data-nv-action="prev-page"]')?.addEventListener('click', () => {
+    ActionEngine.run('prev-page', { actionId: 'prev-page', element: el, pageId, config: {} });
+  });
+  el.querySelector('[data-nv-action="next-page"]')?.addEventListener('click', () => {
+    ActionEngine.run('next-page', { actionId: 'next-page', element: el, pageId, config: {} });
+  });
+}
+
+function _renderTableRows(el, collectionId, schema, pageState, pageId) {
+  const tbody = el.querySelector('.nv-table-body');
+  if (!tbody) return;
+
+  const searchQuery = (pageState.get('searchQuery') || '').toLowerCase();
+  const sortBy      = pageState.get('sortBy');
+  const sortDir     = pageState.get('sortDir') || 'asc';
+  const currentPage = pageState.get('currentPage') || 1;
+  const pageSize    = parseInt(el.dataset.nvPageSize) || 10;
+
+  let records = dataStore.query(collectionId, {
+    sortBy:  sortBy || undefined,
+    sortDir: sortDir,
+  });
+
+  // Client-side search filter
+  if (searchQuery) {
+    records = records.filter((rec) =>
+      Object.values(rec).some((v) =>
+        String(v).toLowerCase().includes(searchQuery)
+      )
+    );
+  }
+
+  // Update count
+  const countEl = el.querySelector('.nv-table-count');
+  if (countEl) countEl.textContent = `${records.length} record${records.length !== 1 ? 's' : ''}`;
+
+  // Pagination
+  const totalPages = Math.max(1, Math.ceil(records.length / pageSize));
+  const page       = Math.min(currentPage, totalPages);
+  const start      = (page - 1) * pageSize;
+  const pageRecords = records.slice(start, start + pageSize);
+
+  const pageIndicator = el.querySelector('.nv-page-indicator');
+  if (pageIndicator) pageIndicator.textContent = `${page} / ${totalPages}`;
+
+  if (pageRecords.length === 0) {
+    tbody.innerHTML = `<tr><td class="nv-td" colspan="99" style="text-align:center;color:#9ca3af;">
+      ${el.dataset.nvEmptyMessage || 'No records found.'}</td></tr>`;
+    return;
+  }
+
+  const fieldIds = Object.keys(schema.fields);
+  tbody.innerHTML = pageRecords.map((rec) => {
+    const cells = fieldIds.map((fid) => {
+      const val = rec[fid];
+      const field = schema.fields[fid];
+      return `<td class="nv-td">${_formatCellValue(val, field)}</td>`;
+    }).join('');
+
+    return `<tr class="nv-tr" data-nv-record-id="${rec._id}">
+      ${cells}
+      <td class="nv-td" style="white-space:nowrap;">
+        <button class="nv-btn sm" data-nv-action="edit" data-nv-record-id="${rec._id}">Edit</button>
+        <button class="nv-btn sm danger" data-nv-action="delete" data-nv-record-id="${rec._id}" style="margin-left:4px;">Del</button>
+      </td>
+    </tr>`;
+  }).join('');
+
+  // Wire row-level action buttons
+  tbody.querySelectorAll('[data-nv-action]').forEach((btn) => {
+    btn.addEventListener('click', (e) => {
+      e.stopPropagation();
+      const actionId = btn.dataset.nvAction;
+      const recordId = btn.dataset.nvRecordId || btn.closest('[data-nv-record-id]')?.dataset?.nvRecordId;
+      ActionEngine.run(actionId, {
+        actionId,
+        element: btn,
+        pageId,
+        config: { collectionId, recordId },
+        event: e,
+      });
+    });
+  });
+}
+
+// ─── List Hydration ───────────────────────────────────────────────────────────
+
+function _hydrateList(el, pageId, instanceId) {
+  const collectionId = el.dataset.nvCollection;
+  if (!collectionId) return;
+
+  let schema;
+  try {
+    schema = dataStore.getCollection(collectionId);
+  } catch {
+    return;
+  }
+
+  const displayField   = el.dataset.nvDisplayField   || 'name';
+  const secondaryField = el.dataset.nvSecondaryField || '';
+  const badgeField     = el.dataset.nvBadgeField     || '';
+
+  _renderListItems(el, collectionId, schema, displayField, secondaryField, badgeField, pageId);
+
+  // Wire Add button
+  el.querySelector('[data-nv-action="add"]')?.addEventListener('click', () => {
+    ActionEngine.run('add', { actionId: 'add', element: el, pageId, config: {} });
+  });
+
+  _cleanupFns.push(() => destroyComponentState(instanceId));
+}
+
+function _renderListItems(el, collectionId, schema, displayField, secondaryField, badgeField, pageId) {
+  const body = el.querySelector('.nv-list-body');
+  if (!body) return;
+
+  const records = dataStore.query(collectionId);
+  const emptyMsg = el.dataset.nvEmptyMessage || 'No items yet.';
+
+  if (records.length === 0) {
+    body.innerHTML = `<div class="nv-list-placeholder">${emptyMsg}</div>`;
+    return;
+  }
+
+  body.innerHTML = records.map((rec) => {
+    const primary   = rec[displayField]   || rec.name || rec._id;
+    const secondary = secondaryField ? rec[secondaryField] : '';
+    const badge     = badgeField     ? rec[badgeField]     : '';
+
+    return `<div class="nv-list-item" data-nv-record-id="${rec._id}">
+      <div>
+        <div class="nv-list-item-primary">${_escapeHtml(String(primary))}</div>
+        ${secondary ? `<div class="nv-list-item-secondary">${_escapeHtml(String(secondary))}</div>` : ''}
+      </div>
+      ${badge ? `<span class="nv-badge nv-badge-neutral">${_escapeHtml(String(badge))}</span>` : ''}
+    </div>`;
+  }).join('');
+
+  body.querySelectorAll('.nv-list-item').forEach((item) => {
+    item.addEventListener('click', () => {
+      const recordId = item.dataset.nvRecordId;
+      ActionEngine.run('select', { actionId: 'select', element: item, pageId, config: { recordId } });
+      body.querySelectorAll('.nv-list-item').forEach((i) => i.classList.remove('selected'));
+      item.classList.add('selected');
+    });
+  });
+}
+
+// ─── Form Hydration ───────────────────────────────────────────────────────────
+
+function _hydrateForm(el, pageId, instanceId) {
+  const collectionId = el.dataset.nvCollection;
+  if (!collectionId) return;
+
+  let schema;
+  try {
+    schema = dataStore.getCollection(collectionId);
+  } catch {
+    return;
+  }
+
+  const fieldsContainer = el.querySelector('.nv-form-fields');
+  if (!fieldsContainer) return;
+
+  // Remove placeholder
+  fieldsContainer.innerHTML = '';
+
+  // Build form fields from schema
+  Object.entries(schema.fields).forEach(([fieldId, field]) => {
+    const wrapper = document.createElement('div');
+    wrapper.className = 'nv-form-field';
+
+    const label = document.createElement('label');
+    label.className = 'nv-form-label';
+    label.textContent = field.label || fieldId;
+    if (field.required) label.textContent += ' *';
+
+    const input = _buildFormInput(fieldId, field);
+    wrapper.appendChild(label);
+    wrapper.appendChild(input);
+    fieldsContainer.appendChild(wrapper);
+  });
+
+  // Wire submit button
+  const submitBtn = el.querySelector('[data-nv-action="submit"]');
+  if (submitBtn) {
+    submitBtn.addEventListener('click', (e) => {
+      ActionEngine.run('submit', {
+        actionId: 'submit',
+        element:  submitBtn,
+        pageId,
+        instanceId,
+        config: {
+          collectionId,
+          mode:           el.dataset.nvMode || 'create',
+          successMessage: 'Record saved successfully.',
+          resetOnSuccess: true,
+        },
+        event: e,
+      });
+    });
+  }
+
+  // Wire reset/cancel button
+  const resetBtn = el.querySelector('[data-nv-action="reset"]');
+  if (resetBtn) {
+    resetBtn.addEventListener('click', () => {
+      ActionEngine.run('reset', { actionId: 'reset', element: resetBtn, pageId, config: {} });
+    });
+  }
+
+  // Populate form when selectedId changes (for update mode)
+  const pageState = getPageState(pageId);
+  const unsub = pageState.subscribe('selectedId', (recordId) => {
+    if (!recordId || el.dataset.nvMode !== 'update') return;
+    const record = dataStore.getById(collectionId, recordId);
+    if (!record) return;
+    el.querySelectorAll('[data-nv-field]').forEach((input) => {
+      const fid = input.dataset.nvField;
+      if (input.type === 'checkbox') input.checked = Boolean(record[fid]);
+      else input.value = record[fid] ?? '';
+    });
+  });
+
+  _cleanupFns.push(unsub, () => destroyComponentState(instanceId));
+}
+
+function _buildFormInput(fieldId, field) {
+  let input;
+
+  if (field.type === 'boolean') {
+    input = document.createElement('input');
+    input.type = 'checkbox';
+    input.className = 'nv-form-checkbox';
+  } else if (field.type === 'select' && field.options) {
+    input = document.createElement('select');
+    input.className = 'nv-form-input';
+    field.options.forEach((opt) => {
+      const option = document.createElement('option');
+      option.value = opt;
+      option.textContent = opt;
+      input.appendChild(option);
+    });
+  } else {
+    input = document.createElement('input');
+    input.className = 'nv-form-input';
+    input.type = field.type === 'email' ? 'email'
+               : field.type === 'number' ? 'number'
+               : field.type === 'date'   ? 'date'
+               : field.type === 'url'    ? 'url'
+               : 'text';
+    if (field.required) input.required = true;
+    if (field.default !== undefined && typeof field.default !== 'function') {
+      input.value = field.default;
+    }
+  }
+
+  input.dataset.nvField = fieldId;
+  input.name = fieldId;
+  return input;
+}
+
+// ─── Detail View Hydration ────────────────────────────────────────────────────
+
+function _hydrateDetail(el, pageId, instanceId) {
+  const collectionId = el.dataset.nvCollection;
+  if (!collectionId) return;
+
+  let schema;
+  try {
+    schema = dataStore.getCollection(collectionId);
+  } catch {
+    return;
+  }
+
+  const pageState = getPageState(pageId);
+
+  const unsub = pageState.subscribe('selectedId', (recordId) => {
+    const body = el.querySelector('.nv-detail-body');
+    if (!body) return;
+
+    if (!recordId) {
+      body.innerHTML = `<div class="nv-detail-placeholder">${el.dataset.nvEmptyMessage || 'Select a record to view details.'}</div>`;
+      return;
+    }
+
+    const record = dataStore.getById(collectionId, recordId);
+    if (!record) {
+      body.innerHTML = `<div class="nv-detail-placeholder">Record not found.</div>`;
+      return;
+    }
+
+    body.innerHTML = Object.entries(schema.fields).map(([fieldId, field]) => `
+      <div class="nv-detail-field">
+        <div class="nv-detail-field-label">${field.label || fieldId}</div>
+        <div class="nv-detail-field-value">${_formatCellValue(record[fieldId], field)}</div>
+      </div>
+    `).join('');
+  });
+
+  // Wire action buttons
+  el.querySelector('[data-nv-action="edit"]')?.addEventListener('click', () => {
+    ActionEngine.run('edit', { actionId: 'edit', element: el, pageId, config: { collectionId } });
+  });
+  el.querySelector('[data-nv-action="delete"]')?.addEventListener('click', () => {
+    ActionEngine.run('delete', { actionId: 'delete', element: el, pageId, config: { collectionId } });
+  });
+
+  _cleanupFns.push(unsub, () => destroyComponentState(instanceId));
+}
+
+// ─── Stat Display Hydration ───────────────────────────────────────────────────
+
+function _hydrateStat(el, pageId, instanceId) {
+  const collectionId  = el.dataset.nvCollection;
+  const aggregation   = el.dataset.nvAggregation || 'count';
+  const field         = el.dataset.nvField || null;
+  const prefix        = el.dataset.nvPrefix || '';
+  const suffix        = el.dataset.nvSuffix || '';
+
+  if (!collectionId) return;
+
+  function _refresh() {
+    let value;
+    try {
+      const records = dataStore.query(collectionId);
+      switch (aggregation) {
+        case 'count': value = records.length; break;
+        case 'sum':   value = records.reduce((s, r) => s + (Number(r[field]) || 0), 0); break;
+        case 'avg':   value = records.length ? records.reduce((s, r) => s + (Number(r[field]) || 0), 0) / records.length : 0; break;
+        case 'min':   value = Math.min(...records.map((r) => Number(r[field]) || 0)); break;
+        case 'max':   value = Math.max(...records.map((r) => Number(r[field]) || 0)); break;
+        default:      value = records.length;
+      }
+    } catch {
+      value = '—';
+    }
+
+    const valueEl = el.querySelector('.nv-stat-value');
+    if (valueEl) {
+      const formatted = typeof value === 'number' ? value.toLocaleString() : value;
+      valueEl.textContent = `${prefix}${formatted}${suffix}`;
+    }
+  }
+
+  _refresh();
+  _cleanupFns.push(() => destroyComponentState(instanceId));
+}
+
+// ─── Show-If Hydration ────────────────────────────────────────────────────────
+
+function _hydrateShowIf(el, pageId, instanceId) {
+  const stateKey   = el.dataset.nvStateKey;
+  const condition  = el.dataset.nvCondition  || 'truthy';
+  const value      = el.dataset.nvValue      || '';
+  const stateScope = el.dataset.nvScope      || 'page';
+
+  if (!stateKey) return;
+
+  const { appState } = require('../state/stateManager.js');
+  const stateNode = stateScope === 'app' ? appState : getPageState(pageId);
+
+  function _evaluate(val) {
+    switch (condition) {
+      case 'truthy':     return Boolean(val);
+      case 'falsy':      return !val;
+      case 'equals':     return String(val) === value;
+      case 'not-equals': return String(val) !== value;
+      case 'gt':         return Number(val) > Number(value);
+      case 'lt':         return Number(val) < Number(value);
+      default:           return Boolean(val);
+    }
+  }
+
+  // Remove placeholder, hide content initially
+  const placeholder = el.querySelector('.nv-logic-placeholder');
+  if (placeholder) placeholder.style.display = 'none';
+
+  const unsub = bindVisibility(el, stateNode, stateKey, _evaluate);
+  _cleanupFns.push(unsub, () => destroyComponentState(instanceId));
+}
+
+// ─── Loading Gate Hydration ───────────────────────────────────────────────────
+
+function _hydrateLoadingGate(el, pageId, instanceId) {
+  const stateKey   = el.dataset.nvStateKey || 'isLoading';
+  const stateScope = el.dataset.nvScope    || 'page';
+
+  const stateNode = stateScope === 'app' ? appState : getPageState(pageId);
+
+  const spinnerEl = el.querySelector('.nv-loading-spinner');
+  const contentEl = el.querySelector('.nv-loading-content');
+
+  function _update(isLoading) {
+    if (spinnerEl) spinnerEl.style.display = isLoading ? 'flex' : 'none';
+    if (contentEl) contentEl.style.display = isLoading ? 'none' : '';
+  }
+
+  _update(stateNode.get(stateKey));
+  const unsub = stateNode.subscribe(stateKey, _update);
+  _cleanupFns.push(unsub, () => destroyComponentState(instanceId));
+}
+
+// ─── Action Wiring ────────────────────────────────────────────────────────────
+
+/**
+ * Find all `[data-nv-action]` elements not inside a component
+ * (component-internal actions are wired during hydration) and wire them up.
+ *
+ * @param {HTMLElement} root
+ * @param {string}      pageId
+ */
+function _wireActions(root, pageId) {
+  // Only wire top-level action buttons not already inside a component
+  const actionEls = root.querySelectorAll('[data-nv-action]:not([data-nv-component] [data-nv-action])');
+
+  actionEls.forEach((el) => {
+    const actionId = el.dataset.nvAction;
+    const config   = _parseDataConfig(el);
+
+    el.addEventListener('click', (event) => {
+      ActionEngine.run(actionId, {
+        actionId,
+        element: el,
+        pageId,
+        config,
+        event,
+      });
+    });
+  });
+}
+
+// ─── State Bindings ───────────────────────────────────────────────────────────
+
+/**
+ * Wire all `[data-nv-bind]` elements to their state keys.
+ *
+ * @param {HTMLElement} root
+ * @param {string}      pageId
+ */
+function _wireStateBindings(root, pageId) {
+  const pageState = getPageState(pageId);
+
+  root.querySelectorAll('[data-nv-bind]').forEach((el) => {
+    const key = el.dataset.nvBind;
+    const unsub = bindState(el, pageState, key, (element, val) => {
+      if (val === null || val === undefined) return;
+      element.textContent = typeof val === 'object' ? JSON.stringify(val) : String(val);
+    });
+    _cleanupFns.push(unsub);
+  });
+
+  root.querySelectorAll('[data-nv-bind-write]').forEach((el) => {
+    const key = el.dataset.nvBindWrite;
+    el.addEventListener('input', (e) => {
+      pageState.set(key, e.target.value);
+    });
+  });
+}
+
+// ─── Initial Data Fetch ───────────────────────────────────────────────────────
+
+/**
+ * Trigger an initial `fetch` action for all data-bound components.
+ *
+ * @param {HTMLElement} root
+ * @param {string}      pageId
+ */
+function _fetchAllComponents(root, pageId) {
+  root.querySelectorAll('[data-nv-collection]').forEach((el) => {
+    const collectionId = el.dataset.nvCollection;
+    const instanceId   = el.dataset.nvInstance;
+    if (!collectionId) return;
+
+    ActionEngine.run('fetch', {
+      actionId:   'fetch',
+      element:    el,
+      pageId,
+      instanceId,
+      config:     { collectionId },
+    });
+  });
+}
+
+// ─── Helpers ──────────────────────────────────────────────────────────────────
+
+function _generateInstanceId(prefix) {
+  return `${prefix}-${Math.random().toString(36).slice(2, 8)}`;
+}
+
+function _renderEmptyState(el, message) {
+  if (!el) return;
+  el.innerHTML = `<tr><td colspan="99" style="text-align:center;padding:24px;color:#9ca3af;">${message}</td></tr>`;
+}
+
+function _formatCellValue(value, field) {
+  if (value === null || value === undefined) return '<span style="color:#d1d5db;">—</span>';
+
+  if (field?.type === 'boolean') {
+    return value
+      ? '<span class="nv-badge nv-badge-success">Yes</span>'
+      : '<span class="nv-badge nv-badge-neutral">No</span>';
+  }
+
+  if (field?.type === 'select') {
+    const colorMap = {
+      'Active': 'success', 'Published': 'success', 'Delivered': 'success', 'In Stock': 'success',
+      'Pending': 'warning', 'Processing': 'warning', 'Lead': 'info',
+      'Cancelled': 'danger', 'Churned': 'danger',
+    };
+    const color = colorMap[value] || 'neutral';
+    return `<span class="nv-badge nv-badge-${color}">${_escapeHtml(String(value))}</span>`;
+  }
+
+  return _escapeHtml(String(value));
+}
+
+function _escapeHtml(str) {
+  return str
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+function _parseDataConfig(el) {
+  const config = {};
+  for (const attr of el.attributes) {
+    if (attr.name.startsWith('data-nv-config-')) {
+      const key = attr.name.replace('data-nv-config-', '').replace(/-([a-z])/g, (_, c) => c.toUpperCase());
+      config[key] = attr.value;
+    }
+  }
+  return config;
+}
diff --git a/src/state/stateManager.js b/src/state/stateManager.js
new file mode 100644
index 0000000..a9ab2e7
--- /dev/null
+++ b/src/state/stateManager.js
@@ -0,0 +1,386 @@
+/**
+ * Nuvra Builder — State Management System  (Phase 3)
+ *
+ * Provides three tiers of reactive state for Nuvra app pages:
+ *
+ *  ┌──────────────────────────────────────────────────────────────────────┐
+ *  │  APP STATE      Global, persists across page navigation             │
+ *  │    e.g. { currentUser, theme, featureFlags }                        │
+ *  │                                                                      │
+ *  │  PAGE STATE     Scoped to one page, reset on navigation             │
+ *  │    e.g. { activeTab, searchQuery, isModalOpen }                     │
+ *  │                                                                      │
+ *  │  COMPONENT STATE  Scoped to one component instance                  │
+ *  │    e.g. { isLoading, errorMessage, selectedRowId }                  │
+ *  └──────────────────────────────────────────────────────────────────────┘
+ *
+ * All three tiers use the same reactive `StateNode` primitive, which
+ * supports `get`, `set`, `patch`, `reset`, and `subscribe`.
+ *
+ * Design decisions:
+ *  - No framework dependency. Pure vanilla JS with a simple pub/sub model.
+ *  - State is schema-driven: each StateNode is created with a `schema`
+ *    that defines the allowed keys and their default values.
+ *  - Component state is keyed by component instance ID, so multiple
+ *    instances of the same component type have independent state.
+ *  - App state is persisted to sessionStorage (survives refresh, not
+ *    browser close). Page and component state are in-memory only.
+ *  - The `subscribe` method returns an unsubscribe function, following
+ *    the same pattern as onCollectionChange() in collectionManager.js.
+ */
+
+'use strict';
+
+// ─── StateNode ────────────────────────────────────────────────────────────────
+
+/**
+ * @typedef {Object} StateSchema
+ * @property {Object.<string, { default: *, type?: string, description?: string }>} fields
+ */
+
+/**
+ * A single reactive state container.
+ * Used internally for all three state tiers.
+ */
+class StateNode {
+  /**
+   * @param {string} id       - Unique identifier (for debug logs)
+   * @param {StateSchema} schema - Defines the allowed keys and defaults
+   * @param {object} [initial] - Optional initial values (overrides defaults)
+   */
+  constructor(id, schema, initial = {}) {
+    this._id        = id;
+    this._schema    = schema;
+    this._listeners = new Map(); // key → Set<Function>
+    this._anyListeners = new Set(); // listeners for any change
+
+    // Build initial state from schema defaults + provided overrides
+    this._state = {};
+    for (const [key, def] of Object.entries(schema)) {
+      const defaultVal = typeof def.default === 'function' ? def.default() : def.default;
+      this._state[key] = initial[key] !== undefined ? initial[key] : defaultVal;
+    }
+  }
+
+  /**
+   * Get the current value of a key, or the entire state object.
+   *
+   * @param {string} [key]
+   * @returns {*}
+   */
+  get(key) {
+    if (key === undefined) return { ...this._state };
+    if (!(key in this._schema)) {
+      console.warn(`[State:${this._id}] Unknown key "${key}".`);
+      return undefined;
+    }
+    return this._state[key];
+  }
+
+  /**
+   * Set a single key to a new value.
+   * Notifies all subscribers for that key and any-change subscribers.
+   *
+   * @param {string} key
+   * @param {*} value
+   */
+  set(key, value) {
+    if (!(key in this._schema)) {
+      console.warn(`[State:${this._id}] Cannot set unknown key "${key}".`);
+      return;
+    }
+
+    const prev = this._state[key];
+    if (prev === value) return; // no-op if unchanged
+
+    this._state[key] = value;
+    this._notify(key, value, prev);
+  }
+
+  /**
+   * Patch multiple keys at once (shallow merge).
+   *
+   * @param {object} updates - { key: value, ... }
+   */
+  patch(updates) {
+    for (const [key, value] of Object.entries(updates)) {
+      this.set(key, value);
+    }
+  }
+
+  /**
+   * Reset all keys to their schema defaults.
+   */
+  reset() {
+    for (const [key, def] of Object.entries(this._schema)) {
+      const defaultVal = typeof def.default === 'function' ? def.default() : def.default;
+      this.set(key, defaultVal);
+    }
+  }
+
+  /**
+   * Subscribe to changes on a specific key.
+   * Returns an unsubscribe function.
+   *
+   * @param {string} key
+   * @param {Function} handler - (newValue, prevValue) => void
+   * @returns {Function} unsubscribe
+   */
+  subscribe(key, handler) {
+    if (!this._listeners.has(key)) {
+      this._listeners.set(key, new Set());
+    }
+    this._listeners.get(key).add(handler);
+    return () => this._listeners.get(key)?.delete(handler);
+  }
+
+  /**
+   * Subscribe to any state change.
+   * Handler receives (key, newValue, prevValue).
+   *
+   * @param {Function} handler
+   * @returns {Function} unsubscribe
+   */
+  subscribeAll(handler) {
+    this._anyListeners.add(handler);
+    return () => this._anyListeners.delete(handler);
+  }
+
+  _notify(key, newVal, prevVal) {
+    this._listeners.get(key)?.forEach((fn) => {
+      try { fn(newVal, prevVal); } catch (e) { console.error(`[State:${this._id}] Subscriber error:`, e); }
+    });
+    this._anyListeners.forEach((fn) => {
+      try { fn(key, newVal, prevVal); } catch (e) { console.error(`[State:${this._id}] Subscriber error:`, e); }
+    });
+  }
+}
+
+// ─── App State ────────────────────────────────────────────────────────────────
+
+const APP_STATE_KEY = 'nuvra-app-state-v1';
+
+/**
+ * The app-level state schema.
+ * Extend this as Nuvra grows (e.g., add `currentUser` when auth is added).
+ *
+ * @type {StateSchema}
+ */
+const APP_STATE_SCHEMA = {
+  theme:        { default: 'dark',  type: 'string',  description: 'UI theme: light or dark' },
+  accentColor:  { default: '#7c6af7', type: 'string', description: 'Primary accent color' },
+  currentPageId:{ default: null,    type: 'string',  description: 'Currently active page ID' },
+  sidebarTab:   { default: 'blocks', type: 'string', description: 'Active sidebar tab' },
+};
+
+/**
+ * Load persisted app state from sessionStorage.
+ * @returns {object}
+ */
+function _loadAppState() {
+  try {
+    const raw = sessionStorage.getItem(APP_STATE_KEY);
+    return raw ? JSON.parse(raw) : {};
+  } catch {
+    return {};
+  }
+}
+
+/**
+ * The global app-level state node.
+ * Persists to sessionStorage on every change.
+ *
+ * @type {StateNode}
+ */
+export const appState = new StateNode('app', APP_STATE_SCHEMA, _loadAppState());
+
+// Persist app state on every change
+appState.subscribeAll(() => {
+  try {
+    sessionStorage.setItem(APP_STATE_KEY, JSON.stringify(appState.get()));
+  } catch { /* quota exceeded — ignore */ }
+});
+
+// ─── Page State ───────────────────────────────────────────────────────────────
+
+/**
+ * Default schema for page-level state.
+ * Individual pages can extend this via their PageConfig (see pageSemantics.js).
+ *
+ * @type {StateSchema}
+ */
+const DEFAULT_PAGE_STATE_SCHEMA = {
+  isLoading:    { default: false,  type: 'boolean', description: 'Whether the page is loading data' },
+  errorMessage: { default: null,   type: 'string',  description: 'Current error message, if any' },
+  searchQuery:  { default: '',     type: 'string',  description: 'Current search/filter query' },
+  activeTab:    { default: 0,      type: 'number',  description: 'Active tab index' },
+  selectedId:   { default: null,   type: 'string',  description: 'Currently selected record ID' },
+  currentPage:  { default: 1,      type: 'number',  description: 'Current pagination page' },
+  pageSize:     { default: 20,     type: 'number',  description: 'Records per page' },
+  sortBy:       { default: null,   type: 'string',  description: 'Field to sort by' },
+  sortDir:      { default: 'asc',  type: 'string',  description: 'Sort direction: asc or desc' },
+};
+
+/** @type {Map<string, StateNode>} pageId → StateNode */
+const _pageStates = new Map();
+
+/**
+ * Get (or create) the state node for a page.
+ * Page state is reset when the page is navigated away from.
+ *
+ * @param {string} pageId
+ * @param {StateSchema} [extraSchema] - Additional state keys specific to this page
+ * @returns {StateNode}
+ */
+export function getPageState(pageId, extraSchema = {}) {
+  if (!_pageStates.has(pageId)) {
+    const schema = { ...DEFAULT_PAGE_STATE_SCHEMA, ...extraSchema };
+    _pageStates.set(pageId, new StateNode(`page:${pageId}`, schema));
+  }
+  return _pageStates.get(pageId);
+}
+
+/**
+ * Reset and destroy the state node for a page.
+ * Call this when navigating away from a page to free memory.
+ *
+ * @param {string} pageId
+ */
+export function resetPageState(pageId) {
+  _pageStates.get(pageId)?.reset();
+  _pageStates.delete(pageId);
+}
+
+// ─── Component State ──────────────────────────────────────────────────────────
+
+/**
+ * Default schema for component-level state.
+ *
+ * @type {StateSchema}
+ */
+const DEFAULT_COMPONENT_STATE_SCHEMA = {
+  isLoading:    { default: false, type: 'boolean', description: 'Whether the component is loading' },
+  isVisible:    { default: true,  type: 'boolean', description: 'Whether the component is visible' },
+  isDisabled:   { default: false, type: 'boolean', description: 'Whether the component is disabled' },
+  errorMessage: { default: null,  type: 'string',  description: 'Component-level error message' },
+  data:         { default: null,  type: 'any',     description: 'The component\'s bound data payload' },
+  selectedId:   { default: null,  type: 'string',  description: 'Selected item ID (for lists/tables)' },
+};
+
+/** @type {Map<string, StateNode>} componentInstanceId → StateNode */
+const _componentStates = new Map();
+
+/**
+ * Get (or create) the state node for a component instance.
+ *
+ * @param {string} instanceId - Unique ID for this component instance
+ * @param {StateSchema} [extraSchema] - Additional state keys for this component type
+ * @returns {StateNode}
+ */
+export function getComponentState(instanceId, extraSchema = {}) {
+  if (!_componentStates.has(instanceId)) {
+    const schema = { ...DEFAULT_COMPONENT_STATE_SCHEMA, ...extraSchema };
+    _componentStates.set(instanceId, new StateNode(`component:${instanceId}`, schema));
+  }
+  return _componentStates.get(instanceId);
+}
+
+/**
+ * Destroy the state node for a component instance.
+ * Call this when a component is removed from the canvas.
+ *
+ * @param {string} instanceId
+ */
+export function destroyComponentState(instanceId) {
+  _componentStates.delete(instanceId);
+}
+
+// ─── State Binding ────────────────────────────────────────────────────────────
+
+/**
+ * Bind a DOM element's attribute or text content to a state key.
+ * Returns an unsubscribe function.
+ *
+ * This is the core of Nuvra's conditional rendering and data binding.
+ * The runtime uses this to connect component state to the live DOM.
+ *
+ * @param {HTMLElement} element       - The DOM element to update
+ * @param {StateNode}   stateNode     - The state node to watch
+ * @param {string}      key           - The state key to watch
+ * @param {Function}    updateFn      - (element, newValue) => void
+ * @returns {Function} unsubscribe
+ *
+ * @example
+ * // Show/hide an element based on state
+ * bindState(myEl, pageState, 'isLoading', (el, val) => {
+ *   el.style.display = val ? 'block' : 'none';
+ * });
+ *
+ * // Update text content
+ * bindState(countEl, componentState, 'data', (el, val) => {
+ *   el.textContent = val?.length ?? 0;
+ * });
+ */
+export function bindState(element, stateNode, key, updateFn) {
+  // Apply immediately with current value
+  updateFn(element, stateNode.get(key));
+
+  // Subscribe to future changes
+  return stateNode.subscribe(key, (newVal) => {
+    updateFn(element, newVal);
+  });
+}
+
+// ─── Conditional Rendering ────────────────────────────────────────────────────
+
+/**
+ * Show or hide a DOM element based on a state condition.
+ * Returns an unsubscribe function.
+ *
+ * @param {HTMLElement} element
+ * @param {StateNode}   stateNode
+ * @param {string}      key
+ * @param {Function}    [conditionFn] - (value) => boolean. Defaults to Boolean(value).
+ * @returns {Function} unsubscribe
+ */
+export function bindVisibility(element, stateNode, key, conditionFn = Boolean) {
+  return bindState(element, stateNode, key, (el, val) => {
+    el.style.display = conditionFn(val) ? '' : 'none';
+  });
+}
+
+/**
+ * Enable or disable a form element based on a state condition.
+ *
+ * @param {HTMLElement} element
+ * @param {StateNode}   stateNode
+ * @param {string}      key
+ * @param {Function}    [conditionFn]
+ * @returns {Function} unsubscribe
+ */
+export function bindDisabled(element, stateNode, key, conditionFn = Boolean) {
+  return bindState(element, stateNode, key, (el, val) => {
+    el.disabled = conditionFn(val);
+  });
+}
+
+// ─── State Snapshot ───────────────────────────────────────────────────────────
+
+/**
+ * Export a snapshot of all current state for debugging or project serialization.
+ *
+ * @returns {{ app: object, pages: object, components: object }}
+ */
+export function getStateSnapshot() {
+  const pages = {};
+  _pageStates.forEach((node, id) => { pages[id] = node.get(); });
+
+  const components = {};
+  _componentStates.forEach((node, id) => { components[id] = node.get(); });
+
+  return {
+    app:        appState.get(),
+    pages,
+    components,
+  };
+}
diff --git a/src/ui/styles.css b/src/ui/styles.css
new file mode 100644
index 0000000..31daf56
--- /dev/null
+++ b/src/ui/styles.css
@@ -0,0 +1,1435 @@
+/* ============================================================
+   NUVRA BUILDER — Main Stylesheet
+   Organized: reset → layout → topbar → sidebar → canvas → blocks → modals
+   ============================================================ */
+
+/* ----- Reset & Base ----- */
+*, *::before, *::after {
+  box-sizing: border-box;
+}
+
+body, html {
+  height: 100%;
+  margin: 0;
+  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+  background: #0b0b0f;
+  color: #e5e5e5;
+}
+
+/* ----- Layout Shell ----- */
+#app {
+  display: flex;
+  height: calc(100vh - 48px);
+  overflow: hidden;
+}
+
+/* ----- Top Bar ----- */
+#topbar {
+  height: 48px;
+  background: #0b0b0f;
+  color: #fff;
+  display: flex;
+  align-items: center;
+  padding: 0 16px;
+  gap: 6px;
+  border-bottom: 1px solid #1e1e2e;
+  position: relative;
+  z-index: 100;
+  flex-wrap: nowrap;
+  overflow-x: auto;
+}
+
+#topbar .brand {
+  font-weight: 700;
+  font-size: 16px;
+  letter-spacing: -0.3px;
+  color: #fff;
+  margin-right: 8px;
+  white-space: nowrap;
+  flex-shrink: 0;
+}
+
+#topbar .brand span {
+  color: #7c6af7;
+}
+
+#topbar .divider {
+  width: 1px;
+  height: 20px;
+  background: #2a2a3a;
+  margin: 0 4px;
+  flex-shrink: 0;
+}
+
+/* ----- Top Bar Buttons ----- */
+.nuvra-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  padding: 5px 11px;
+  border-radius: 6px;
+  border: 1px solid #2a2a3a;
+  background: #16161f;
+  color: #ccc;
+  font-size: 12px;
+  font-weight: 500;
+  cursor: pointer;
+  white-space: nowrap;
+  transition: background 0.15s, border-color 0.15s, color 0.15s;
+  flex-shrink: 0;
+}
+
+.nuvra-btn:hover {
+  background: #1e1e2e;
+  border-color: #3a3a4a;
+  color: #fff;
+}
+
+.nuvra-btn.primary {
+  background: #7c6af7;
+  border-color: #7c6af7;
+  color: #fff;
+}
+
+.nuvra-btn.primary:hover {
+  background: #6b59e6;
+  border-color: #6b59e6;
+}
+
+.nuvra-btn.danger:hover {
+  background: #2a1a1a;
+  border-color: #7c3a3a;
+  color: #f87171;
+}
+
+/* ----- Page Selector ----- */
+#pageSelect {
+  background: #16161f;
+  border: 1px solid #2a2a3a;
+  color: #ccc;
+  padding: 4px 8px;
+  border-radius: 6px;
+  font-size: 12px;
+  cursor: pointer;
+  max-width: 140px;
+  flex-shrink: 0;
+}
+
+#pageSelect:focus {
+  outline: none;
+  border-color: #7c6af7;
+}
+
+/* ----- AI Prompt Bar ----- */
+#aiPrompt {
+  background: #16161f;
+  border: 1px solid #2a2a3a;
+  color: #e5e5e5;
+  padding: 5px 11px;
+  border-radius: 6px;
+  font-size: 12px;
+  width: 220px;
+  flex-shrink: 1;
+  min-width: 100px;
+  transition: border-color 0.15s;
+}
+
+#aiPrompt::placeholder {
+  color: #555;
+}
+
+#aiPrompt:focus {
+  outline: none;
+  border-color: #7c6af7;
+}
+
+/* ----- AI Status Indicator ----- */
+#aiStatus {
+  font-size: 11px;
+  color: #7c6af7;
+  white-space: nowrap;
+  flex-shrink: 0;
+  display: none;
+}
+
+#aiStatus.visible {
+  display: inline;
+}
+
+/* ----- Left Sidebar ----- */
+#sidebar {
+  width: 240px;
+  background: #111118;
+  border-right: 1px solid #1e1e2e;
+  overflow-y: auto;
+  flex-shrink: 0;
+  display: flex;
+  flex-direction: column;
+}
+
+#sidebar-tabs {
+  display: flex;
+  border-bottom: 1px solid #1e1e2e;
+  flex-shrink: 0;
+}
+
+.sidebar-tab {
+  flex: 1;
+  padding: 10px 0;
+  text-align: center;
+  font-size: 11px;
+  font-weight: 500;
+  color: #555;
+  cursor: pointer;
+  border-bottom: 2px solid transparent;
+  transition: color 0.15s, border-color 0.15s;
+}
+
+.sidebar-tab:hover {
+  color: #999;
+}
+
+.sidebar-tab.active {
+  color: #7c6af7;
+  border-bottom-color: #7c6af7;
+}
+
+#sidebar-content {
+  flex: 1;
+  overflow-y: auto;
+  padding: 12px;
+}
+
+/* ----- Block Panel ----- */
+#blocks {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.gjs-blocks-c {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.gjs-block {
+  width: 100%;
+  padding: 11px 14px;
+  border-radius: 7px;
+  background: #16161f;
+  border: 1px solid #1e1e2e;
+  color: #ccc;
+  font-size: 13px;
+  font-weight: 500;
+  cursor: grab;
+  transition: background 0.15s, border-color 0.15s, transform 0.1s;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.gjs-block:hover {
+  background: #1e1e2e;
+  border-color: #3a3a4a;
+  color: #fff;
+  transform: translateY(-1px);
+}
+
+.gjs-block:active {
+  cursor: grabbing;
+  transform: translateY(0);
+}
+
+.gjs-block-label {
+  font-weight: 500;
+  font-size: 12px;
+}
+
+/* ----- Editor Canvas ----- */
+#gjs {
+  flex: 1;
+  overflow: hidden;
+  background: #1a1a2e;
+}
+
+/* GrapesJS overrides for dark theme */
+.gjs-editor {
+  background: #1a1a2e;
+}
+
+.gjs-cv-canvas {
+  background: #f0f0f0;
+}
+
+.gjs-toolbar {
+  background: #7c6af7;
+}
+
+.gjs-selected {
+  outline: 2px solid #7c6af7 !important;
+}
+
+.gjs-hovered {
+  outline: 1px dashed #7c6af7 !important;
+}
+
+/* ----- Modal Overlay ----- */
+.nuvra-modal-overlay {
+  position: fixed;
+  inset: 0;
+  background: rgba(0, 0, 0, 0.6);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: 1000;
+  backdrop-filter: blur(4px);
+}
+
+.nuvra-modal {
+  background: #16161f;
+  border: 1px solid #2a2a3a;
+  border-radius: 12px;
+  padding: 24px;
+  width: 420px;
+  max-width: 90vw;
+  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
+}
+
+.nuvra-modal h3 {
+  margin: 0 0 16px;
+  font-size: 16px;
+  font-weight: 600;
+  color: #fff;
+}
+
+.nuvra-modal input,
+.nuvra-modal textarea,
+.nuvra-modal select {
+  width: 100%;
+  background: #0b0b0f;
+  border: 1px solid #2a2a3a;
+  color: #e5e5e5;
+  padding: 8px 12px;
+  border-radius: 7px;
+  font-size: 13px;
+  margin-bottom: 12px;
+  font-family: inherit;
+  transition: border-color 0.15s;
+}
+
+.nuvra-modal input:focus,
+.nuvra-modal textarea:focus,
+.nuvra-modal select:focus {
+  outline: none;
+  border-color: #7c6af7;
+}
+
+.nuvra-modal textarea {
+  resize: vertical;
+  min-height: 80px;
+}
+
+.nuvra-modal-actions {
+  display: flex;
+  gap: 8px;
+  justify-content: flex-end;
