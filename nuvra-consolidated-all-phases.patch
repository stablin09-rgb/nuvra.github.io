++/**
++ * Nuvra Builder — Preview Renderer  (Phase 4)
++ *
++ * Assembles a complete, self-contained HTML document that can be loaded
++ * into the preview iframe and executed as a real application.
++ *
++ * ┌──────────────────────────────────────────────────────────────────────────┐
++ * │  Two render paths                                                        │
++ * │                                                                          │
++ * │  MARKETING pages  →  clean static HTML + CSS, no runtime scripts        │
++ * │  APP pages        →  HTML + CSS + serialized data snapshot              │
++ * │                       + inlined PreviewRuntime script                   │
++ * └──────────────────────────────────────────────────────────────────────────┘
++ *
++ * Design decisions:
++ *  - The preview document is 100% self-contained. It does not load any
++ *    external scripts or make network requests. This ensures it works
++ *    offline and loads instantly.
++ *  - For app pages, the data snapshot (collections + records) is serialized
++ *    as JSON and embedded in a <script> tag. The PreviewRuntime reads this
++ *    at startup to hydrate its in-memory DataStore.
++ *  - The PreviewRuntime is a self-contained, inlined version of the AppRuntime
++ *    that does not depend on ES modules. It is bundled as a plain IIFE string
++ *    by `previewRuntime.js` and injected here.
++ *  - Marketing pages get a minimal CSS reset and normalize to ensure they
++ *    render consistently regardless of the user's browser defaults.
++ */
++
++'use strict';
++
++import { isAppPage }                    from '../core/pageSemantics.js';
++import { dataStore }                    from '../data/dataModel.js';
++import { getPreviewRuntimeScript }      from './previewRuntime.js';
++
++// ─── Public API ───────────────────────────────────────────────────────────────
++
++/**
++ * Build a complete, self-contained HTML document for the preview iframe.
++ *
++ * @param {object} page     - The page object from the project state
++ * @param {string} pageId   - The page's ID
++ * @returns {string}        - A full HTML document string
++ */
++export function buildPreviewDocument(page, pageId) {
++  const pageType = page?.pageConfig?.type || 'landing';
++  const isApp    = isAppPage(pageType);
++
++  if (isApp) {
++    return _buildAppPreviewDocument(page, pageId, pageType);
++  } else {
++    return _buildMarketingPreviewDocument(page, pageId);
++  }
++}
++
++// ─── Marketing Preview ────────────────────────────────────────────────────────
++
++/**
++ * Build a clean static preview for marketing pages.
++ * No runtime scripts — just the user's HTML and CSS with a minimal reset.
++ *
++ * @param {object} page
++ * @param {string} pageId
++ * @returns {string}
++ */
++function _buildMarketingPreviewDocument(page, pageId) {
++  const title   = _escapeHtml(page.name || pageId);
++  const bodyHtml = page.html || '';
++  const css      = page.css  || '';
++
++  return `<!DOCTYPE html>
++<html lang="en">
++<head>
++  <meta charset="UTF-8" />
++  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
++  <title>${title}</title>
++  <style>
++    /* Nuvra Preview Reset */
++    *, *::before, *::after { box-sizing: border-box; }
++    body { margin: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
++    img { max-width: 100%; height: auto; }
++    a { color: inherit; }
++  </style>
++  <style id="nv-user-styles">
++${css}
++  </style>
++</head>
++<body>
++${bodyHtml}
++</body>
++</html>`;
++}
++
++// ─── App Preview ──────────────────────────────────────────────────────────────
