+        .map(([id, f]) => `${id}:${f.type}${f.required ? '!' : ''}`)
+        .join(', ');
+      return `- ${col.id} (${col.name}): { ${fields} }`;
+    }).join('\n');
+  }
+
+  // ── Private ──────────────────────────────────────────────────────────────
+
+  _getSchema(collectionId) {
+    const schema = this._schemas[collectionId];
+    if (!schema) {
+      throw new Error(`[DataStore] Collection "${collectionId}" does not exist.`);
+    }
+    return schema;
+  }
+
+  _persist() {
+    try {
+      localStorage.setItem(DATA_STORAGE_KEY, JSON.stringify({
+        version: 1,
+        schemas: this._schemas,
+        records: this._records,
+        savedAt: new Date().toISOString(),
+      }));
+    } catch (err) {
+      console.error('[DataStore] Failed to persist:', err);
+    }
+  }
+
+  _load() {
+    try {
+      const raw = localStorage.getItem(DATA_STORAGE_KEY);
+      if (!raw) return;
+      const parsed = JSON.parse(raw);
+      if (parsed?.schemas) this._schemas = parsed.schemas;
+      if (parsed?.records) this._records = parsed.records;
+      console.info(`[DataStore] Loaded ${Object.keys(this._schemas).length} collection(s).`);
+    } catch (err) {
+      console.warn('[DataStore] Failed to load from storage — starting fresh.', err);
+    }
+  }
+}
+
+// ─── Private Helpers ──────────────────────────────────────────────────────────
+
+/**
+ * Generate a short unique ID for records.
+ * Format: 8 random alphanumeric characters.
+ *
+ * @returns {string}
+ */
+function _generateId() {
+  return Math.random().toString(36).slice(2, 10);
+}
+
+/**
+ * Get the default value for a field definition.
+ * Handles factory functions (e.g., date defaults).
+ *
+ * @param {FieldDefinition} field
+ * @returns {*}
+ */
+function _getDefaultValue(field) {
+  const typeDefault = FIELD_TYPES[field.type]?.defaultValue;
+  const raw = field.default !== undefined ? field.default : typeDefault;
+  return typeof raw === 'function' ? raw() : raw;
+}
+
+/**
+ * Build a new DataRecord from a schema and input data.
+ * Fills missing fields with defaults, validates required fields.
+ *
+ * @param {CollectionSchema} schema
+ * @param {object} data
+ * @returns {DataRecord}
+ */
+function _buildRecord(schema, data) {
+  const record = {
+    _id:        _generateId(),
+    _createdAt: new Date().toISOString(),
+    _updatedAt: new Date().toISOString(),
+  };
+
+  for (const [fieldId, field] of Object.entries(schema.fields)) {
+    const value = data[fieldId] !== undefined ? data[fieldId] : _getDefaultValue(field);
+
+    if (field.required && (value === null || value === undefined || value === '')) {
+      throw new Error(
+        `[DataStore] Required field "${fieldId}" is missing in collection "${schema.id}".`
+      );
+    }
+
+    record[fieldId] = value;
+  }
+
+  return record;
+}
+
+/**
+ * Validate only the fields present in a partial update object.
+ *
+ * @param {CollectionSchema} schema
+ * @param {object} data
+ * @returns {string[]} Array of error messages (empty = valid)
+ */
+function _validatePartial(schema, data) {
+  const errors = [];
+  for (const [fieldId, value] of Object.entries(data)) {
+    if (fieldId.startsWith('_')) continue; // skip internal fields
+    const field = schema.fields[fieldId];
+    if (!field) {
+      errors.push(`Unknown field "${fieldId}" in collection "${schema.id}".`);
+      continue;
+    }
+    if (field.required && (value === null || value === undefined || value === '')) {
+      errors.push(`Required field "${fieldId}" cannot be empty.`);
+    }
+  }
+  return errors;
+}
+
+// ─── Singleton Export ─────────────────────────────────────────────────────────
+
+/**
+ * The global DataStore singleton.
+ * Import this in any module that needs to read or write data.
+ *
+ * @type {DataStore}
+ */
+export const dataStore = new DataStore();
diff --git a/src/preview/previewManager.js b/src/preview/previewManager.js
new file mode 100644
index 0000000..9452e5f
--- /dev/null
+++ b/src/preview/previewManager.js
@@ -0,0 +1,374 @@
+/**
+ * Nuvra Builder — Preview Manager  (Phase 4)
+ *
+ * Orchestrates the toggle between Build mode (GrapesJS editor) and
+ * Preview mode (live execution iframe).
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────┐
+ * │  Mode Lifecycle                                                          │
+ * │                                                                          │
+ * │  BUILD MODE (default)                                                    │
+ * │    - GrapesJS editor is visible and interactive                         │
+ * │    - Sidebar is visible                                                  │
+ * │    - Top bar shows all editing controls                                  │
+ * │                                                                          │
+ * │  PREVIEW MODE                                                            │
+ * │    - GrapesJS editor is hidden                                           │
+ * │    - Sidebar is hidden (more canvas space)                               │
+ * │    - A full-screen iframe replaces the canvas                            │
+ * │    - The iframe is loaded with a self-contained preview document         │
+ * │    - A minimal "Exit Preview" bar is shown at the top                    │
+ * │    - Keyboard shortcut: Escape to exit                                   │
+ * └──────────────────────────────────────────────────────────────────────────┘
+ *
+ * Design decisions:
+ *  - The preview iframe is created fresh every time Preview mode is entered.
+ *    This ensures the preview always reflects the latest editor state.
+ *  - The iframe uses `srcdoc` to load the preview document without any
+ *    network requests. This is faster and works offline.
+ *  - The iframe is sandboxed with `allow-scripts allow-same-origin` to
+ *    allow the PreviewRuntime to execute while preventing navigation away
+ *    from the builder.
+ *  - The preview document is built by `previewRenderer.js`, which handles
+ *    the two render paths (marketing vs. app pages).
+ *  - Viewport simulation is supported: the user can switch between
+ *    Desktop, Tablet, and Mobile widths while in preview mode.
+ */
+
+'use strict';
+
+import { buildPreviewDocument }  from './previewRenderer.js';
+import { getSnapshot }           from '../core/pageManager.js';
+import { showToast }             from '../utils/helpers.js';
+
+// ─── State ────────────────────────────────────────────────────────────────────
+
+let _isPreviewMode = false;
+let _previewIframe = null;
+let _editor        = null;
+
+/** Viewport presets for the preview toolbar */
+const VIEWPORTS = [
+  { id: 'desktop', label: 'Desktop', width: '100%',   icon: '🖥' },
+  { id: 'tablet',  label: 'Tablet',  width: '768px',  icon: '📱' },
+  { id: 'mobile',  label: 'Mobile',  width: '390px',  icon: '📲' },
+];
+
+let _currentViewport = 'desktop';
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * Initialise the PreviewManager with the GrapesJS editor instance.
+ * Must be called once after the editor is ready.
+ *
+ * @param {object} editor - GrapesJS editor instance
+ */
+export function initPreview(editor) {
+  _editor = editor;
+
+  // Keyboard shortcut: Escape to exit preview
+  document.addEventListener('keydown', (e) => {
+    if (e.key === 'Escape' && _isPreviewMode) {
+      exitPreview();
+    }
+    // Ctrl/Cmd + P to enter preview
+    if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
+      e.preventDefault();
+      if (_isPreviewMode) exitPreview();
+      else enterPreview();
+    }
+  });
+}
+
+/**
+ * Enter Preview mode.
+ * Hides the editor, builds the preview document, and shows the iframe.
+ */
+export function enterPreview() {
+  if (_isPreviewMode) return;
+  _isPreviewMode = true;
+
+  // Snapshot the current page before entering preview
+  const { pages, currentPage } = getSnapshot();
+  const page = pages[currentPage];
+
+  if (!page) {
+    showToast('No page to preview.', 'error');
+    _isPreviewMode = false;
+    return;
+  }
+
+  // Build the preview document
+  let previewHtml;
+  try {
+    previewHtml = buildPreviewDocument(page, currentPage);
+  } catch (err) {
+    console.error('[PreviewManager] Failed to build preview document:', err);
+    showToast(`Preview failed: ${err.message}`, 'error');
+    _isPreviewMode = false;
+    return;
+  }
+
+  // Hide the editor and sidebar
+  const gjs     = document.getElementById('gjs');
+  const sidebar = document.getElementById('sidebar');
+  const topbar  = document.getElementById('topbar');
+
+  if (gjs)     gjs.style.display     = 'none';
+  if (sidebar) sidebar.style.display = 'none';
+
+  // Show the preview overlay
+  const overlay = _createPreviewOverlay(page, currentPage);
+  document.getElementById('app').appendChild(overlay);
+
+  // Create and load the iframe
+  _previewIframe = _createPreviewIframe(previewHtml);
+  overlay.querySelector('#nv-preview-canvas').appendChild(_previewIframe);
+
+  // Update the topbar to show preview indicator
+  _showPreviewTopbar(topbar, page.name);
+
+  // Apply initial viewport
+  _applyViewport(_currentViewport);
+
+  console.info(`[PreviewManager] Entered preview for page "${currentPage}"`);
+}
+
+/**
+ * Exit Preview mode.
+ * Destroys the iframe and restores the editor.
+ */
+export function exitPreview() {
+  if (!_isPreviewMode) return;
+  _isPreviewMode = false;
+
+  // Destroy the iframe
+  if (_previewIframe) {
+    _previewIframe.remove();
+    _previewIframe = null;
+  }
+
+  // Remove the preview overlay
+  const overlay = document.getElementById('nv-preview-overlay');
+  if (overlay) overlay.remove();
+
+  // Restore the editor and sidebar
+  const gjs     = document.getElementById('gjs');
+  const sidebar = document.getElementById('sidebar');
+  const topbar  = document.getElementById('topbar');
+
+  if (gjs)     gjs.style.display     = '';
+  if (sidebar) sidebar.style.display = '';
+
+  // Restore the topbar
+  _restoreTopbar(topbar);
+
+  console.info('[PreviewManager] Exited preview mode.');
+}
+
+/**
+ * Refresh the preview with the latest editor state.
+ * Only works when already in preview mode.
+ */
+export function refreshPreview() {
+  if (!_isPreviewMode) return;
+
+  const { pages, currentPage } = getSnapshot();
+  const page = pages[currentPage];
+  if (!page) return;
+
+  let previewHtml;
+  try {
+    previewHtml = buildPreviewDocument(page, currentPage);
+  } catch (err) {
+    showToast(`Preview refresh failed: ${err.message}`, 'error');
+    return;
+  }
+
+  if (_previewIframe) {
+    _previewIframe.srcdoc = previewHtml;
+  }
+
+  showToast('Preview refreshed.', 'info');
+}
+
+/**
+ * Returns true if the builder is currently in preview mode.
+ * @returns {boolean}
+ */
+export function isPreviewMode() {
+  return _isPreviewMode;
+}
+
+// ─── Preview Overlay ──────────────────────────────────────────────────────────
+
+/**
+ * Create the preview overlay element.
+ * This is a full-screen container that holds the viewport toolbar and the iframe.
+ *
+ * @param {object} page
+ * @param {string} pageId
+ * @returns {HTMLElement}
+ */
+function _createPreviewOverlay(page, pageId) {
+  const overlay = document.createElement('div');
+  overlay.id        = 'nv-preview-overlay';
+  overlay.className = 'nv-preview-overlay';
+
+  const pageType = page?.pageConfig?.type || 'landing';
+  const isApp    = ['dashboard', 'crud-list', 'crud-detail', 'form-page', 'settings', 'profile', 'report'].includes(pageType);
+
+  overlay.innerHTML = `
+    <div id="nv-preview-viewport-bar" class="nv-preview-viewport-bar">
+      <div class="nv-preview-viewport-label">
+        <span class="nv-preview-page-name">${_esc(page.name)}</span>
+        <span class="nv-preview-page-type ${isApp ? 'app' : 'marketing'}">${isApp ? 'App' : 'Marketing'}</span>
+      </div>
+      <div class="nv-preview-viewport-controls">
+        ${VIEWPORTS.map((vp) => `
+          <button
+            class="nv-preview-viewport-btn ${vp.id === _currentViewport ? 'active' : ''}"
+            data-viewport="${vp.id}"
+            title="${vp.label} (${vp.width})"
+          >${vp.icon} ${vp.label}</button>
+        `).join('')}
+      </div>
+      <div class="nv-preview-actions">
+        <button id="nv-btn-refresh-preview" class="nv-preview-btn" title="Refresh preview with latest changes">↺ Refresh</button>
+        <button id="nv-btn-exit-preview"    class="nv-preview-btn exit" title="Exit preview (Esc)">✕ Exit Preview</button>
+      </div>
+    </div>
+    <div id="nv-preview-canvas" class="nv-preview-canvas">
+      <!-- iframe will be inserted here -->
+    </div>
+  `;
+
+  // Wire viewport buttons
+  overlay.querySelectorAll('[data-viewport]').forEach((btn) => {
+    btn.addEventListener('click', () => {
+      _currentViewport = btn.dataset.viewport;
+      overlay.querySelectorAll('[data-viewport]').forEach((b) => b.classList.remove('active'));
+      btn.classList.add('active');
+      _applyViewport(_currentViewport);
+    });
+  });
+
+  // Wire exit button
+  overlay.querySelector('#nv-btn-exit-preview').addEventListener('click', exitPreview);
+
+  // Wire refresh button
+  overlay.querySelector('#nv-btn-refresh-preview').addEventListener('click', refreshPreview);
+
+  return overlay;
+}
+
+/**
+ * Create the preview iframe with the given HTML document.
+ *
+ * @param {string} html - The full HTML document to load
+ * @returns {HTMLIFrameElement}
+ */
+function _createPreviewIframe(html) {
+  const iframe = document.createElement('iframe');
+  iframe.id        = 'nv-preview-iframe';
+  iframe.className = 'nv-preview-iframe';
+
+  // Sandbox: allow scripts (for the runtime) and same-origin (for localStorage)
+  // Prevent navigation away from the builder
+  iframe.sandbox   = 'allow-scripts allow-same-origin allow-forms';
+  iframe.srcdoc    = html;
+  iframe.title     = 'Nuvra Preview';
+
+  return iframe;
+}
+
+// ─── Viewport Management ──────────────────────────────────────────────────────
+
+/**
+ * Apply a viewport preset to the preview iframe.
+ *
+ * @param {string} viewportId
+ */
+function _applyViewport(viewportId) {
+  const vp     = VIEWPORTS.find((v) => v.id === viewportId) || VIEWPORTS[0];
+  const canvas = document.getElementById('nv-preview-canvas');
+  const iframe = document.getElementById('nv-preview-iframe');
+
+  if (!canvas || !iframe) return;
+
+  if (vp.width === '100%') {
+    // Desktop: full width, no wrapper
+    canvas.classList.remove('nv-preview-device-frame');
+    iframe.style.width  = '100%';
+    iframe.style.height = '100%';
+    iframe.style.borderRadius = '0';
+    iframe.style.boxShadow    = 'none';
+  } else {
+    // Tablet / Mobile: centred device frame
+    canvas.classList.add('nv-preview-device-frame');
+    iframe.style.width        = vp.width;
+    iframe.style.height       = '100%';
+    iframe.style.borderRadius = '12px';
+    iframe.style.boxShadow    = '0 8px 40px rgba(0,0,0,0.4)';
+  }
+}
+
+// ─── Topbar Management ────────────────────────────────────────────────────────
+
+/**
+ * Replace the topbar content with a minimal preview indicator.
+ * Stores the original content so it can be restored on exit.
+ *
+ * @param {HTMLElement} topbar
+ * @param {string}      pageName
+ */
+function _showPreviewTopbar(topbar, pageName) {
+  if (!topbar) return;
+
+  // Store original content
+  topbar.dataset.originalContent = topbar.innerHTML;
+
+  topbar.innerHTML = `
+    <span class="brand">Nu<span>vra</span></span>
+    <div class="divider"></div>
+    <span class="nv-preview-topbar-label">
+      Preview: <strong>${_esc(pageName)}</strong>
+    </span>
+    <div style="flex:1;"></div>
+    <span class="nv-preview-topbar-hint">Press <kbd>Esc</kbd> or click Exit to return to the editor</span>
+    <div class="divider"></div>
+    <button id="nv-topbar-exit-preview" class="nuvra-btn primary">✕ Exit Preview</button>
+  `;
+
+  topbar.querySelector('#nv-topbar-exit-preview')?.addEventListener('click', exitPreview);
+}
+
+/**
+ * Restore the topbar to its original content.
+ *
+ * @param {HTMLElement} topbar
+ */
+function _restoreTopbar(topbar) {
+  if (!topbar || !topbar.dataset.originalContent) return;
+  topbar.innerHTML = topbar.dataset.originalContent;
+  delete topbar.dataset.originalContent;
+
+  // Re-wire the topbar buttons that were replaced
+  // (app.js handles this via event delegation, but we need to
+  //  re-attach the page type selector's change handler)
+  const pageTypeSelect = document.getElementById('page-type-select');
+  if (pageTypeSelect) {
+    pageTypeSelect.dispatchEvent(new Event('nv-topbar-restored'));
+  }
+}
+
+// ─── Helpers ──────────────────────────────────────────────────────────────────
+
+function _esc(str) {
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
diff --git a/src/preview/previewRenderer.js b/src/preview/previewRenderer.js
new file mode 100644
index 0000000..64dafff
--- /dev/null
+++ b/src/preview/previewRenderer.js
@@ -0,0 +1,312 @@
+/**
+ * Nuvra Builder — Preview Renderer  (Phase 4)
+ *
+ * Assembles a complete, self-contained HTML document that can be loaded
+ * into the preview iframe and executed as a real application.
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────┐
+ * │  Two render paths                                                        │
+ * │                                                                          │
+ * │  MARKETING pages  →  clean static HTML + CSS, no runtime scripts        │
+ * │  APP pages        →  HTML + CSS + serialized data snapshot              │
+ * │                       + inlined PreviewRuntime script                   │
+ * └──────────────────────────────────────────────────────────────────────────┘
+ *
+ * Design decisions:
+ *  - The preview document is 100% self-contained. It does not load any
+ *    external scripts or make network requests. This ensures it works
+ *    offline and loads instantly.
+ *  - For app pages, the data snapshot (collections + records) is serialized
+ *    as JSON and embedded in a <script> tag. The PreviewRuntime reads this
+ *    at startup to hydrate its in-memory DataStore.
+ *  - The PreviewRuntime is a self-contained, inlined version of the AppRuntime
+ *    that does not depend on ES modules. It is bundled as a plain IIFE string
+ *    by `previewRuntime.js` and injected here.
+ *  - Marketing pages get a minimal CSS reset and normalize to ensure they
+ *    render consistently regardless of the user's browser defaults.
+ */
+
+'use strict';
+
+import { isAppPage }                    from '../core/pageSemantics.js';
+import { dataStore }                    from '../data/dataModel.js';
+import { getPreviewRuntimeScript }      from './previewRuntime.js';
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * Build a complete, self-contained HTML document for the preview iframe.
+ *
+ * @param {object} page     - The page object from the project state
+ * @param {string} pageId   - The page's ID
+ * @returns {string}        - A full HTML document string
+ */
+export function buildPreviewDocument(page, pageId) {
+  const pageType = page?.pageConfig?.type || 'landing';
+  const isApp    = isAppPage(pageType);
+
+  if (isApp) {
+    return _buildAppPreviewDocument(page, pageId, pageType);
+  } else {
+    return _buildMarketingPreviewDocument(page, pageId);
+  }
+}
+
+// ─── Marketing Preview ────────────────────────────────────────────────────────
+
+/**
+ * Build a clean static preview for marketing pages.
+ * No runtime scripts — just the user's HTML and CSS with a minimal reset.
+ *
+ * @param {object} page
+ * @param {string} pageId
+ * @returns {string}
+ */
+function _buildMarketingPreviewDocument(page, pageId) {
+  const title   = _escapeHtml(page.name || pageId);
+  const bodyHtml = page.html || '';
+  const css      = page.css  || '';
+
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>${title}</title>
+  <style>
+    /* Nuvra Preview Reset */
+    *, *::before, *::after { box-sizing: border-box; }
+    body { margin: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
+    img { max-width: 100%; height: auto; }
+    a { color: inherit; }
+  </style>
+  <style id="nv-user-styles">
+${css}
+  </style>
+</head>
+<body>
+${bodyHtml}
+</body>
+</html>`;
+}
+
+// ─── App Preview ──────────────────────────────────────────────────────────────
+
+/**
+ * Build a fully executable preview document for app pages.
+ * Embeds the data snapshot and inlines the PreviewRuntime as an IIFE.
+ *
+ * @param {object} page
+ * @param {string} pageId
+ * @param {string} pageType
+ * @returns {string}
+ */
+function _buildAppPreviewDocument(page, pageId, pageType) {
+  const title    = _escapeHtml(page.name || pageId);
+  const bodyHtml = page.html || '';
+  const css      = page.css  || '';
+
+  // Serialize the current data snapshot so the preview has real data
+  const dataSnapshot = _serializeDataSnapshot();
+
+  // Get the inlined runtime script
+  const runtimeScript = getPreviewRuntimeScript();
+
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>${title}</title>
+  <style>
+    /* Nuvra Preview Reset */
+    *, *::before, *::after { box-sizing: border-box; }
+    body { margin: 0; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f8f9fa; }
+    img { max-width: 100%; height: auto; }
+    a { color: inherit; }
+
+    /* App Component Base Styles (inlined for self-containment) */
+    ${_getAppComponentStyles()}
+  </style>
+  <style id="nv-user-styles">
+${css}
+  </style>
+</head>
+<body>
+${bodyHtml}
+
+<!-- Nuvra Preview: Data Snapshot -->
+<script id="nv-data-snapshot" type="application/json">
+${JSON.stringify(dataSnapshot, null, 2)}
+</script>
+
+<!-- Nuvra Preview: Page Context -->
+<script id="nv-page-context" type="application/json">
+${JSON.stringify({ pageId, pageType }, null, 2)}
+</script>
+
+<!-- Nuvra Preview Runtime (inlined IIFE) -->
+<script>
+${runtimeScript}
+</script>
+
+</body>
+</html>`;
+}
+
+// ─── Data Snapshot Serialization ──────────────────────────────────────────────
+
+/**
+ * Serialize all collections and their records into a plain JSON object.
+ * This is the "data payload" that the preview runtime will use to hydrate
+ * its in-memory store.
+ *
+ * @returns {{ collections: object, records: object }}
+ */
+function _serializeDataSnapshot() {
+  const snapshot = {
+    collections: {},  // { [collectionId]: CollectionSchema }
+    records:     {},  // { [collectionId]: Record[] }
+  };
+
+  try {
+    const collectionIds = dataStore.listCollections();
+
+    for (const id of collectionIds) {
+      try {
+        const schema  = dataStore.getCollection(id);
+        const records = dataStore.query(id);
+
+        snapshot.collections[id] = {
+          id:     schema.id,
+          name:   schema.name,
+          fields: schema.fields,
+        };
+        snapshot.records[id] = records;
+      } catch {
+        // Skip collections that can't be serialized
+      }
+    }
+  } catch {
+    // dataStore not yet initialized — return empty snapshot
+  }
+
+  return snapshot;
+}
+
+// ─── Inlined App Component Styles ─────────────────────────────────────────────
+
+/**
