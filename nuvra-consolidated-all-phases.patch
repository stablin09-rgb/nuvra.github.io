++      pageManifestEntries.push({
++        id:      pageId,
++        name:    page.name,
++        type:    pageType,
++        file:    filename,
++        isHome:  filename === 'index.html',
++        error:   err.message,
++      });
++    }
++  }
++
++  // ── Build the site manifest ───────────────────────────────────────────────
++
++  const manifest = {
++    name:      options.siteName || 'Nuvra Site',
++    buildId,
++    builtAt:   new Date().toISOString(),
++    generator: 'Nuvra Builder',
++    version:   '1.0.0',
++    pages:     pageManifestEntries,
++    totalPages: pageIds.length,
++    warnings,
++  };
++
++  files.push({
++    path:    '_nuvra/manifest.json',
++    content: JSON.stringify(manifest, null, 2),
++    type:    'application/json',
++  });
++
++  // ── Build a root-level README for the output folder ───────────────────────
++
++  files.push({
++    path:    '_nuvra/README.md',
++    content: _buildReadme(manifest),
++    type:    'text/markdown',
++  });
++
++  return {
++    success:  warnings.length < pageIds.length,  // success if at least one page rendered
++    files,
++    manifest,
++    warnings,
++    duration: Date.now() - startTime,
++    buildId,
++  };
++}
