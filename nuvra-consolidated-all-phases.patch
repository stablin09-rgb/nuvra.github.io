+++ b/src/publish/siteBuilder.js
@@ -0,0 +1,298 @@
+/**
+ * Nuvra Builder — Site Builder  (Phase 4B)
+ *
+ * Assembles the complete, production-ready site bundle from the current
+ * project state. This is the orchestration layer of the publish pipeline.
+ *
+ * ┌──────────────────────────────────────────────────────────────────────────┐
+ * │  What the SiteBuilder produces                                           │
+ * │                                                                          │
+ * │  <site-name>.zip/                                                        │
+ * │    index.html              ← Home page (always index.html)              │
+ * │    about.html              ← Additional pages (slug-named)              │
+ * │    dashboard.html                                                        │
+ * │    nuvra.manifest.json     ← Machine-readable site manifest             │
+ * │    _nuvra/                                                               │
+ * │      README.md             ← Human-readable deployment guide            │
+ * └──────────────────────────────────────────────────────────────────────────┘
+ *
+ * Design decisions:
+ *  - The SiteBuilder uses `buildPublishDocument()` from the PublishRenderer,
+ *    NOT `buildPreviewDocument()` from the PreviewRenderer. This is the
+ *    critical Phase 4B change: the production output now has its own clean
+ *    render path, decoupled from the preview system.
+ *  - The SiteBuilder is a pure orchestrator. It has no rendering logic of
+ *    its own — it delegates to PublishRenderer and ManifestBuilder.
+ *  - Errors in individual pages are caught and reported without aborting
+ *    the build. The manifest records which pages failed.
+ *  - The SiteBuilder returns a `BuildResult` object. The PublishManager
+ *    is responsible for packaging this into a ZIP file or serving it
+ *    locally. This separation keeps the builder testable.
+ */
+
+'use strict';
+
+import { buildPublishDocument }         from './publishRenderer.js';
+import { buildManifest, serializeManifest } from './manifestBuilder.js';
+import { getSnapshot }                  from '../core/pageManager.js';
+import { slugify }                      from '../utils/helpers.js';
+
+// ─── Types ────────────────────────────────────────────────────────────────────
+
+/**
+ * @typedef {Object} SiteFile
+ * @property {string} path    - Relative path in the output bundle (e.g. "index.html")
+ * @property {string} content - File content as a string
+ * @property {string} type    - MIME type ('text/html' | 'application/json' | 'text/markdown')
+ */
+
+/**
+ * @typedef {Object} BuildResult
+ * @property {boolean}    success    - Whether the build completed without fatal errors
+ * @property {SiteFile[]} files      - All generated files
+ * @property {object}     manifest   - The parsed manifest object
+ * @property {string[]}   warnings   - Non-fatal warnings
+ * @property {number}     durationMs - Build duration in milliseconds
+ * @property {string}     buildId    - Unique build identifier
+ * @property {object[]}   pageList   - Flat list of { id, name, filename, isHome, isApp }
+ */
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * Build the complete site bundle from the current project state.
+ *
+ * @param {object}   [options]
+ * @param {string}   [options.siteName]    - User-provided site name
+ * @param {string}   [options.baseUrl]     - Optional canonical base URL
+ * @param {Function} [options.onProgress]  - Callback(pageId, index, total) for progress
+ * @returns {Promise<BuildResult>}
+ */
+export async function buildSite(options = {}) {
+  const startTime = Date.now();
+  const buildId   = `nuvra-build-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
+  const builtAt   = new Date().toISOString();
+
+  const siteName  = options.siteName || 'Nuvra Site';
+  const baseUrl   = options.baseUrl  || '';
+
+  const { pages } = getSnapshot();
+  const pageIds   = Object.keys(pages);
+  const warnings  = [];
+  const files     = [];
+  const pageList  = [];
+
+  if (pageIds.length === 0) {
+    return {
+      success:    false,
+      files:      [],
+      manifest:   null,
+      warnings:   ['No pages found in the project.'],
+      durationMs: Date.now() - startTime,
+      buildId,
+      pageList:   [],
+    };
+  }
+
+  // ── Build the page list (needed for the BuildContext) ─────────────────────
+
+  for (let i = 0; i < pageIds.length; i++) {
+    const pageId   = pageIds[i];
+    const page     = pages[pageId];
+    const pageType = page?.pageConfig?.type || 'landing';
+    const isApp    = ['dashboard', 'crud-list', 'crud-detail', 'form-page', 'settings', 'profile', 'report'].includes(pageType);
+    const filename = (pageId === 'home' || i === 0)
+      ? 'index.html'
+      : `${slugify(pageId) || pageId}.html`;
+
+    pageList.push({ id: pageId, name: page.name, filename, isHome: filename === 'index.html', isApp });
+  }
+
+  // ── BuildContext: site-wide metadata passed to the renderer ───────────────
+
+  const buildContext = { siteName, buildId, builtAt, baseUrl, allPages: pageList };
+
+  // ── Render each page ──────────────────────────────────────────────────────
+
+  for (let i = 0; i < pageIds.length; i++) {
+    const pageId = pageIds[i];
+    const page   = pages[pageId];
+    const entry  = pageList[i];
+
+    if (options.onProgress) {
+      options.onProgress(pageId, i + 1, pageIds.length);
+    }
+
+    try {
+      const html = buildPublishDocument(page, pageId, buildContext);
+
+      files.push({ path: entry.filename, content: html, type: 'text/html' });
+
+    } catch (err) {
+      const errMsg = `Page "${page.name}" (${pageId}) failed to render: ${err.message}`;
+      warnings.push(errMsg);
+      console.error('[SiteBuilder]', errMsg, err);
+
+      // Include a fallback error page so the ZIP always has the expected files
+      files.push({
+        path:    entry.filename,
+        content: _buildErrorPage(page.name, err.message),
+        type:    'text/html',
+      });
+    }
+  }
+
+  // ── Build the manifest ────────────────────────────────────────────────────
+
+  const manifest = buildManifest({
+    siteName,
+    buildId,
+    builtAt,
+    pages,
+    warnings,
+    totalFiles: files.length + 2,  // +2 for manifest + README
+    durationMs: Date.now() - startTime,
+    baseUrl,
+  });
+
+  files.push({
+    path:    'nuvra.manifest.json',
+    content: serializeManifest(manifest),
+    type:    'application/json',
+  });
+
+  // ── Build the deployment README ───────────────────────────────────────────
+
+  files.push({
+    path:    '_nuvra/README.md',
+    content: _buildReadme(manifest, siteName),
+    type:    'text/markdown',
+  });
+
+  return {
+    success:    warnings.length < pageIds.length,
+    files,
+    manifest,
+    warnings,
+    durationMs: Date.now() - startTime,
+    buildId,
+    pageList,
+  };
+}
+
+/**
+ * Get a lightweight summary of what the build will produce.
+ * Used to populate the publish modal before the user confirms.
+ *
+ * @returns {{ pageCount: number, appPageCount: number, marketingPageCount: number, pages: object[] }}
+ */
+export function getBuildSummary() {
+  const { pages } = getSnapshot();
+  const pageIds   = Object.keys(pages);
+
+  let appPageCount       = 0;
+  let marketingPageCount = 0;
+  const pageList         = [];
+
+  for (let i = 0; i < pageIds.length; i++) {
+    const pageId   = pageIds[i];
+    const page     = pages[pageId];
+    const pageType = page?.pageConfig?.type || 'landing';
+    const isApp    = ['dashboard', 'crud-list', 'crud-detail', 'form-page', 'settings', 'profile', 'report'].includes(pageType);
+    const filename = (pageId === 'home' || i === 0) ? 'index.html' : `${slugify(pageId) || pageId}.html`;
+
+    if (isApp) appPageCount++;
+    else marketingPageCount++;
+
+    pageList.push({ id: pageId, name: page.name, type: pageType, isApp, filename });
+  }
+
+  return { pageCount: pageIds.length, appPageCount, marketingPageCount, pages: pageList };
+}
+
+// ─── Private Helpers ──────────────────────────────────────────────────────────
+
+function _buildErrorPage(pageName, errorMessage) {
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Build Error</title>
+  <style>
+    body { margin: 0; font-family: system-ui, sans-serif; background: #f8f9fa; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
+    .box { background: #fff; border: 1px solid #e5e7eb; border-left: 4px solid #ef4444; border-radius: 10px; padding: 32px 40px; max-width: 500px; }
+    h1 { font-size: 18px; color: #ef4444; margin: 0 0 8px; }
+    p  { font-size: 13px; color: #6b7280; margin: 0 0 16px; }
+    pre { font-size: 12px; color: #ef4444; background: #fef2f2; padding: 12px; border-radius: 6px; overflow: auto; }
+  </style>
+</head>
+<body>
+  <div class="box">
+    <h1>Build Error</h1>
+    <p>The page <strong>${_esc(pageName)}</strong> failed to render.</p>
+    <pre>${_esc(errorMessage)}</pre>
+  </div>
+</body>
+</html>`;
+}
+
+function _buildReadme(manifest, siteName) {
+  const pageList = manifest.pages
+    .map((p) => `- \`${p.filename}\` — **${p.name}** (${p.kind}: ${p.type})`)
+    .join('\n');
+
+  const collectionList = manifest.dataModel.collections.length > 0
+    ? manifest.dataModel.collections
+        .map((c) => `- **${c.name}** (${c.fieldCount} fields, ${c.recordCount} records)`)
+        .join('\n')
+    : '_No data collections in this project._';
+
+  const warningBlock = manifest.build.warnings.length > 0
+    ? `\n### Build Warnings\n\n${manifest.build.warnings.map((w) => `- ${w}`).join('\n')}\n`
+    : '';
+
+  return `# ${siteName}
+
+Built with [Nuvra Builder](https://github.com/stablin09-rgb/nuvra.github.io)
+
+| Property | Value |
+|---|---|
+| **Build ID** | \`${manifest.buildId}\` |
+| **Built at** | ${manifest.builtAt} |
+| **Generator** | ${manifest.generator} |
+| **Pages** | ${manifest.pages.length} |
+| **Collections** | ${manifest.dataModel.collections.length} |
+
+## Pages
+
+${pageList}
+
+## Data Model
+
+${collectionList}
+
+## Deployment
+
+This is a static site bundle. Deploy by uploading the contents of this folder to any static host:
+
+| Host | Method |
+|---|---|
+| **GitHub Pages** | Push to a \`gh-pages\` branch or the \`/docs\` folder |
+| **Netlify** | Drag and drop the extracted folder into the Netlify dashboard |
+| **Vercel** | Run \`vercel deploy\` from the extracted folder |
+| **Any web server** | Copy all files to the server's public directory |
+
+> **Note for App Pages**: Pages with embedded runtimes require JavaScript to be enabled in the browser. They work on all modern browsers and do not require a server-side runtime.
+${warningBlock}
+---
+_Generated by Nuvra Builder — [nuvra.manifest.json](../nuvra.manifest.json)_
+`;
+}
+
+function _esc(str) {
+  return String(str || '')
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
