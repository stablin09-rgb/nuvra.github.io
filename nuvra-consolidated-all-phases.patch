+    [/\bservices\b/,                    6],
+    [/\bconsulting\b/,                  7],
+    [/\bdigital agency\b/,             10],
+    [/\bmarketing\b/,                   5],
+    [/\bbranding\b/,                    6],
+    [/\bweb agency\b/,                  9],
+    [/\bclients\b/,                     5],
+  ],
+  'app-homepage': [
+    [/\bmobile app\b/,                  9],
+    [/\bapp homepage\b/,               10],
+    [/\bapp landing\b/,                 9],
+    [/\bios app\b/,                     8],
+    [/\bandroid app\b/,                 8],
+    [/\bdownload\b/,                    5],
+    [/\bapp store\b/,                   7],
+    [/\bgoogle play\b/,                 7],
+  ],
+  'pricing': [
+    [/\bpricing\b/,                    10],
+    [/\bplans?\b/,                      8],
+    [/\btier\b/,                        7],
+    [/\bsubscription\b/,                6],
+    [/\bcost\b/,                        5],
+    [/\bfree trial\b/,                  7],
+  ],
+  'about': [
+    [/\babout\b/,                      10],
+    [/\bour story\b/,                   9],
+    [/\bwho we are\b/,                  9],
+    [/\bteam page\b/,                   9],
+    [/\bcompany page\b/,                8],
+    [/\bmission\b/,                     6],
