@@ -0,0 +1,337 @@
+/**
+ * Nuvra Builder — Site Planner
+ *
+ * Takes a `PromptIntent` (from the PromptAnalyser) and produces a `SitePlan`:
+ * a structured description of which pages to generate and which sections
+ * each page should contain, in what order, with what intent.
+ *
+ * This is the "thinking step" before schema generation.
+ * It separates the decision of *what to build* from *how to build it*.
+ *
+ * ─── SitePlan shape ───────────────────────────────────────────────────────────
+ * {
+ *   brand:       string,
+ *   accentColor: string,
+ *   fontFamily:  string,
+ *   pages: [
+ *     {
+ *       id:       string,      // URL slug, e.g. 'home'
+ *       name:     string,      // Display name, e.g. 'Home'
+ *       intent:   string,      // One-line description of the page's purpose
+ *       sections: [
+ *         {
+ *           type:   string,    // Section type matching SchemaRenderer registry
+ *           intent: string,    // Why this section is here
+ *         }
+ *       ]
+ *     }
+ *   ]
+ * }
+ *
+ * Design philosophy:
+ *  - The planner is a pure function: same input always produces the same plan.
+ *  - Section order follows proven UX patterns for each page type.
+ *  - Multi-page plans are coherent: nav links on each page reference the other pages.
+ *  - The planner does NOT generate content — that is the MockProvider's job.
+ */
+
+'use strict';
+
+// ─── Section Blueprints ───────────────────────────────────────────────────────
+// Each blueprint is a list of { type, intent } objects.
+// They represent the ideal section order for a given page type.
+// Optional sections (added based on detected features) are marked.
+
+const SECTION_BLUEPRINTS = {
+
+  'saas-landing': [
+    { type: 'navbar',      intent: 'Navigation with brand, links to Features/Pricing/Blog, and a CTA button' },
+    { type: 'hero',        intent: 'Dark hero with badge, bold headline, subtitle, and dual CTAs' },
+    { type: 'features',    intent: '6-item feature grid highlighting the core value propositions' },
+    { type: 'testimonial', intent: 'Social proof from a satisfied customer or team lead' },
+    // optional: pricing (added if feature detected)
+    // optional: faq (added if feature detected)
+    { type: 'cta',         intent: 'Final conversion section with strong headline and free trial CTA' },
+    { type: 'footer',      intent: 'Footer with brand, legal links, and status page' },
+  ],
+
+  'portfolio': [
+    { type: 'navbar',      intent: 'Minimal nav with name/brand and links to Work, About, Contact' },
+    { type: 'hero',        intent: 'Personal hero with name, role, and a brief positioning statement' },
+    { type: 'features',    intent: 'Skills or services grid — what the person does and how well' },
+    { type: 'testimonial', intent: 'Client or collaborator quote validating the work quality' },
+    { type: 'cta',         intent: 'Hire me / Get in touch CTA with contact prompt' },
+    { type: 'footer',      intent: 'Minimal footer with social links and copyright' },
+  ],
+
+  'agency': [
+    { type: 'navbar',      intent: 'Agency nav with Services, Work, About, Contact, and a project CTA' },
+    { type: 'hero',        intent: 'Bold agency hero with a punchy tagline and case study CTA' },
+    { type: 'features',    intent: 'Services grid: what the agency offers (design, dev, strategy, etc.)' },
+    { type: 'testimonial', intent: 'Client testimonial from a recognisable brand or project' },
+    { type: 'cta',         intent: 'Project inquiry CTA — "Let\'s work together"' },
+    { type: 'footer',      intent: 'Agency footer with services, social, and legal links' },
+  ],
+
+  'app-homepage': [
+    { type: 'navbar',      intent: 'App nav with Features, Pricing, and Download/Get App CTA' },
+    { type: 'hero',        intent: 'App hero with device mockup description, tagline, and app store CTAs' },
+    { type: 'features',    intent: '3–4 key app features with icons and short descriptions' },
+    { type: 'testimonial', intent: 'User review or app store rating quote' },
+    { type: 'cta',         intent: 'Download CTA with app store badge references' },
+    { type: 'footer',      intent: 'App footer with support, privacy, and legal links' },
+  ],
+
+  'blog': [
+    { type: 'navbar',      intent: 'Blog nav with Articles, Topics, Newsletter, and Subscribe CTA' },
+    { type: 'blog-header', intent: 'Blog masthead with name and tagline' },
+    { type: 'blog-grid',   intent: '6 recent articles in a 3-column card grid' },
+    { type: 'newsletter',  intent: 'Email subscription section to grow the audience' },
+    { type: 'footer',      intent: 'Blog footer with RSS, privacy, and terms links' },
+  ],
+
+  'ecommerce': [
+    { type: 'navbar',      intent: 'Shop nav with categories, cart icon, and account CTA' },
+    { type: 'hero',        intent: 'Promotional hero with seasonal offer or new collection headline' },
+    { type: 'features',    intent: 'Store trust signals: free shipping, easy returns, secure checkout' },
+    { type: 'cta',         intent: 'Shop now CTA or featured collection banner' },
+    { type: 'footer',      intent: 'Shop footer with shipping policy, returns, and contact' },
+  ],
+
+  'dashboard': [
+    { type: 'dashboard-header', intent: 'Dashboard title, date range, and export action' },
+    { type: 'stat-row',         intent: '4 KPI stat cards: revenue, users, signups, churn' },
+    { type: 'data-table',       intent: 'Recent transactions or activity log table' },
+  ],
+
+  'pricing': [
+    { type: 'navbar',         intent: 'Nav with Features, Docs, Blog, and Sign In' },
+    { type: 'pricing-header', intent: 'Clear pricing headline with transparency messaging' },
+    { type: 'pricing-grid',   intent: '3-tier pricing: Starter (free), Pro (paid), Enterprise (custom)' },
+    { type: 'faq',            intent: 'Common billing and plan questions' },
+    { type: 'footer',         intent: 'Footer with privacy, terms, and contact' },
+  ],
+
+  'about': [
+    { type: 'navbar',      intent: 'Nav consistent with the rest of the site' },
+    { type: 'hero',        intent: 'About hero with company mission or founder story headline' },
+    { type: 'features',    intent: 'Company values or founding principles grid' },
+    { type: 'testimonial', intent: 'Press quote or investor/partner endorsement' },
+    { type: 'cta',         intent: 'Join the team or contact us CTA' },
+    { type: 'footer',      intent: 'Standard site footer' },
+  ],
+
+  'contact': [
+    { type: 'navbar',      intent: 'Nav consistent with the rest of the site' },
+    { type: 'hero',        intent: 'Contact hero with a welcoming headline and response time promise' },
+    { type: 'newsletter',  intent: 'Reused as a contact/inquiry form section' },
+    { type: 'footer',      intent: 'Standard site footer' },
+  ],
+
+  'generic': [
+    { type: 'navbar',      intent: 'Standard nav with Home, About, Contact links' },
+    { type: 'hero',        intent: 'General-purpose hero with headline, subtitle, and CTA' },
+    { type: 'features',    intent: '3-item feature grid with key selling points' },
+    { type: 'cta',         intent: 'Conversion CTA at the bottom of the page' },
+    { type: 'footer',      intent: 'Standard site footer' },
+  ],
+};
+
+// ─── Multi-page Site Structures ───────────────────────────────────────────────
+// Defines which pages to generate for each site type in multi-page mode.
+// Each entry is an array of { id, name, blueprintKey } objects.
+
+const MULTI_PAGE_STRUCTURES = {
+  'saas-landing': [
+    { id: 'home',    name: 'Home',    blueprintKey: 'saas-landing' },
+    { id: 'pricing', name: 'Pricing', blueprintKey: 'pricing'      },
+    { id: 'about',   name: 'About',   blueprintKey: 'about'        },
+    { id: 'contact', name: 'Contact', blueprintKey: 'contact'      },
+  ],
+  'portfolio': [
+    { id: 'home',    name: 'Home',    blueprintKey: 'portfolio' },
+    { id: 'about',   name: 'About',   blueprintKey: 'about'    },
+    { id: 'contact', name: 'Contact', blueprintKey: 'contact'  },
+  ],
+  'agency': [
+    { id: 'home',    name: 'Home',     blueprintKey: 'agency'  },
+    { id: 'about',   name: 'About',    blueprintKey: 'about'   },
+    { id: 'contact', name: 'Contact',  blueprintKey: 'contact' },
+  ],
+  'blog': [
+    { id: 'home',    name: 'Home',     blueprintKey: 'blog'    },
+    { id: 'about',   name: 'About',    blueprintKey: 'about'   },
+    { id: 'contact', name: 'Contact',  blueprintKey: 'contact' },
+  ],
+  'ecommerce': [
+    { id: 'home',    name: 'Home',     blueprintKey: 'ecommerce' },
+    { id: 'about',   name: 'About',    blueprintKey: 'about'     },
+    { id: 'contact', name: 'Contact',  blueprintKey: 'contact'   },
+  ],
+  'app-homepage': [
+    { id: 'home',    name: 'Home',     blueprintKey: 'app-homepage' },
+    { id: 'pricing', name: 'Pricing',  blueprintKey: 'pricing'      },
+    { id: 'contact', name: 'Contact',  blueprintKey: 'contact'      },
+  ],
+  'generic': [
+    { id: 'home',    name: 'Home',    blueprintKey: 'generic'  },
+    { id: 'about',   name: 'About',   blueprintKey: 'about'    },
+    { id: 'contact', name: 'Contact', blueprintKey: 'contact'  },
+  ],
+};
+
+// ─── Optional Section Injection ───────────────────────────────────────────────
+
+/**
+ * Inject optional sections into a blueprint based on detected features.
+ * Mutates a copy of the blueprint array.
+ *
+ * @param {Array} blueprint
+ * @param {string[]} features
+ * @param {string} pageType
+ * @returns {Array}
+ */
+function _injectOptionalSections(blueprint, features, pageType) {
+  const sections = [...blueprint];
+
+  // Find the index of the CTA section (insert optional sections before it)
+  const ctaIdx = sections.findIndex(s => s.type === 'cta');
+  const insertAt = ctaIdx >= 0 ? ctaIdx : sections.length - 1;
+
+  if (features.includes('pricing') && !sections.some(s => s.type === 'pricing-grid') && pageType !== 'pricing') {
+    sections.splice(insertAt, 0, {
+      type:   'pricing-grid',
+      intent: 'Pricing tiers injected because the prompt mentioned pricing or plans',
+    });
+  }
+
+  if (features.includes('faq') && !sections.some(s => s.type === 'faq')) {
+    sections.splice(insertAt, 0, {
+      type:   'faq',
+      intent: 'FAQ section injected because the prompt mentioned questions or FAQ',
+    });
+  }
+
+  if (features.includes('testimonials') && !sections.some(s => s.type === 'testimonial')) {
+    sections.splice(insertAt, 0, {
+      type:   'testimonial',
+      intent: 'Testimonial injected because the prompt mentioned reviews or social proof',
+    });
+  }
+
+  if (features.includes('newsletter') && !sections.some(s => s.type === 'newsletter')) {
+    sections.splice(insertAt, 0, {
+      type:   'newsletter',
+      intent: 'Newsletter section injected because the prompt mentioned subscriptions or email',
+    });
+  }
+
+  return sections;
+}
+
+// ─── Slug Helper ──────────────────────────────────────────────────────────────
+
+function _slugify(str) {
+  return str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
+}
+
+// ─── Public API ───────────────────────────────────────────────────────────────
+
+/**
+ * @typedef {object} PagePlan
+ * @property {string} id       - URL slug
+ * @property {string} name     - Display name
+ * @property {string} intent   - One-line purpose description
+ * @property {Array<{type: string, intent: string}>} sections
+ */
+
+/**
+ * @typedef {object} SitePlan
+ * @property {string}     brand
+ * @property {string}     accentColor
+ * @property {string}     fontFamily
+ * @property {string}     theme
+ * @property {string}     industry
+ * @property {string}     tone
+ * @property {string[]}   navLinks     - Page names for nav links (derived from pages)
+ * @property {PagePlan[]} pages
+ */
+
+/**
+ * Produce a `SitePlan` from a `PromptIntent`.
+ *
+ * @param {import('./promptAnalyser.js').PromptIntent} intent
+ * @returns {SitePlan}
+ */
+export function planSite(intent) {
+  const {
+    pageType, siteType, brand, accentColor, fontFamily, theme, industry, tone, features,
+  } = intent;
+
+  const isMultiPage = siteType === 'multi-page';
+
+  // ── Determine which pages to generate ─────────────────────────────────────
+  let pageDefinitions;
+
+  if (isMultiPage) {
+    pageDefinitions = MULTI_PAGE_STRUCTURES[pageType] ?? MULTI_PAGE_STRUCTURES.generic;
+  } else {
+    pageDefinitions = [
+      { id: _slugify(brand) || 'home', name: brand, blueprintKey: pageType },
+    ];
+  }
+
+  // ── Build page plans ───────────────────────────────────────────────────────
+  const navLinks = pageDefinitions.map(p => p.name);
+
+  const pages = pageDefinitions.map(({ id, name, blueprintKey }) => {
+    const rawBlueprint = SECTION_BLUEPRINTS[blueprintKey] ?? SECTION_BLUEPRINTS.generic;
+
+    // Inject optional sections only on the primary/home page
+    const isHomePage = id === pageDefinitions[0].id;
+    const sections   = isHomePage
+      ? _injectOptionalSections(rawBlueprint, features, blueprintKey)
+      : rawBlueprint;
+
+    const pageIntent = _describePageIntent(blueprintKey, brand);
+
+    return { id, name, intent: pageIntent, sections };
+  });
+
+  return {
+    brand,
+    accentColor,
+    fontFamily,
+    theme,
+    industry,
+    tone,
+    navLinks,
+    pages,
+  };
+}
+
+/**
+ * Generate a human-readable intent description for a page type.
+ * Used for logging and debugging.
+ *
+ * @param {string} blueprintKey
+ * @param {string} brand
+ * @returns {string}
+ */
+function _describePageIntent(blueprintKey, brand) {
+  const descriptions = {
+    'saas-landing': `Marketing landing page for ${brand} — convert visitors into free trial signups`,
+    'portfolio':    `Personal portfolio for ${brand} — showcase work and attract clients`,
+    'agency':       `Agency homepage for ${brand} — present services and attract project inquiries`,
+    'app-homepage': `Mobile app landing page for ${brand} — drive downloads and explain features`,
+    'blog':         `Blog listing page for ${brand} — surface recent articles and grow subscribers`,
+    'ecommerce':    `E-commerce homepage for ${brand} — drive product discovery and purchases`,
+    'dashboard':    `Analytics dashboard for ${brand} — display KPIs and recent activity`,
+    'pricing':      `Pricing page for ${brand} — present plans clearly and reduce friction`,
+    'about':        `About page for ${brand} — tell the company story and build trust`,
+    'contact':      `Contact page for ${brand} — make it easy for visitors to get in touch`,
+    'generic':      `General-purpose page for ${brand}`,
+  };
+
+  return descriptions[blueprintKey] ?? `Page for ${brand}`;
+}
diff --git a/src/app-components/appComponents.js b/src/app-components/appComponents.js
