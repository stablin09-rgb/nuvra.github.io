+// ─── Registry API ─────────────────────────────────────────────────────────────
+
+/** @type {Map<string, AppComponentDef>} */
+const _registry = new Map(APP_COMPONENT_DEFS.map((def) => [def.id, def]));
+
+/**
+ * Get all registered app component definitions.
+ * @returns {AppComponentDef[]}
+ */
+export function getAllAppComponents() {
+  return [..._registry.values()];
+}
+
+/**
+ * Get an app component definition by ID.
+ * @param {string} id
+ * @returns {AppComponentDef|undefined}
+ */
+export function getAppComponent(id) {
+  return _registry.get(id);
+}
+
+/**
+ * Get all app components for a given category.
+ * @param {string} category
+ * @returns {AppComponentDef[]}
+ */
+export function getAppComponentsByCategory(category) {
+  return [..._registry.values()].filter((d) => d.category === category);
+}
+
+/**
+ * Render an app component to { html, css } using its config.
+ *
+ * @param {string} componentId
+ * @param {object} config
+ * @returns {{ html: string, css: string }}
+ */
+export function renderAppComponent(componentId, config = {}) {
+  const def = _registry.get(componentId);
+  if (!def) {
+    throw new Error(`[AppComponents] Unknown component "${componentId}".`);
+  }
+  return def.render(config);
+}
+
+/**
+ * Build a compact AI context string listing all app components.
+ * Used to inform the AI about available app-building primitives.
+ *
+ * @returns {string}
+ */
+export function buildAppComponentContext() {
+  const byCategory = {};
+  for (const def of _registry.values()) {
+    if (!byCategory[def.category]) byCategory[def.category] = [];
+    byCategory[def.category].push(`  - ${def.id}: ${def.description}`);
+  }
+
+  return Object.entries(byCategory)
+    .map(([cat, items]) => `${cat}:\n${items.join('\n')}`)
+    .join('\n\n');
+}
